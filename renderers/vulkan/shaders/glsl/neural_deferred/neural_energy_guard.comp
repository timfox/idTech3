#version 450
/* PBNDS+ dark-energy regularization at inference/composite boundary. This is
 * deliberately independent of the network architecture and guarantees that
 * zero incident light cannot produce an unbounded learned residual. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/* x,y,z predicted RGB; w incident-light energy estimate. */
layout(std430, set = 0, binding = 0) readonly buffer NeuralPrediction { vec4 prediction[]; };
/* guarded RGB output; alpha is preserved for debug/validity. */
layout(std430, set = 0, binding = 1) writeonly buffer NeuralGuarded { vec4 guarded[]; };

layout(push_constant) uniform NeuralEnergyPush {
	uint width;
	uint height;
	float darkThreshold;
	float strength;
} pc;

void main() {
	uint x = gl_GlobalInvocationID.x;
	uint y = gl_GlobalInvocationID.y;
	if (x >= pc.width || y >= pc.height) return;
	uint index = y * pc.width + x;
	vec4 value = prediction[index];
	float energy = max(value.w, 0.0);
	/* Smooth gate avoids a hard edge while enforcing zero output at darkness. */
	float gate = smoothstep(0.0, max(pc.darkThreshold, 0.000001), energy);
	vec3 rgb = max(value.rgb, vec3(0.0)) * gate * clamp(pc.strength, 0.0, 1.0);
	guarded[index] = vec4(rgb, gate);
}

