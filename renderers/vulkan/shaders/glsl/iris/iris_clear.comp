#version 450
/* Iris — clear scope framebuffer before WSI tile composite. */
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba8, set = 0, binding = 0) uniform writeonly image2D scopeOut;

layout(push_constant) uniform ClearPush {
	ivec4 viewport;
} pc;

void main() {
	ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	if (pix.x >= pc.viewport.x || pix.y >= pc.viewport.y) {
		return;
	}
	imageStore(scopeOut, pix, vec4(0.92, 0.90, 0.88, 1.0));
}
