float pbrSunShadowVisibility( vec3 worldPos ) {
	if ( pbrSunShadowParams.z < 0.5 ) {
		return 1.0;
	}
	mat4 shadowMat = mat4(
		pbrSunShadowRows[0],
		pbrSunShadowRows[1],
		pbrSunShadowRows[2],
		pbrSunShadowRows[3]
	);
	vec4 lightClip = shadowMat * vec4( worldPos, 1.0 );
	if ( abs( lightClip.w ) <= 1e-6 ) {
		return 1.0;
	}
	vec3 ndc = lightClip.xyz / lightClip.w;
	vec2 uv = ndc.xy * 0.5 + 0.5;
	float depth = ndc.z * 0.5 + 0.5;
	if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) || depth <= 0.0 || depth >= 1.0 ) {
		return 1.0;
	}
	float compareDepth = depth - max( pbrSunShadowParams.x, 0.0 );
	vec2 invSize = vec2( 1.0 / max( textureSize( fp_sun_shadow_map, 0 ).x, 1.0 ),
		1.0 / max( textureSize( fp_sun_shadow_map, 0 ).y, 1.0 ) );
	vec2 texelStep = invSize * max( pbrSunShadowParams.y, 0.0 );
	if ( texelStep.x <= 0.0 || texelStep.y <= 0.0 ) {
		float sampleDepth = texture( fp_sun_shadow_map, uv ).r;
		return ( compareDepth <= sampleDepth ) ? 1.0 : 0.0;
	}
	float lit = 0.0;
	for ( int y = -1; y <= 1; ++y ) {
		for ( int x = -1; x <= 1; ++x ) {
			vec2 pcfUV = uv + vec2( float( x ), float( y ) ) * texelStep;
			float sampleDepth = texture( fp_sun_shadow_map, pcfUV ).r;
			lit += ( compareDepth <= sampleDepth ) ? 1.0 : 0.0;
		}
	}
	return lit * ( 1.0 / 9.0 );
}

