#version 450

/*
 * Compute material classification (Phase E).
 * Reads G-buffer material (metalness, roughness, AO, confidence) + depth.
 * Writes R8UI class IDs — see vk_visibility_buffer.h VK_MATCLASS_*.
 *
 * Confidence-gated heuristics + AO for emissive; low confidence → SIMPLE_OPAQUE.
 * ALPHA_TEST reserved for real cutout signals (not inferred here).
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D materialTex;
layout(r8ui, set = 0, binding = 2) uniform writeonly uimage2D classOut;

layout(push_constant) uniform Push {
	uvec2 extent;
	uint hasMaterial;
	uint gbufferCompact; /* 1: material.ba is octahedral; AO/conf heuristics unsafe */
} pc;

const uint CLASS_EMPTY = 0u;
const uint CLASS_SIMPLE_OPAQUE = 1u;
const uint CLASS_LAYERED = 2u;
const uint CLASS_TRANSMISSION = 3u;
const uint CLASS_EMISSIVE = 4u;
/* CLASS_ALPHA_TEST = 5 reserved for real cutout signals. */
/* CLASS_TRANSPARENT_FWD = 6 reserved for Forward+ path. */

bool validDepth( float depth ) {
	return depth > 0.0 && depth < 1.0;
}

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= pc.extent.x || pix.y >= pc.extent.y ) {
		return;
	}

	ivec2 ip = ivec2( pix );
	vec2 uv = ( vec2( pix ) + 0.5 ) / vec2( pc.extent );
	float depth = texture( depthTex, uv ).r;

	if ( !validDepth( depth ) ) {
		imageStore( classOut, ip, uvec4( CLASS_EMPTY, 0u, 0u, 0u ) );
		return;
	}

	uint cls = CLASS_SIMPLE_OPAQUE;
	if ( pc.hasMaterial != 0u ) {
		vec4 mat = texture( materialTex, uv );
		float metal = mat.r;
		float rough = mat.g;
		float ao = ( pc.gbufferCompact != 0u ) ? 1.0 : mat.b;
		float conf = ( pc.gbufferCompact != 0u ) ? 1.0 : mat.a;

		/* Low confidence: stay simple opaque (energy-neutral vs Forward+). */
		if ( conf < 0.35 ) {
			imageStore( classOut, ip, uvec4( CLASS_SIMPLE_OPAQUE, 0u, 0u, 0u ) );
			return;
		}

		/* High-metal layered materials (calibrated energy: mild spec boost in deferred). */
		if ( conf > 0.55 && metal > 0.65 ) {
			cls = CLASS_LAYERED;
		}
		/* Smooth dielectric → transmission-like (glass/water proxies). */
		else if ( conf > 0.55 && metal < 0.08 && rough < 0.14 && ao > 0.85 ) {
			cls = CLASS_TRANSMISSION;
		}
		/* Emissive: very rough + dark metal + high AO confidence (unlit props). */
		else if ( conf > 0.85 && rough > 0.98 && metal < 0.02 && ao > 0.9 ) {
			cls = CLASS_EMISSIVE;
		}
	}

	imageStore( classOut, ip, uvec4( cls, 0u, 0u, 0u ) );
}
