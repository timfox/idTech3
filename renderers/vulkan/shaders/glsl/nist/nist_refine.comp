#version 450
/*
 * Neural Image Space Tessellation — screen-space silhouette refinement.
 * G-buffer depth + normals; constant cost per pixel (no geometry tessellation).
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2) uniform sampler2D colorTex;
layout(std430, set = 0, binding = 3) readonly buffer NistWeights {
	float data[];
} weights;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D refinedOut;

layout(push_constant) uniform NistRefinePush {
	vec4 extent;
	vec4 params;
	vec4 featureHidden;
	uint useGBufferNormal;
	uint hasGBuffer;
	uint pad0;
	uint pad1;
} pc;

float relu(float x) { return max(x, 0.0); }
float sigmoid(float x) { return 1.0 / (1.0 + exp(-x)); }

float mlpBlend(vec4 feat) {
	int h = int(pc.featureHidden.y);
	int f = int(pc.featureHidden.x);
	float hidden[16];
	int wBase = 0;
	int i;
	int c;
	float sum;

	for (i = 0; i < 16; i++) {
		hidden[i] = 0.0;
	}
	for (i = 0; i < h && i < 16; i++) {
		sum = weights.data[wBase + h * f + i];
		int j;
		for (j = 0; j < f && j < 4; j++) {
			sum += weights.data[wBase + i * f + j] * feat[j];
		}
		hidden[i] = relu(sum);
	}
	wBase += h * f + h;
	sum = weights.data[wBase];
	for (i = 0; i < h && i < 16; i++) {
		sum += weights.data[wBase + 1 + i] * hidden[i];
	}
	return sigmoid(sum);
}

vec3 decodeNormal(vec2 uv, float depth) {
	if (pc.hasGBuffer != 0u && pc.useGBufferNormal != 0u) {
		vec3 n = texture(normalTex, uv).xyz * 2.0 - 1.0;
		float len = length(n);
		if (len > 0.01) {
			return n / len;
		}
	}
	vec2 texel = 1.0 / pc.extent.xy;
	float dL = texture(depthTex, uv + vec2(-texel.x, 0.0)).r;
	float dR = texture(depthTex, uv + vec2(texel.x, 0.0)).r;
	float dD = texture(depthTex, uv + vec2(0.0, -texel.y)).r;
	float dU = texture(depthTex, uv + vec2(0.0, texel.y)).r;
	vec3 dpdx = vec3(texel.x * 2.0, 0.0, dR - dL);
	vec3 dpdy = vec3(0.0, texel.y * 2.0, dU - dD);
	vec3 n = normalize(cross(dpdx, dpdy));
	return n;
}

float depthEdge(vec2 uv) {
	vec2 texel = 1.0 / pc.extent.xy;
	float d = texture(depthTex, uv).r;
	float e = 0.0;
	e = max(e, abs(d - texture(depthTex, uv + vec2(texel.x, 0.0)).r));
	e = max(e, abs(d - texture(depthTex, uv + vec2(-texel.x, 0.0)).r));
	e = max(e, abs(d - texture(depthTex, uv + vec2(0.0, texel.y)).r));
	e = max(e, abs(d - texture(depthTex, uv + vec2(0.0, -texel.y)).r));
	return e;
}

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (pix.x >= uint(pc.extent.x) || pix.y >= uint(pc.extent.y)) {
		return;
	}

	vec2 uv = (vec2(pix) + 0.5) / pc.extent.xy;
	float depth = texture(depthTex, uv).r;

	if (depth <= 0.0 || depth >= 1.0) {
		imageStore(refinedOut, ivec2(pix), vec4(0.0));
		return;
	}

	vec3 color = texture(colorTex, uv).rgb;
	vec3 N = decodeNormal(uv, depth);
	vec3 V = vec3(0.0, 0.0, 1.0);
	float ndotV = clamp(dot(N, V), 0.0, 1.0);
	float dEdge = depthEdge(uv);
	vec2 texelN = 1.0 / pc.extent.xy;
	vec3 nL = decodeNormal(uv + vec2(-texelN.x, 0.0), depth);
	vec3 nR = decodeNormal(uv + vec2(texelN.x, 0.0), depth);
	vec3 nD = decodeNormal(uv + vec2(0.0, -texelN.y), depth);
	vec3 nU = decodeNormal(uv + vec2(0.0, texelN.y), depth);
	float nEdge = max(max(length(N - nL), length(N - nR)), max(length(N - nD), length(N - nU)));
	float silHint = dEdge * (1.0 - ndotV);

	vec4 feat = vec4(
		clamp(dEdge * pc.params.y, 0.0, 1.0),
		clamp(nEdge * 4.0, 0.0, 1.0),
		ndotV,
		clamp(silHint * 8.0, 0.0, 1.0));

	float blendW = mlpBlend(feat);
	blendW *= clamp(dEdge / max(pc.params.y, 1e-4), 0.0, 1.0);
	blendW *= pc.params.x;

	vec2 texel = 1.0 / pc.extent.xy;
	vec2 dir = -normalize(N.xy + vec2(1e-4));
	float radius = pc.params.z;
	vec3 accum = color;
	float count = 1.0;
	int steps = int(clamp(radius, 1.0, 8.0));
	int i;
	for (i = 1; i <= steps; i++) {
		vec2 off = dir * texel * float(i);
		float ds = texture(depthTex, uv + off).r;
		if (abs(ds - depth) < pc.params.w) {
			accum += texture(colorTex, uv + off).rgb;
			count += 1.0;
		}
	}
	vec3 interior = accum / count;
	vec3 outRgb = mix(color, interior, blendW);

	imageStore(refinedOut, ivec2(pix), vec4(outRgb, blendW));
}
