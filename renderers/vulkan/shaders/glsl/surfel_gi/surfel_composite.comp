#version 460
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D albedoTex;
layout(set = 0, binding = 2) uniform sampler2D irradianceTex;
layout(rgba16f, set = 0, binding = 3) uniform image2D colorOut;
layout(set = 0, binding = 4) uniform sampler2D ambientVisibilityTex;

layout(push_constant) uniform CompPush {
	uvec2 extent;
	float strength;
	uint skipSky;
	uint debugMode; /* 0=blend 1=show irradiance 2=show confidence mask */
	float avStrength;
	uint pad1;
	uint pad2;
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (pix.x >= pc.extent.x || pix.y >= pc.extent.y) {
		return;
	}
	vec2 uv = (vec2(pix) + 0.5) / vec2(pc.extent);
	float depth = texture(depthTex, uv).r;
	if (pc.skipSky != 0u && (depth <= 0.0 || depth >= 0.9999)) {
		return;
	}

	vec3 albedo = texture(albedoTex, uv).rgb;
	vec4 irr = texture(irradianceTex, uv);
	vec4 cur = imageLoad(colorOut, ivec2(pix));

	if (pc.debugMode == 1u) {
		imageStore(colorOut, ivec2(pix), vec4(irr.rgb, cur.a));
		return;
	}
	if (pc.debugMode == 2u) {
		imageStore(colorOut, ivec2(pix), vec4(vec3(irr.a), cur.a));
		return;
	}

	float av = clamp(texture(ambientVisibilityTex, uv).r, 0.0, 1.0);
	float indirectVisibility = mix(1.0, av, clamp(pc.avStrength, 0.0, 1.0));
	vec3 gi = irr.rgb * albedo * pc.strength * indirectVisibility;
	imageStore(colorOut, ivec2(pix), vec4(cur.rgb + gi, cur.a));
}
