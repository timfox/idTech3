#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

#include "surfel.glsl"

layout(std430, set = 0, binding = 0) buffer SurfelBuf {
	Surfel surfels[];
};
layout(std430, set = 0, binding = 1) buffer CounterBuf {
	uint activeCount;
	uint spawnSeed;
	uint recycled;
	uint liveCount;
};

layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3) uniform sampler2D normalTex;

layout(push_constant) uniform SpawnPush {
	mat4 invViewProj;
	vec4 extent;       /* xy = width/height, z = surfelRadius, w = minSeparation (0=off) */
	uvec4 params;      /* x=maxSurfels y=frameIndex z=attempts w=unused */
} pc;

void main() {
	uint lid = gl_GlobalInvocationID.x;
	if (lid >= pc.params.z) {
		return;
	}

	uint seed = pc.params.y * 747796405u + lid * 2891336453u + spawnSeed;
	vec2 uv = vec2(surfel_hash(seed), surfel_hash(seed + 1u));
	uv = clamp(uv * 0.9 + 0.05, vec2(0.001), vec2(0.999));

	float depth = texture(depthTex, uv).r;
	if (depth <= 0.0 || depth >= 0.9999) {
		return;
	}

	vec3 nSample = texture(normalTex, uv).xyz;
	vec3 normal = length(nSample) > 0.01 ? normalize(nSample * 2.0 - 1.0) : vec3(0.0, 0.0, 1.0);

	vec2 ndc = uv * 2.0 - 1.0;
	vec4 clip = vec4(ndc, depth, 1.0);
	vec4 worldH = pc.invViewProj * clip;
	if (abs(worldH.w) < 1e-6) {
		return;
	}
	vec3 worldPos = worldH.xyz / worldH.w;

	/* Reject candidates too close to existing active surfels (budget-preserving density). */
	float minSep = pc.extent.w;
	if (minSep > 1e-4) {
		uint hwm = min(activeCount, pc.params.x);
		if (hwm > 0u) {
			for (uint k = 0u; k < 4u; k++) {
				uint j = uint(surfel_hash(seed + 17u + k) * float(hwm)) % hwm;
				Surfel nbs = surfels[j];
				if ((nbs.meta.x & SURFEL_FLAG_ACTIVE) == 0u || (nbs.meta.x & SURFEL_FLAG_STALE) != 0u) {
					continue;
				}
				if (distance(nbs.posRadius.xyz, worldPos) < minSep) {
					return;
				}
			}
		}
	}

	/* Prefer recycling an inactive/stale slot; else grow the scan range. */
	uint probe = uint(surfel_hash(seed + 9u) * float(pc.params.x)) % pc.params.x;
	uint slot = 0xffffffffu;
	uint flags = surfels[probe].meta.x;
	if ((flags & SURFEL_FLAG_ACTIVE) == 0u || (flags & SURFEL_FLAG_STALE) != 0u) {
		slot = probe;
		/* Ensure scan range covers recycled slots. */
		atomicMax(activeCount, probe + 1u);
		if ((flags & SURFEL_FLAG_STALE) != 0u || (flags & SURFEL_FLAG_ACTIVE) != 0u) {
			atomicAdd(recycled, 1u);
		}
	} else {
		slot = atomicAdd(activeCount, 1u);
		if (slot >= pc.params.x) {
			atomicMin(activeCount, pc.params.x);
			/* Last chance: overwrite a random slot. */
			slot = probe;
		}
	}

	surfels[slot].posRadius = vec4(worldPos, pc.extent.z);
	surfels[slot].normalConf = vec4(normal, 0.05);
	surfels[slot].irradianceAge = vec4(0.0, 0.0, 0.0, 0.0);
	surfels[slot].meta = uvec4(SURFEL_FLAG_ACTIVE | SURFEL_FLAG_VALID, 0u, 0u, 0u);
	atomicAdd(liveCount, 1u);
}
