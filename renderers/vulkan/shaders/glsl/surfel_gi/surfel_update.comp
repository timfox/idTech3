#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

#include "surfel.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(std430, set = 0, binding = 1) buffer SurfelBuf {
	Surfel surfels[];
};
layout(std430, set = 0, binding = 2) buffer CounterBuf {
	uint activeCount;
	uint spawnSeed;
	uint recycled;
	uint liveCount;
};
layout(std430, set = 0, binding = 3) readonly buffer WorldAlbedoSSBO {
	float rgb[];
};
layout(std430, set = 0, binding = 4) readonly buffer WorldNormalSSBO {
	float nxyz[];
};
layout(std430, set = 0, binding = 5) readonly buffer EntityAlbedoSSBO {
	float entityRgb[];
};
layout(std430, set = 0, binding = 6) readonly buffer EntityNormalSSBO {
	float entityNxyz[];
};

/* Phase A.1b parity with Hybrid1: bindless diffuse + PrimMaterial. */
layout(set = 0, binding = 7) uniform sampler2D bindlessDiffuse[];
struct SurfelPrimMaterial {
	uint textureIndex;
	uint uvSetFlags;
};
layout(std430, set = 0, binding = 8) readonly buffer PrimMaterialSSBO {
	SurfelPrimMaterial mats[];
};
layout(std430, set = 0, binding = 9) readonly buffer PrimUvSSBO {
	float uv6[];
};

layout(push_constant) uniform UpdatePush {
	uvec4 params; /* x=maxSurfels y=frame z=samplesPerSurfel w=updateStride */
	vec4  ray;    /* x=maxRayDistance y=intensity z=blendAlpha w=maxAge */
	uvec4 bindless; /* x=texCount y=worldPrimCount */
} pc;

vec3 sampleBindlessAlbedo(uint instanceCustom, int primId, vec2 bary) {
	uint texCount = pc.bindless.x;
	if (texCount == 0u || primId < 0) {
		return vec3(-1.0);
	}
	uint primIdx = uint(primId);
	if (instanceCustom == 1u) {
		primIdx += pc.bindless.y;
	}
	uint nMat = uint(mats.length());
	if (nMat == 0u || primIdx >= nMat) {
		return vec3(-1.0);
	}
	uint texIdx = mats[primIdx].textureIndex;
	if (texIdx == 0xFFFFFFFFu || texIdx >= texCount) {
		return vec3(-1.0);
	}
	vec2 uv = vec2(0.5);
	uint nuv = uint(uv6.length());
	if (nuv >= (primIdx + 1u) * 6u) {
		uint base = primIdx * 6u;
		vec2 uv0 = vec2(uv6[base + 0u], uv6[base + 1u]);
		vec2 uv1 = vec2(uv6[base + 2u], uv6[base + 3u]);
		vec2 uv2 = vec2(uv6[base + 4u], uv6[base + 5u]);
		float w = max(1.0 - bary.x - bary.y, 0.0);
		uv = uv0 * w + uv1 * bary.x + uv2 * bary.y;
	}
	vec3 c = texture(nonuniformEXT(bindlessDiffuse[texIdx]), uv).rgb;
	if (dot(c, c) <= 1e-8) {
		return vec3(-1.0);
	}
	return c;
}

vec3 sampleWorldAlbedo(uint instanceCustom, int primId, vec2 bary) {
	vec3 b = sampleBindlessAlbedo(instanceCustom, primId, bary);
	if (b.x >= 0.0) {
		return b;
	}
	if (instanceCustom == 1u) {
		uint n = uint(entityRgb.length()) / 3u;
		if (n == 0u || primId < 0 || uint(primId) >= n) {
			return surfel_default_albedo();
		}
		uint i = uint(primId) * 3u;
		return vec3(entityRgb[i], entityRgb[i + 1u], entityRgb[i + 2u]);
	}
	uint n = uint(rgb.length()) / 3u;
	if (instanceCustom != 0u || n == 0u || primId < 0 || uint(primId) >= n) {
		return surfel_default_albedo();
	}
	uint i = uint(primId) * 3u;
	return vec3(rgb[i], rgb[i + 1u], rgb[i + 2u]);
}

vec3 sampleWorldNormal(uint instanceCustom, int primId, vec3 towardRay) {
	vec3 N = vec3(0.0);
	if (instanceCustom == 1u) {
		uint n = uint(entityNxyz.length()) / 3u;
		if (n != 0u && primId >= 0 && uint(primId) < n) {
			uint i = uint(primId) * 3u;
			N = vec3(entityNxyz[i], entityNxyz[i + 1u], entityNxyz[i + 2u]);
		}
	} else if (instanceCustom == 0u) {
		uint n = uint(nxyz.length()) / 3u;
		if (n != 0u && primId >= 0 && uint(primId) < n) {
			uint i = uint(primId) * 3u;
			N = vec3(nxyz[i], nxyz[i + 1u], nxyz[i + 2u]);
		}
	}
	float len2 = dot(N, N);
	if (len2 < 1e-8) {
		return towardRay;
	}
	N *= inversesqrt(len2);
	if (dot(N, towardRay) < 0.0) {
		N = -N;
	}
	return N;
}

void main() {
	uint index = gl_GlobalInvocationID.x;
	if (index >= activeCount || index >= pc.params.x) {
		return;
	}
	/* Stagger updates across frames. */
	if (((index + pc.params.y) % max(pc.params.w, 1u)) != 0u) {
		return;
	}

	Surfel s = surfels[index];
	if ((s.meta.x & SURFEL_FLAG_ACTIVE) == 0u || (s.meta.x & SURFEL_FLAG_VALID) == 0u) {
		return;
	}

	vec3 pos = s.posRadius.xyz;
	vec3 n = normalize(s.normalConf.xyz);
	uint samples = max(pc.params.z, 1u);
	vec3 accum = vec3(0.0);
	float weight = 0.0;

	for (uint i = 0u; i < samples; i++) {
		uint seed = index * 1973u + pc.params.y * 9277u + i * 269u;
		vec2 u = vec2(surfel_hash(seed), surfel_hash(seed + 17u));
		vec3 dir = surfel_hemi(u, n);
		vec3 origin = pos + n * 0.02;

		rayQueryEXT rq;
		rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu,
			origin, 0.01, dir, pc.ray.x);
		while (rayQueryProceedEXT(rq)) {
		}

		if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
			float t = rayQueryGetIntersectionTEXT(rq, true);
			uint inst = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
			int prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
			vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
			vec3 albedo = sampleWorldAlbedo(inst, prim, bary);
			vec3 towardRay = normalize(-dir);
			vec3 Nhit = sampleWorldNormal(inst, prim, towardRay);
			float cosTerm = max(dot(Nhit, towardRay), 0.0);
			float atten = 1.0 / (1.0 + t * 0.15);
			accum += albedo * cosTerm * 0.318309886 * atten; /* Lambert / pi */
			weight += 1.0;
		} else {
			float sky = max(0.0, dir.z) * 0.35 + 0.08;
			accum += vec3(sky * 0.55, sky * 0.65, sky * 0.85);
			weight += 1.0;
		}
	}

	if (weight > 0.0) {
		vec3 newIrr = (accum / weight) * pc.ray.y;
		float a = clamp(pc.ray.z, 0.02, 1.0);
		s.irradianceAge.xyz = mix(s.irradianceAge.xyz, newIrr, a);
		s.normalConf.w = min(1.0, s.normalConf.w + 0.08);
	} else {
		s.normalConf.w *= 0.97;
	}
	s.irradianceAge.w += 1.0;

	/* Recycle stale / low-confidence slots so spawn can reuse them. */
	float maxAge = max(pc.ray.w, 32.0);
	if (s.normalConf.w < 0.02 || s.irradianceAge.w > maxAge) {
		s.meta.x = SURFEL_FLAG_STALE;
		s.normalConf.w = 0.0;
		s.irradianceAge = vec4(0.0);
		atomicAdd(recycled, 1u);
	}

	surfels[index] = s;
}
