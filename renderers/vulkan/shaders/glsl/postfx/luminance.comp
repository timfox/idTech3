#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D hdrColorTexture;
layout(binding = 1, r32f) uniform writeonly image2D luminanceOutput;

layout(push_constant) uniform LuminanceMetering {
	float lowPercent;
	float highPercent;
	float centerWeight;
	float skyWeight; /* 0=ignore bright upper samples, 1=neutral, >1 amplify sky in meter */
} meter;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
/* Soft-reject sun-core samples that survive percentile trim (stops above trimmed median). */
const float SUN_REJECT_STOPS = 4.0;

shared float s_logLum[256];
shared float s_weight[256];

void swapSamples( uint a, uint b ) {
	float lumA = s_logLum[a];
	float lumB = s_logLum[b];
	float weightA = s_weight[a];
	float weightB = s_weight[b];
	s_logLum[a] = lumB;
	s_logLum[b] = lumA;
	s_weight[a] = weightB;
	s_weight[b] = weightA;
}

void main() {
	uint lx = gl_LocalInvocationID.x;
	uint ly = gl_LocalInvocationID.y;
	uint li = ly * 16u + lx;

	/* Sample HDR at 16x16 sparse grid across full image (1 work group). */
	float fx = (float(lx) + 0.5) / 16.0;
	float fy = (float(ly) + 0.5) / 16.0;
	vec2 uv = vec2(fx, fy);
	vec3 rgb = texture(hdrColorTexture, uv).rgb;
	/* Skip non-finite pixels — they must not enter metering. */
	float lum = max(dot(rgb, LUMA), 1e-6);
	if ( !( lum == lum ) || isinf( lum ) ) {
		lum = 1e-6;
	}
	float logLum = log2(lum);
	vec2 centered = uv * 2.0 - 1.0;
	float radial = clamp(1.0 - dot(centered, centered) * 0.5, 0.0, 1.0);
	float weight = mix(1.0, 1.0 + max(meter.centerWeight, 0.0) * 3.0, radial * radial);

	/*
	 * Source-style sky participation: bright samples toward the top of the frame
	 * (typical sky) influence metering by r_exposureSkyWeight. Extremes are still
	 * trimmed by highPercent (sun disk) before the average.
	 */
	{
		float skyW = clamp( meter.skyWeight, 0.0, 2.0 );
		float upper = smoothstep( 0.55, 0.15, fy ); /* fy=0 top */
		float bright = smoothstep( 0.4, 2.0, lum );
		float skyLikely = upper * bright;
		weight *= mix( 1.0, max( skyW, 0.05 ), skyLikely );
	}

	s_logLum[li] = logLum;
	s_weight[li] = weight;

	barrier();
	memoryBarrierShared();

	/* Bitonic sort so we can trim luminance percentiles before averaging. */
	for (uint k = 2u; k <= 256u; k <<= 1u) {
		for (uint j = k >> 1u; j > 0u; j >>= 1u) {
			uint ixj = li ^ j;
			if (ixj > li) {
				bool ascending = (li & k) == 0u;
				bool outOfOrder = ascending ? (s_logLum[li] > s_logLum[ixj]) : (s_logLum[li] < s_logLum[ixj]);
				if (outOfOrder) {
					swapSamples(li, ixj);
				}
			}
			barrier();
			memoryBarrierShared();
		}
	}

	if (li == 0u) {
		float lowPercent = clamp(meter.lowPercent, 0.0, 0.45);
		float highPercent = clamp(meter.highPercent, 0.0, 0.45);
		int startIndex = int(floor(lowPercent * 256.0));
		int endIndex = int(ceil((1.0 - highPercent) * 256.0));
		float weightedSum = 0.0;
		float weightSum = 0.0;
		float avgLogLum;
		float medianLog;

		startIndex = clamp(startIndex, 0, 255);
		endIndex = clamp(endIndex, startIndex + 1, 256);

		/* Median of the percentile-trimmed band — sun core sits far above this. */
		medianLog = s_logLum[( startIndex + endIndex - 1 ) / 2];

		for (int i = startIndex; i < endIndex; ++i) {
			float w = s_weight[i];
			/*
			 * Soft sun-core rejection: samples more than SUN_REJECT_STOPS above the
			 * trimmed median keep a tiny residual weight so they cannot dominate,
			 * while the broad bright sky (near the median) still pulls exposure down.
			 */
			float over = max( s_logLum[i] - medianLog - SUN_REJECT_STOPS, 0.0 );
			w *= exp( -over * 2.0 );
			weightedSum += s_logLum[i] * w;
			weightSum += w;
		}

		avgLogLum = (weightSum > 0.0) ? (weightedSum / weightSum) : s_logLum[128];
		imageStore(luminanceOutput, ivec2(0, 0), vec4(avgLogLum, 0.0, 0.0, 1.0));
	}
}
