#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;

#include "rgi_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D albedoTex;
layout(set = 0, binding = 2) uniform sampler2D probeIrrTex;
layout(set = 0, binding = 3) uniform sampler2D probeMetaTex;
layout(set = 0, binding = 4) uniform sampler2D ssgiRadTex;
layout(set = 0, binding = 5) uniform sampler2D ssgiMetaTex;
layout(set = 0, binding = 6) uniform sampler2D aoTex;
layout(rgba16f, set = 0, binding = 7) uniform image2D sceneColor; /* read-write HDR */
layout(set = 0, binding = 8) uniform sampler2D cacheIrrTex; /* Ultra 1.13 radiance cache */
layout(set = 0, binding = 9) uniform sampler2D cacheMetaTex;

layout(push_constant) uniform ResolvePush {
	uvec4 extentMeta;  /* xy extent, z debugMode, w hasAO */
	vec4  params0;     /* probeStrength, ssgiStrength, aoStrength, lightmapDeltaScale */
	vec4  params1;     /* shFallbackScale, emissiveMute, duplicateWarn, cacheStrength */
	vec4  params2;     /* hasCache, cacheQualityMute, unused, unused */
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( any( greaterThanEqual( pix, pc.extentMeta.xy ) ) ) {
		return;
	}
	ivec2 ip = ivec2( pix );
	vec2 uv = ( vec2( pix ) + 0.5 ) / vec2( pc.extentMeta.xy );
	float depth = textureLod( depthTex, uv, 0.0 ).r;
	vec4 scene = imageLoad( sceneColor, ip );

	if ( !rgi_valid_depth( depth ) ) {
		if ( pc.extentMeta.z != 0u ) {
			imageStore( sceneColor, ip, scene );
		}
		return;
	}

	vec3 albedo = max( textureLod( albedoTex, uv, 0.0 ).rgb, vec3( 0.02 ) );
	vec4 probe = textureLod( probeIrrTex, uv, 0.0 );
	vec4 probeMeta = textureLod( probeMetaTex, uv, 0.0 );
	vec4 ssgi = textureLod( ssgiRadTex, uv, 0.0 );
	vec4 ssgiMeta = textureLod( ssgiMetaTex, uv, 0.0 );

	float ao = 1.0;
	if ( pc.extentMeta.w != 0u ) {
		ao = textureLod( aoTex, uv, 0.0 ).r;
		ao = mix( 1.0, ao, clamp( pc.params0.z, 0.0, 1.0 ) );
	}

	/*
	 * Ownership contract (Raster Ultra 1.3 + 1.13):
	 * - Lightmaps already live in scene color (static baseline owner).
	 * - Radiance cache / probes contribute dynamic delta only.
	 * - SSGI is near-field confidence lerp over that delta (not full add).
	 * - GTAO modulates approximate unresolved probe/cache ambient, not valid SSGI.
	 * - SH/IBL remain in forward/base as terminal fallback (not re-added here).
	 */
	float probeConf = clamp( probe.a, 0.0, 1.0 );
	float ssgiConf = clamp( ssgi.a, 0.0, 1.0 );
	vec4 cache = vec4( 0.0 );
	vec4 cacheMeta = vec4( 0.0 );
	if ( pc.params2.x > 0.5 ) {
		cache = textureLod( cacheIrrTex, uv, 0.0 );
		cacheMeta = textureLod( cacheMetaTex, uv, 0.0 );
	}
	float cacheConf = clamp( cache.a, 0.0, 1.0 ) * clamp( pc.params2.y, 0.0, 1.0 );
	float cacheLeak = clamp( cacheMeta.y, 0.0, 1.0 );
	float cacheStrength = max( pc.params1.w, 0.0 );
	/* Mute leaky cache energy at resolve (adjacent-room / thin-wall). */
	cacheConf *= ( 1.0 - 0.9 * cacheLeak );

	vec3 probeIndirect = probe.rgb * albedo * ao * max( pc.params0.x, 0.0 ) * max( pc.params0.w, 0.0 );
	vec3 cacheIndirect = cache.rgb * albedo * ao * cacheStrength * max( pc.params0.w, 0.0 )
		* ( 1.0 - 0.8 * cacheLeak );
	/* Prefer validated cache over probes for dynamic delta; probes fill gaps. */
	float cacheW = clamp( cacheConf * cacheConf, 0.0, 1.0 );
	vec3 baseGI = mix( probeIndirect, cacheIndirect, cacheW );

	vec3 ssgiIndirect = ssgi.rgb * max( pc.params0.y, 0.0 );
	/* Valid SSGI already encodes local occlusion — do not re-apply AO. */
	float coverageFloor = max( probeConf, cacheConf );
	float ssgiW = ssgiConf * coverageFloor;
	ssgiW = max( ssgiW, ssgiConf * ssgiConf );
	ssgiW = clamp( ssgiW, 0.0, 1.0 );
	vec3 finalIndirect = mix( baseGI, ssgiIndirect, ssgiW );

	/* Duplicate-energy soft clamp when cache/probe/SSGI overlap mid-confidence. */
	float baseLum = dot( baseGI, vec3( 0.2126, 0.7152, 0.0722 ) );
	float ssgiLum = dot( ssgiIndirect, vec3( 0.2126, 0.7152, 0.0722 ) );
	if ( baseLum > 0.05 && ssgiLum > 0.05 && ssgiW > 0.2 && ssgiW < 0.8 ) {
		finalIndirect *= mix( 1.0, 0.85, clamp( pc.params1.z, 0.0, 1.0 ) );
	}
	if ( cacheW > 0.2 && probeConf > 0.2 && cacheW < 0.85 ) {
		finalIndirect *= mix( 1.0, 0.9, clamp( pc.params1.z, 0.0, 1.0 ) );
	}

	uint debugMode = pc.extentMeta.z;
	if ( debugMode == 1u ) {
		imageStore( sceneColor, ip, vec4( probe.rgb, 1.0 ) );
		return;
	}
	if ( debugMode == 2u ) {
		imageStore( sceneColor, ip, vec4( ssgi.rgb, 1.0 ) );
		return;
	}
	if ( debugMode == 3u ) {
		imageStore( sceneColor, ip, vec4( ssgiConf, probeConf, cacheConf, 1.0 ) );
		return;
	}
	if ( debugMode == 4u ) {
		imageStore( sceneColor, ip, vec4( probeIndirect, 1.0 ) );
		return;
	}
	if ( debugMode == 5u ) {
		imageStore( sceneColor, ip, vec4( ssgiIndirect, 1.0 ) );
		return;
	}
	if ( debugMode == 6u ) {
		imageStore( sceneColor, ip, vec4( finalIndirect, 1.0 ) );
		return;
	}
	if ( debugMode == 7u ) {
		imageStore( sceneColor, ip, vec4( ao, ao * max( probeConf, cacheConf ), 1.0 - ssgiW, 1.0 ) );
		return;
	}
	if ( debugMode == 8u ) {
		float leak = max( 1.0 - clamp( probeMeta.x, 0.0, 1.0 ), clamp( cacheMeta.y, 0.0, 1.0 ) );
		imageStore( sceneColor, ip, vec4( leak, cacheMeta.y, probeMeta.y, 1.0 ) );
		return;
	}
	if ( debugMode == 9u ) {
		imageStore( sceneColor, ip, vec4( cache.rgb, 1.0 ) );
		return;
	}
	if ( debugMode == 10u ) {
		imageStore( sceneColor, ip, vec4( cacheIndirect, 1.0 ) );
		return;
	}
	if ( debugMode == 11u ) {
		imageStore( sceneColor, ip, vec4( cacheConf, cacheW, cacheMeta.z / 3.0, 1.0 ) );
		return;
	}
	if ( debugMode == 12u ) {
		imageStore( sceneColor, ip, vec4( baseGI, 1.0 ) );
		return;
	}

	scene.rgb += finalIndirect;
	imageStore( sceneColor, ip, scene );
}
