#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 0) rayPayloadEXT vec3 hitValue;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;

layout(set = 0, binding = 2, std140) uniform RtxFrame {
	mat4 invViewProj;
	vec4 viewOrigin;
	vec4 zNearFar;     /* x=zNear, y=zFar */
	vec4 outputSize;   /* xy = width,height; z = r_rtx mode; w = r_rtxComposite blend */
	vec4 traceParams;  /* x = r_rtxSamples */
} rtx;

layout(set = 0, binding = 3) uniform sampler2D depthTex;
layout(set = 0, binding = 4) uniform sampler2D colorTex;
layout(set = 0, binding = 5) uniform sampler2D importanceTex;

/* traceParams: x=max sample cap, y=FSA budget (SPP, may be <1), z=frame hash, w=FSA adaptive (0=uniform, 1=stochastic) */

vec2 sampleOffset( int index )
{
	switch ( index & 7 ) {
		case 0: return vec2( 0.5, 0.5 );
		case 1: return vec2( 0.25, 0.75 );
		case 2: return vec2( 0.75, 0.25 );
		case 3: return vec2( 0.125, 0.375 );
		case 4: return vec2( 0.625, 0.875 );
		case 5: return vec2( 0.375, 0.125 );
		case 6: return vec2( 0.875, 0.625 );
		default: return vec2( 0.0625, 0.5625 );
	}
}

vec3 tracePrimary( vec2 uv )
{
	float d = textureLod( depthTex, uv, 0.0 ).r;

	vec3 ro = rtx.viewOrigin.xyz;
	vec3 rd;

	if ( d <= 0.0 || d >= 1.0 ) {
		/* Sky / void: shoot along forward from clip center ray */
		vec4 farClip = vec4( uv * 2.0 - 1.0, 0.0, 1.0 );
		vec4 farW = rtx.invViewProj * farClip;
		farW /= max( abs( farW.w ), 1e-6 );
		rd = normalize( farW.xyz - ro );
	} else {
		vec4 clip = vec4( uv * 2.0 - 1.0, d, 1.0 );
		vec4 worldPos = rtx.invViewProj * clip;
		worldPos /= max( abs( worldPos.w ), 1e-6 );
		rd = normalize( worldPos.xyz - ro );
	}

	hitValue = vec3( 0.0 );
	traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, 0.01, rd, 1.0e5, 0 );
	return hitValue;
}

float fsaHash21( vec2 p )
{
	return fract( sin( dot( p, vec2( 12.9898, 78.233 ) ) ) * 43758.5453 );
}

void main()
{
	vec2 extent = max( rtx.outputSize.xy, vec2( 1.0 ) );
	vec2 baseUv = ( vec2( gl_LaunchIDEXT.xy ) + vec2( 0.5 ) ) / extent;
	vec3 sceneColor = textureLod( colorTex, baseUv, 0.0 ).rgb;
	vec3 traced = vec3( 0.0 );
	int maxSamples = clamp( int( floor( rtx.traceParams.x + 0.5 ) ), 1, 8 );
	float budget = max( rtx.traceParams.y, 1e-4 );
	float adaptive = rtx.traceParams.w;
	float imp = textureLod( importanceTex, baseUv, 0.0 ).r;
	float rnd = fsaHash21( vec2( gl_LaunchIDEXT.xy ) + rtx.traceParams.zz );

	if ( adaptive > 0.5 ) {
		float traceProb = clamp( imp * budget * float( maxSamples ), 0.0, 1.0 );
		if ( rnd < traceProb ) {
			vec2 jitterUv = ( vec2( gl_LaunchIDEXT.xy ) + vec2( 0.5 ) + ( rnd - 0.5 ) * vec2( 0.35 ) ) / extent;
			traced = tracePrimary( clamp( jitterUv, vec2( 0.0 ), vec2( 1.0 ) ) );
		} else {
			traced = sceneColor;
		}
	} else {
		int samples = maxSamples;
		for ( int i = 0; i < samples; ++i ) {
			vec2 uv = ( vec2( gl_LaunchIDEXT.xy ) + sampleOffset( i ) ) / extent;
			traced += tracePrimary( clamp( uv, vec2( 0.0 ), vec2( 1.0 ) ) );
		}
		traced /= float( samples );
	}

	float blend = clamp( rtx.outputSize.w, 0.0, 1.0 );
	imageStore( outImage, ivec2( gl_LaunchIDEXT.xy ), vec4( mix( traced, sceneColor, blend ), 1.0 ) );
}
