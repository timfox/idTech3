#version 450

/*
 * Visibility-buffer Phase 1.5 fill (depth-derived scaffold).
 * visOut.xy = drawId (tile + depth bucket) + primId (Morton|depthBits)
 * baryOut   = intra-tile barycentric proxy (until true prim MRT)
 * True gl_PrimitiveID / instance export is a follow-up — see docs/RENDERER_2027.md
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(rg32ui, set = 0, binding = 1) uniform writeonly uimage2D visOut;
layout(rg16, set = 0, binding = 2) uniform writeonly image2D baryOut;

layout(push_constant) uniform Push {
	uvec2 extent;
	uint tileSize;
	uint reserved;
} pc;

bool validDepth( float depth ) {
	return depth > 0.0 && depth < 1.0;
}

/* Compact 5-bit Morton of local tile coords (0..31). */
uint morton2d5( uint x, uint y ) {
	uint v = 0u;
	uint i;
	x &= 31u;
	y &= 31u;
	for ( i = 0u; i < 5u; i++ ) {
		v |= ( ( x >> i ) & 1u ) << ( 2u * i );
		v |= ( ( y >> i ) & 1u ) << ( 2u * i + 1u );
	}
	return v;
}

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= pc.extent.x || pix.y >= pc.extent.y ) {
		return;
	}

	vec2 uv = ( vec2( pix ) + 0.5 ) / vec2( pc.extent );
	float depth = texture( depthTex, uv ).r;
	ivec2 ip = ivec2( pix );

	if ( !validDepth( depth ) ) {
		imageStore( visOut, ip, uvec4( 0xFFFFFFFFu, 0xFFFFFFFFu, 0u, 0u ) );
		imageStore( baryOut, ip, vec4( 0.0, 0.0, 0.0, 0.0 ) );
		return;
	}

	uint ts = max( pc.tileSize, 1u );
	uint tileX = pix.x / ts;
	uint tileY = pix.y / ts;
	uint localX = pix.x - tileX * ts;
	uint localY = pix.y - tileY * ts;

	/* Depth bucket (10 bits) + tile coords → more stable draw clusters than raw tile alone. */
	uint depthBucket = uint( clamp( depth, 0.0, 1.0 ) * 1023.0 );
	uint drawId = ( ( depthBucket & 0x3FFu ) << 20u ) | ( ( tileY & 0x3FFu ) << 10u ) | ( tileX & 0x3FFu );

	/* Prim proxy: Morton locality XOR depth bits (not floatBitsToUint alone). */
	uint morton = morton2d5( localX, localY );
	uint depthBits = floatBitsToUint( depth );
	uint primId = ( morton << 22u ) ^ ( depthBits >> 3u ) ^ ( depthBucket << 8u );

	vec2 bary = fract( vec2( localX, localY ) / vec2( float( ts ) ) );
	imageStore( visOut, ip, uvec4( drawId, primId, 0u, 0u ) );
	imageStore( baryOut, ip, vec4( bary, 0.0, 1.0 ) );
}
