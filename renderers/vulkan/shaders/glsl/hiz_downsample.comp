#version 450
/*
 * Hi-Z mip downsample for reversed-Z depth.
 *
 * Reversed-Z: near plane → 1.0, far plane → 0.0. For conservative occlusion tests we
 * need the farthest depth in each 2×2 footprint (near=1, far=0) — use min(), not max().
 *
 * Bindings:
 *   0 — full-res depth (sampler2D) when pc.srcLevel == 0
 *   1 — previous mip (readonly image2D) when pc.srcLevel > 0
 *   2 — output mip (writeonly image2D)
 *
 * Push constants carry source/destination level sizes in pixels.
 */
layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform sampler2D depthTex;
layout( r32f, set = 0, binding = 1 ) uniform readonly image2D srcMip;
layout( r32f, set = 0, binding = 2 ) uniform writeonly image2D dstMip;

layout( push_constant ) uniform Push {
	uvec2 srcExtent;
	uvec2 dstExtent;
	uint srcLevel;
	uint _pad;
} pc;

void main()
{
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= pc.dstExtent.x || pix.y >= pc.dstExtent.y ) {
		return;
	}

	/* Every destination texel represents a clamped 2x2 source footprint. */
	uvec2 srcLast = max( pc.srcExtent, uvec2( 1u ) ) - uvec2( 1u );
	uvec2 base = min( pix * 2u, srcLast );
	uvec2 p10 = min( base + uvec2( 1u, 0u ), srcLast );
	uvec2 p01 = min( base + uvec2( 0u, 1u ), srcLast );
	uvec2 p11 = min( base + uvec2( 1u, 1u ), srcLast );
	float z00, z10, z01, z11;
	if ( pc.srcLevel == 0u ) {
		z00 = texelFetch( depthTex, ivec2( base ), 0 ).r;
		z10 = texelFetch( depthTex, ivec2( p10 ), 0 ).r;
		z01 = texelFetch( depthTex, ivec2( p01 ), 0 ).r;
		z11 = texelFetch( depthTex, ivec2( p11 ), 0 ).r;
	} else {
		z00 = imageLoad( srcMip, ivec2( base ) ).r;
		z10 = imageLoad( srcMip, ivec2( p10 ) ).r;
		z01 = imageLoad( srcMip, ivec2( p01 ) ).r;
		z11 = imageLoad( srcMip, ivec2( p11 ) ).r;
	}
	/* reversed-Z conservative farthest depth */
	float z = min( min( z00, z10 ), min( z01, z11 ) );

	imageStore( dstMip, ivec2( pix ), vec4( z ) );
}
