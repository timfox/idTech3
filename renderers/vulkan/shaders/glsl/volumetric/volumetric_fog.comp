vec3 ComputeSunLighting(vec3 worldPos, vec3 viewDir, float density, vec3 mediumColor, float albedoOverride, float sunShadow) {
    // Sun light calculation for volumetric fog
    // Implements anisotropic phase function with ambient term and multiple scattering
    // Based on Henyey-Greenstein phase function for sun direction and ambient lighting
    //
    // The function calculates:
    // 1. Direct sun lighting through the atmosphere using HG phase function
    // 2. Ambient term: indirect lighting from sun-illuminated atmosphere
    // 3. Multiple scattering: simplified approximation for light that scatters multiple times
    //
    // Parameters:
    // - worldPos: World space position of the froxel sample
    // - viewDir: View direction (from camera toward the sample)
    // - density: Fog density at this sample point
    // - mediumColor: Base fog color (extinction coefficient)
    // - albedoOverride: Per-froxel albedo (>=0) or -1 to use global scatterParams.x
    // - sunShadow: Sun visibility factor (0=full shadow, 1=fully lit)
    //
    // Returns: Scattered radiance from sun lighting (RGB)

    // Phase function parameters from GPU params
    // params.phaseParams.x: anisotropy factor 'g' for sun direction (clamped to [-0.999, 0.999])
    //   - Positive g: forward scattering (sun direction) - typical for sun lighting
    //   - Negative g: backward scattering - for ambient lighting
    //   - g=0: isotropic (equal in all directions)
    // params.phaseParams.y: sun light intensity multiplier
    // params.phaseParams.z: ambient light intensity multiplier
    // params.phaseParams.w: shadow contrast exponent (minimum 0.5 for soft shadows)
    float g = clamp(params.phaseParams.x, -0.999, 0.999);
    float gAmbient = -0.2;  // Ambient phase anisotropy (backward scattering)
    float shadowContrast = max(params.phaseParams.w, 0.5);

    // View direction (normalized toward camera)
    vec3 V = normalize(-viewDir);
    vec3 result = vec3(0.0);

    // Sun direction from params (typically from main light direction)
    vec3 Ls = normalize(params.sunDirection.xyz);

    // Henyey-Greenstein phase function for sun direction
    // P(g, cosθ) = (1 - g²) / (4π * (1 + g² - 2g*cosθ)^(3/2))
    // Positive 'g' = forward scattering (sun direction), negative = backward
    // This determines how much light is scattered toward the camera from the sun direction
    float sunPhase = phaseHG(dot(Ls, V), g);

    // Ambient phase function (using same sun direction but different anisotropy)
    // Provides indirect lighting from sun-illuminated atmosphere
    // gAmbient = -0.2 creates backward scattering for ambient term
    float ambientPhase = phaseHG(dot(Ls, V), gAmbient);

    // Ambient term: indirect lighting from sun-illuminated atmosphere
    // Uses mediumColor (fog color) as the base, scaled by ambient intensity
    // (0.7 + 0.3 * ambientPhase) provides baseline + directional component
    // The 0.7 is the base ambient level, 0.3 adds directional variation
    vec3 ambientTerm = mediumColor * max(params.phaseParams.z, 0.0) * (0.7 + 0.3 * ambientPhase);

    // Shadow shaping: soft shadows with contrast control
    // pow(sunShadow, shadowContrast) creates softer shadows (higher exponent = harder shadows)
    // shadowContrast >= 0.5 ensures minimum softness for natural shadow transitions
    float sunShadowShaped = pow(clamp(sunShadow, 0.0, 1.0), shadowContrast);

    // Sun term: direct sun lighting through atmosphere
    // mediumColor * sunIntensity * phaseFunction * shadowFactor
    // The sun term is modulated by:
    // - mediumColor: fog color/extinction
    // - params.phaseParams.y: sun intensity multiplier
    // - sunPhase: anisotropic scattering toward camera
    // - sunShadowShaped: shadow factor with contrast control
    vec3 sunTerm = mediumColor * max(params.phaseParams.y, 0.0) * sunPhase * sunShadowShaped;

    // Multiple scattering approximation
    // Simplified approximation for light that scatters multiple times in the atmosphere
    // 0.28 is the average of HG phase function over all directions (1/(4π) integral)
    // This term represents the diffuse component of atmospheric scattering
    vec3 multiScatter = mediumColor * density * 0.28 * max(params.phaseParams.z, 0.0);

    // Combine all terms
    result += ambientTerm + sunTerm + multiScatter;

    // Final albedo scaling
    // albedoOverride >= 0: use per-froxel albedo (from local light pass)
    // albedoOverride < 0: use global scatterParams.x (default fog albedo)
    float albedo = (albedoOverride >= 0.0) ? clamp(albedoOverride, 0.0, 1.0) : clamp(params.scatterParams.x, 0.0, 1.0);

    // Final result: scale by density, fog color alpha (extinction), and albedo
    // mediumColor already contains the fog color, so we multiply by params.fogColor.a (extinction)
    // This implements the Beer-Lambert law for light transmission through participating media
    return result * density * max(params.fogColor.a, 0.0) * albedo;
}

