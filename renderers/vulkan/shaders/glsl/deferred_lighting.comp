#version 450

/*
 * Experimental deferred lighting (point + spot via Forward+ tile lists).
 * Additive path (r_deferredUnlitBase 1): writes dynamic-only to outLit; composite adds scene base.
 * Multiply path: writes full lit color (legacy).
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define MAX_PER_TILE 8u
#define REC_VEC4S 4u
const float DEF_PI = 3.14159265;

layout(std430, set = 0, binding = 0) readonly buffer LightSSBO {
	vec4 data[];
} lights;

layout(std430, set = 0, binding = 1) readonly buffer TileSSBO {
	uint cells[];
} tiles;

layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3) uniform sampler2D albedoTex;
layout(set = 0, binding = 4) uniform sampler2D normalTex;
layout(set = 0, binding = 5) uniform sampler2D materialTex;
layout(rgba16f, set = 0, binding = 6) uniform writeonly image2D outLit;

layout(push_constant) uniform Push {
	mat4 viewMatrix;
	vec4 projInfo;
	uvec2 extent;
	uvec2 tileGrid;
	float strength;
	uint maxPerTile;
	uint numLights;
	uint additive;
	uint specular;
	float aoStrength;
	float specularStrength;
} pc;

float viewZFromDepth( float depth ) {
	return -pc.projInfo.w / max( depth + pc.projInfo.z, 1e-6 );
}

vec3 reconstructViewPos( vec2 uv, float depth ) {
	float viewZ = viewZFromDepth( depth );
	float negZ = -viewZ;
	vec2 ndc = uv * 2.0 - 1.0;
	return vec3( ndc.x * negZ * pc.projInfo.x, ndc.y * negZ * pc.projInfo.y, viewZ );
}

vec3 toViewDir( vec3 worldDir ) {
	return normalize( ( pc.viewMatrix * vec4( worldDir, 0.0 ) ).xyz );
}

float D_GGX( float NH, float alpha ) {
	float alphaSq = alpha * alpha;
	float d = ( NH * alphaSq - NH ) * NH + 1.0;
	return alphaSq / ( DEF_PI * d * d );
}

float CalcVisibility( float NL, float NE, float alpha ) {
	float alphaSq = alpha * alpha;
	float lambdaE = NL * sqrt( ( -NE * alphaSq + NE ) * NE + alphaSq );
	float lambdaL = NE * sqrt( ( -NL * alphaSq + NL ) * NL + alphaSq );
	return 0.5 / max( lambdaE + lambdaL, 1e-7 );
}

float evalPointLight( vec3 lView, vec3 viewPos, vec3 N, float rad, out vec3 L ) {
	vec3 toLight = lView - viewPos;
	float dist = length( toLight );
	if ( dist > rad ) {
		L = vec3( 0.0 );
		return 0.0;
	}
	L = toLight / max( dist, 1e-4 );
	float dr = dist / rad;
	float att = clamp( 1.0 - dr * dr, 0.0, 1.0 );
	float nl = max( dot( N, L ), 0.0 );
	return att * nl;
}

float evalSpotLight( vec3 lView, vec3 viewPos, vec3 N, float rad,
	vec3 axisView, float cosOuter, float cosInner, float segLen, out vec3 L ) {
	vec3 v = viewPos - lView;
	float tAx = dot( v, axisView );
	float tCl = clamp( tAx, 0.0, segLen );
	vec3 closest = lView + axisView * tCl;
	float dPerp = length( viewPos - closest );
	if ( dPerp > rad ) {
		L = vec3( 0.0 );
		return 0.0;
	}
	vec3 wDir = v / max( length( v ), 1e-4 );
	float cosAng = dot( wDir, axisView );
	float cone = smoothstep( cosOuter, cosInner, cosAng );
	if ( cone <= 1e-4 ) {
		L = vec3( 0.0 );
		return 0.0;
	}
	float axAtt = 1.0 - smoothstep( segLen * 0.85, segLen, tCl );
	float rp = dPerp / max( rad, 1e-4 );
	float radAtt = clamp( 1.0 - rp * rp, 0.0, 1.0 );
	float att = cone * axAtt * radAtt;
	L = -wDir;
	float nl = max( dot( N, L ), 0.0 );
	return att * nl;
}

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= pc.extent.x || pix.y >= pc.extent.y ) {
		return;
	}

	vec2 uv = ( vec2( pix ) + 0.5 ) / vec2( pc.extent );
	float depth = texture( depthTex, uv ).r;

	if ( depth <= 0.0 || depth >= 1.0 ) {
		imageStore( outLit, ivec2( pix ), vec4( 0.0 ) );
		return;
	}

	vec3 viewPos = reconstructViewPos( uv, depth );
	vec3 N = normalize( texture( normalTex, uv ).xyz );
	vec3 albedo = texture( albedoTex, uv ).rgb;
	vec4 material = texture( materialTex, uv );
	float metalness = material.r;
	float roughness = material.g;
	float materialAO = clamp( material.b, 0.0, 1.0 );
	float aoCoupling = mix( 1.0, materialAO, clamp( pc.aoStrength, 0.0, 1.0 ) );
	vec3 V = normalize( -viewPos );
	vec3 F0 = mix( vec3( 0.04 ), albedo, metalness );

	uint tilesX = max( pc.tileGrid.x, 1u );
	uint tilesY = max( pc.tileGrid.y, 1u );
	float tilePxX = float( pc.extent.x ) / float( tilesX );
	float tilePxY = float( pc.extent.y ) / float( tilesY );
	uint tx = min( uint( float( pix.x ) / tilePxX ), tilesX - 1u );
	uint ty = min( uint( float( pix.y ) / tilePxY ), tilesY - 1u );
	uint tileId = ty * tilesX + tx;
	uint tbase = tileId * MAX_PER_TILE;

	uint nPack = uint( max( lights.data[0].x + 0.5, 0.0 ) );
	uint nLights = min( pc.numLights, nPack );
	uint maxPer = min( pc.maxPerTile, MAX_PER_TILE );

	vec3 irradiance = vec3( 0.0 );
	vec3 specularAcc = vec3( 0.0 );

	for ( uint k = 0u; k < maxPer; k++ ) {
		uint li = tiles.cells[ tbase + k ];
		if ( li == 0xFFFFFFFFu ) {
			break;
		}
		if ( li >= nLights ) {
			continue;
		}
		uint b0 = 2u + li * REC_VEC4S;
		vec3 lWorld = lights.data[ b0 ].xyz;
		float rad = max( lights.data[ b0 ].w, 1e-3 );
		vec4 lc = lights.data[ b0 + 1u ];
		vec4 lpack = lights.data[ b0 + 2u ];
		vec4 ltail = lights.data[ b0 + 3u ];
		vec3 lView = ( pc.viewMatrix * vec4( lWorld, 1.0 ) ).xyz;
		vec3 L;
		float nlAtt;
		float addBoost = mix( 1.0, 1.25, step( 0.5, ltail.z ) );

		if ( lc.w < 0.5 ) {
			nlAtt = evalPointLight( lView, viewPos, N, rad, L );
		} else {
			vec3 axisView = toViewDir( lpack.xyz );
			nlAtt = evalSpotLight( lView, viewPos, N, rad, axisView, lpack.w, ltail.x, ltail.y, L );
		}
		if ( nlAtt <= 0.0 ) {
			continue;
		}
		irradiance += lc.rgb * addBoost * nlAtt * aoCoupling;
		if ( pc.specular != 0u ) {
			vec3 H = normalize( L + V );
			float NH = max( dot( N, H ), 0.0 );
			float NL = max( dot( N, L ), 0.0 );
			float NE = max( dot( N, V ), 0.0 );
			float VH = max( dot( V, H ), 0.0 );
			float alpha = max( roughness * roughness, 0.04 );
			vec3 F = F0 + ( 1.0 - F0 ) * pow( 1.0 - VH, 5.0 );
			float D = D_GGX( NH, alpha );
			float Vis = CalcVisibility( NL, NE, alpha );
			specularAcc += lc.rgb * addBoost * ( D * Vis * F * NL ) *
				mix( 1.0, aoCoupling, 0.5 ) * pc.specularStrength;
		}
	}

	float roughMod = mix( 1.0, 0.85, roughness );
	vec3 diffuseTerm = albedo * ( 1.0 - metalness ) * irradiance;
	vec3 lit;
	if ( pc.additive != 0u ) {
		/* Match Forward+ Fd*irradiance + Fs (additive over unlit base). */
		vec3 dynamic = ( diffuseTerm + specularAcc ) * roughMod * pc.strength;
		lit = dynamic;
	} else {
		lit = albedo * ( vec3( 0.04 ) + irradiance ) * roughMod * pc.strength;
		if ( pc.specular != 0u ) {
			lit += specularAcc * roughMod * pc.strength;
		}
	}
	imageStore( outLit, ivec2( pix ), vec4( lit, 1.0 ) );
}
