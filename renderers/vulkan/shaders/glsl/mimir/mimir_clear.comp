#version 450
/* Mímir — clear framebuffer before point splat (arXiv:2504.20937). */
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba8, set = 0, binding = 0) uniform writeonly image2D colorOut;

layout(push_constant) uniform ClearPush {
	ivec4 viewport;
} pc;

void main() {
	ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	if (pix.x >= pc.viewport.x || pix.y >= pc.viewport.y) {
		return;
	}
	imageStore(colorOut, pix, vec4(0.05, 0.06, 0.10, 1.0));
}
