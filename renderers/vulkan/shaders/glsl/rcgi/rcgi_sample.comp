#version 460
#extension GL_GOOGLE_include_directive : require
/*
 * NVIDIA workaround: rcgi_sample must not contain RayQueryKHR SPIR-V.
 * vkCreateComputePipelines SIGSEGVs in libnvidia-glvkspirv (595.x) for any
 * RcGI sample module that declares/uses ray query — even unreachable.
 * Binding 0 is a dummy storage buffer (host layout matches). TLAS sampling
 * is deferred until a driver-safe RQ pattern exists; probes get sky seeds.
 */
layout(local_size_x = 64) in;

#include "rcgi.glsl"

layout(std430, set = 0, binding = 0) readonly buffer DummyAsSlot {
	uint dummyAsWords[];
};
layout(std430, set = 0, binding = 1) buffer CacheBuf {
	RcGiCacheCell cells[];
};
layout(std430, set = 0, binding = 2) buffer ActiveList {
	uint activeCount;
	uint pad0;
	uint pad1;
	uint pad2;
	uint activeIndices[];
};
layout(std430, set = 0, binding = 3) writeonly buffer HitPack {
	uvec4 hits[];
};
layout(std430, set = 0, binding = 4) readonly buffer WorldAlbedoSSBO {
	float rgb[];
};
layout(std430, set = 0, binding = 5) readonly buffer WorldNormalSSBO {
	float nxyz[];
};

layout(push_constant) uniform SamplePush {
	uvec4 params;
	vec4  cascadeOrigin;
	vec4  camera;
	vec4  cache;
} pc;

vec3 probe_pos(uvec3 cell, uint grid, vec3 origin, float halfExt) {
	float cellSize = (halfExt * 2.0) / float(grid);
	vec3 o = origin - vec3(halfExt);
	return o + (vec3(cell) + 0.5) * cellSize;
}

void main() {
	uint grid = max(pc.params.y, 1u);
	uint probes = grid * grid * grid;
	uint rays = clamp(pc.params.z, 1u, 64u);
	uint work = probes * rays;
	uint id = gl_GlobalInvocationID.x;
	if (id >= work) {
		return;
	}

	uint probeLocal = id / rays;
	uint r = id - probeLocal * rays;
	uint gx = probeLocal % grid;
	uint gy = (probeLocal / grid) % grid;
	uint gz = probeLocal / (grid * grid);
	vec3 origin = probe_pos(uvec3(gx, gy, gz), grid, pc.cascadeOrigin.xyz, pc.cascadeOrigin.w);

	float hitDist = max(pc.camera.w, 1.0) * 0.25;
	hits[id] = uvec4(dummyAsWords.length() > 0u ? dummyAsWords[0] : 0u,
		0u, 0u, floatBitsToUint(hitDist));

	vec3 radiance = rcgi_default_sky();
	if (rgb.length() > 3u && nxyz.length() > 3u && origin.x > 1.0e20) {
		radiance = vec3(rgb[0], rgb[1], rgb[2]);
	}

	uint slot = id % RCGI_CACHE_CELLS;
	cells[slot].radianceAge = vec4(radiance, float(pc.params.w));
	cells[slot].normalDist = vec4(0.0, 0.0, 1.0, hitDist);
	cells[slot].meta = uvec4(RCGI_CACHE_VALID, probeLocal, r, pc.params.w);

	uint ai = atomicAdd(activeCount, 1u);
	if (ai < RCGI_CACHE_CELLS) {
		activeIndices[ai] = slot;
	}
}
