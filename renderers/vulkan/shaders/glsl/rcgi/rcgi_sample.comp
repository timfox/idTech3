#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

#include "rcgi.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(std430, set = 0, binding = 1) buffer CacheBuf {
	RcGiCacheCell cells[];
};
layout(std430, set = 0, binding = 2) buffer ActiveList {
	uint activeCount;
	uint pad0;
	uint pad1;
	uint pad2;
	uint activeIndices[];
};
layout(std430, set = 0, binding = 3) writeonly buffer HitPack {
	uvec4 hits[]; /* per probe*ray: xy packed ids, z bary+flags, w floatBits hitDist */
};
layout(std430, set = 0, binding = 4) readonly buffer WorldAlbedoSSBO {
	float rgb[];
};
layout(std430, set = 0, binding = 5) readonly buffer WorldNormalSSBO {
	float nxyz[];
};

layout(push_constant) uniform SamplePush {
	uvec4 params; /* x=cascade y=gridRes z=raysPerProbe w=frame */
	vec4  cascadeOrigin; /* xyz, w halfExtent */
	vec4  camera; /* xyz cam, w maxRayDist */
	vec4  cache; /* x=cellSize y=lodDist z=seed w=unused */
} pc;

vec3 probe_pos(uint cascade, uvec3 cell, uint grid, vec3 origin, float halfExt) {
	float cellSize = (halfExt * 2.0) / float(grid);
	vec3 o = origin - vec3(halfExt);
	return o + (vec3(cell) + 0.5) * cellSize;
}

void main() {
	uint probeLocal = gl_GlobalInvocationID.x;
	uint grid = max(pc.params.y, 1u);
	uint probes = grid * grid * grid;
	if (probeLocal >= probes) {
		return;
	}

	uint gx = probeLocal % grid;
	uint gy = (probeLocal / grid) % grid;
	uint gz = probeLocal / (grid * grid);
	uint cascade = pc.params.x;
	uint rays = clamp(pc.params.z, 1u, 64u);
	vec3 origin = probe_pos(cascade, uvec3(gx, gy, gz), grid, pc.cascadeOrigin.xyz, pc.cascadeOrigin.w);
	uint seed = pc.params.w * 747796405u + probeLocal * 2891336453u + uint(pc.cache.z);

	for (uint r = 0u; r < rays; ++r) {
		seed = seed * 1664525u + 1013904223u;
		float u0 = float((seed >> 8u) & 0xFFFFu) / 65535.0;
		seed = seed * 1664525u + 1013904223u;
		float u1 = float((seed >> 8u) & 0xFFFFu) / 65535.0;
		/* Cosine-weighted around +Z then randomize with second hash as up. */
		vec3 n = vec3(0.0, 0.0, 1.0);
		if ((r & 1u) != 0u) n = vec3(0.0, 1.0, 0.0);
		if ((r & 2u) != 0u) n = vec3(1.0, 0.0, 0.0);
		vec3 dir = rcgi_hemi(vec2(u0 * 0.99 + 0.01, u1), n);
		float tmax = max(pc.camera.w, 1.0);

		rayQueryEXT rq;
		rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.05, dir, tmax);
		rayQueryProceedEXT(rq);

		uint hitIndex = probeLocal * rays + r;
		uvec4 pack = uvec4(0u);
		vec3 radiance = rcgi_default_sky();
		vec3 hitN = -dir;
		float hitDist = tmax;
		uint flags = RCGI_CACHE_VALID;

		if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
			flags |= RCGI_CACHE_HIT;
			hitDist = rayQueryGetIntersectionTEXT(rq, true);
			vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
			int primId = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
			uint custom = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
			pack.x = uint(primId) | (custom << 24u);
			pack.y = rayQueryGetIntersectionInstanceIdEXT(rq, true);
			pack.z = packUnorm2x16(bary);
			pack.w = floatBitsToUint(hitDist);

			uint prim = uint(max(primId, 0));
			if (custom == 0u && rgb.length() >= (prim + 1u) * 3u) {
				radiance = vec3(rgb[prim * 3u], rgb[prim * 3u + 1u], rgb[prim * 3u + 2u]);
			} else {
				radiance = rcgi_default_albedo();
			}
			if (custom == 0u && nxyz.length() >= (prim + 1u) * 3u) {
				hitN = normalize(vec3(nxyz[prim * 3u], nxyz[prim * 3u + 1u], nxyz[prim * 3u + 2u]));
			}
		} else {
			pack.w = floatBitsToUint(tmax);
		}
		hits[hitIndex] = pack;

		vec3 hitPos = origin + dir * hitDist;
		float distCam = length(hitPos - pc.camera.xyz);
		uint idx = rcgi_spatial_hash(hitPos, max(pc.cache.x, 0.05), distCam, max(pc.cache.y, 8.0));

		/* Linear probe a few slots on collision. */
		uint slot = idx;
		for (uint k = 0u; k < RCGI_CACHE_PROBE; ++k) {
			uint trySlot = (idx + k) % RCGI_CACHE_CELLS;
			if ((cells[trySlot].meta.x & RCGI_CACHE_VALID) == 0u ||
			    cells[trySlot].meta.w + 8u < pc.params.w) {
				slot = trySlot;
				break;
			}
			slot = trySlot;
		}

		cells[slot].radianceAge = vec4(radiance, float(pc.params.w));
		cells[slot].normalDist = vec4(hitN, hitDist);
		cells[slot].meta = uvec4(flags, probeLocal, r, pc.params.w);

		uint ai = atomicAdd(activeCount, 1u);
		if (ai < RCGI_CACHE_CELLS) {
			activeIndices[ai] = slot;
		}
	}
}
