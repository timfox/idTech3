#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;

#include "../depth_view.glsl"

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2) uniform sampler2D gatherLow;
layout(set = 0, binding = 3) uniform sampler2D historyTex;
layout(rgba16f, set = 0, binding = 4) uniform image2D irradianceOut;
layout(rgba16f, set = 0, binding = 5) uniform image2D historyOut;

layout(push_constant) uniform UpscalePush {
	uvec4 params; /* x=fullW y=fullH z=lowW w=lowH */
	vec4  temporal; /* x=blend, y=depthSharpness, z=zNear, w=zFar */
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (pix.x >= pc.params.x || pix.y >= pc.params.y) {
		return;
	}
	vec2 uv = (vec2(pix) + 0.5) / vec2(pc.params.xy);
	float depth = texture(depthTex, uv).r;
	vec3 n = normalize(texture(normalTex, uv).xyz * 2.0 - 1.0);
	if (depth <= 0.0 || depth >= 0.9999) {
		imageStore(irradianceOut, ivec2(pix), vec4(0.0));
		imageStore(historyOut, ivec2(pix), vec4(0.0));
		return;
	}

	float centerView = Depth_LinearizeReversedZ(depth, pc.temporal.z, pc.temporal.w);
	float depthSharp = max(pc.temporal.y, 1.0);
	ivec2 lowSize = ivec2(int(pc.params.z), int(pc.params.w));
	ivec2 tmax = lowSize - ivec2(1);
	vec2 lowCoord = uv * vec2(pc.params.zw) - 0.5;
	ivec2 base = ivec2(floor(lowCoord));
	vec2 f = fract(lowCoord);
	ivec2 offs[4] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));
	float spat[4] = float[]((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y),
		(1.0 - f.x) * f.y, f.x * f.y);
	vec3 accum = vec3(0.0);
	float wsum = 0.0;
	for (int i = 0; i < 4; ++i) {
		ivec2 tc = clamp(base + offs[i], ivec2(0), tmax);
		vec2 suv = (vec2(tc) + 0.5) / vec2(pc.params.zw);
		float sd = texture(depthTex, suv).r;
		if (sd <= 0.0 || sd >= 0.9999) {
			continue;
		}
		vec3 sn = normalize(texture(normalTex, suv).xyz * 2.0 - 1.0);
		vec3 sc = texelFetch(gatherLow, tc, 0).rgb;
		float sv = Depth_LinearizeReversedZ(sd, pc.temporal.z, pc.temporal.w);
		float w = spat[i] * Depth_BilateralWeight(centerView, sv, depthSharp) *
			Depth_NormalWeight(n, sn, 8.0);
		accum += sc * w;
		wsum += w;
	}
	ivec2 nearest = clamp(ivec2(round(uv * vec2(pc.params.zw) - 0.5)), ivec2(0), tmax);
	vec3 curr = (wsum < 1e-5) ? texelFetch(gatherLow, nearest, 0).rgb : (accum / wsum);
	vec3 hist = texture(historyTex, uv).rgb;
	float a = clamp(pc.temporal.x, 0.05, 0.95);
	/* Hard reject stale history when center has no valid bilateral support (edge). */
	if (wsum < 1e-5) {
		a = 1.0;
	}
	vec3 outc = mix(hist, curr, a);
	imageStore(irradianceOut, ivec2(pix), vec4(outc, 1.0));
	imageStore(historyOut, ivec2(pix), vec4(outc, 1.0));
}
