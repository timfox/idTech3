#version 460
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2) uniform sampler2D gatherLow;
layout(set = 0, binding = 3) uniform sampler2D historyTex;
layout(rgba16f, set = 0, binding = 4) uniform image2D irradianceOut;
layout(rgba16f, set = 0, binding = 5) uniform image2D historyOut;

layout(push_constant) uniform UpscalePush {
	uvec4 params; /* x=fullW y=fullH z=lowW w=lowH */
	vec4  temporal; /* x=blend */
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (pix.x >= pc.params.x || pix.y >= pc.params.y) {
		return;
	}
	vec2 uv = (vec2(pix) + 0.5) / vec2(pc.params.xy);
	float depth = texture(depthTex, uv).r;
	vec3 n = normalize(texture(normalTex, uv).xyz * 2.0 - 1.0);
	if (depth <= 0.0 || depth >= 0.9999) {
		imageStore(irradianceOut, ivec2(pix), vec4(0.0));
		imageStore(historyOut, ivec2(pix), vec4(0.0));
		return;
	}

	/* 4-tap poisson-ish in gather space. */
	vec2 lowTexel = 1.0 / vec2(pc.params.zw);
	vec2 base = uv;
	vec2 offs[4] = vec2[](vec2(-0.4, -0.2), vec2(0.3, -0.35), vec2(-0.25, 0.4), vec2(0.35, 0.25));
	vec3 accum = vec3(0.0);
	float wsum = 0.0;
	for (int i = 0; i < 4; ++i) {
		vec2 suv = clamp(base + offs[i] * lowTexel * 2.0, vec2(0.0), vec2(1.0));
		float sd = texture(depthTex, suv).r;
		vec3 sn = normalize(texture(normalTex, suv).xyz * 2.0 - 1.0);
		vec3 sc = texture(gatherLow, suv).rgb;
		float w = exp(-abs(sd - depth) * 40.0) * pow(max(dot(n, sn), 0.0), 8.0);
		accum += sc * w;
		wsum += w;
	}
	vec3 curr = accum / max(wsum, 1e-4);
	vec3 hist = texture(historyTex, uv).rgb;
	float a = clamp(pc.temporal.x, 0.05, 0.95);
	vec3 outc = mix(hist, curr, a);
	imageStore(irradianceOut, ivec2(pix), vec4(outc, 1.0));
	imageStore(historyOut, ivec2(pix), vec4(outc, 1.0));
}
