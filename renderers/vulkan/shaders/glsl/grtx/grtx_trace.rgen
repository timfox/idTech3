#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 0) rayPayloadEXT vec3 hitValue;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;

layout(set = 0, binding = 2, std140) uniform GrtxFrame {
	mat4 invViewProj;
	vec4 viewOrigin;
	vec4 zNearFar;
	vec4 outputSize;
	vec4 traceParams;
} grtx;

layout(set = 0, binding = 3) uniform sampler2D depthTex;
layout(set = 0, binding = 4) uniform sampler2D colorTex;

vec2 sampleOffset( int index )
{
	switch ( index & 7 ) {
		case 0: return vec2( 0.5, 0.5 );
		case 1: return vec2( 0.25, 0.75 );
		case 2: return vec2( 0.75, 0.25 );
		case 3: return vec2( 0.125, 0.375 );
		case 4: return vec2( 0.625, 0.875 );
		case 5: return vec2( 0.375, 0.125 );
		case 6: return vec2( 0.875, 0.625 );
		default: return vec2( 0.0625, 0.5625 );
	}
}

vec3 tracePrimary( vec2 uv )
{
	float d = textureLod( depthTex, uv, 0.0 ).r;
	vec3 ro = grtx.viewOrigin.xyz;
	vec3 rd;

	if ( d <= 0.0 || d >= 1.0 ) {
		vec4 farClip = vec4( uv * 2.0 - 1.0, 0.0, 1.0 );
		vec4 farW = grtx.invViewProj * farClip;
		farW /= max( abs( farW.w ), 1e-6 );
		rd = normalize( farW.xyz - ro );
	} else {
		vec4 clip = vec4( uv * 2.0 - 1.0, d, 1.0 );
		vec4 worldPos = grtx.invViewProj * clip;
		worldPos /= max( abs( worldPos.w ), 1e-6 );
		rd = normalize( worldPos.xyz - ro );
	}

	hitValue = vec3( 0.0 );
	traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, 0.01, rd, 1.0e5, 0 );
	return hitValue;
}

void main()
{
	vec2 extent = max( grtx.outputSize.xy, vec2( 1.0 ) );
	ivec2 pix = ivec2( gl_LaunchIDEXT.xy );
	if ( pix.x >= int( extent.x ) || pix.y >= int( extent.y ) ) {
		return;
	}

	int samples = int( clamp( grtx.traceParams.x, 1.0, 8.0 ) );
	vec3 accum = vec3( 0.0 );
	int i;
	for ( i = 0; i < samples; i++ ) {
		vec2 uv = ( vec2( pix ) + sampleOffset( i ) ) / extent;
		accum += tracePrimary( uv );
	}
	accum /= float( samples );

	vec3 raster = textureLod( colorTex, ( vec2( pix ) + 0.5 ) / extent, 0.0 ).rgb;
	float blend = clamp( grtx.outputSize.w, 0.0, 1.0 );
	if ( blend > 0.0 ) {
		accum = mix( accum, raster, blend );
	}

	imageStore( outImage, pix, vec4( accum, 1.0 ) );
}
