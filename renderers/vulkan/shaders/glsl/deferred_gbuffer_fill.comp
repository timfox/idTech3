#version 450
#extension GL_GOOGLE_include_directive : require

/*
 * Deferred G-buffer scaffold: view-space normal + material contract from depth.
 * Albedo is copied separately (scene color -> deferred_gbuffer_albedo).
 * materialOut = metalness, roughness, AO, sourceConfidence.
 * r_gbufferCompact 1: dual-write octahedral normal into material.ba (scaffold XYZ in normalOut).
 */

#include "gbuffer_octahedral.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D normalOut;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D materialOut;

layout(push_constant) uniform Push {
	vec4 projInfo; /* invProj00, invProj11, proj10, proj14 (SSAO-compatible) */
	vec4 materialParams; /* metalness, roughness, normal edge threshold, msaaSafe */
	uvec2 extent;
	uint gbufferFlags; /* bit0: compact dual-write oct into material.ba */
} pc;

const uint GBUFFER_FLAG_COMPACT_DUAL_WRITE = 1u;

float viewZFromDepth( float depth ) {
	return -pc.projInfo.w / max( depth + pc.projInfo.z, 1e-6 );
}

vec3 reconstructViewPos( vec2 uv, float depth ) {
	float viewZ = viewZFromDepth( depth );
	float negZ = -viewZ;
	vec2 ndc = uv * 2.0 - 1.0;
	return vec3( ndc.x * negZ * pc.projInfo.x, ndc.y * negZ * pc.projInfo.y, viewZ );
}

bool validDepth( float depth ) {
	return depth > 0.0 && depth < 1.0;
}

vec3 neighborPos( vec2 uv, float depth, vec3 centerPos ) {
	return validDepth( depth ) ? reconstructViewPos( uv, depth ) : centerPos;
}

float depthGradient( float center, float a, float b ) {
	float da = validDepth( a ) ? abs( a - center ) : 1.0;
	float db = validDepth( b ) ? abs( b - center ) : 1.0;
	return min( da, db );
}

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= pc.extent.x || pix.y >= pc.extent.y ) {
		return;
	}

	vec2 uv = ( vec2( pix ) + 0.5 ) / vec2( pc.extent );
	float depth = texture( depthTex, uv ).r;
	vec4 baseMaterial = vec4( clamp( pc.materialParams.x, 0.0, 1.0 ),
		clamp( pc.materialParams.y, 0.04, 1.0 ), 1.0, 0.0 );

	if ( !validDepth( depth ) ) {
		vec4 matOut = baseMaterial;
		if ( ( pc.gbufferFlags & GBUFFER_FLAG_COMPACT_DUAL_WRITE ) != 0u ) {
			vec2 oct = GbufEncodeOctahedral( vec3( 0.0, 0.0, 1.0 ) );
			matOut = vec4( baseMaterial.rg, oct );
		}
		imageStore( normalOut, ivec2( pix ), vec4( 0.0, 0.0, 1.0, 0.0 ) );
		imageStore( materialOut, ivec2( pix ), matOut );
		return;
	}

	vec2 texel = 1.0 / vec2( pc.extent );
	float dl = texture( depthTex, uv + vec2( -texel.x, 0.0 ) ).r;
	float dr = texture( depthTex, uv + vec2( texel.x, 0.0 ) ).r;
	float du = texture( depthTex, uv + vec2( 0.0, -texel.y ) ).r;
	float dd = texture( depthTex, uv + vec2( 0.0, texel.y ) ).r;

	vec3 pos = reconstructViewPos( uv, depth );
	vec3 posL = neighborPos( uv + vec2( -texel.x, 0.0 ), dl, pos );
	vec3 posR = neighborPos( uv + vec2( texel.x, 0.0 ), dr, pos );
	vec3 posU = neighborPos( uv + vec2( 0.0, -texel.y ), du, pos );
	vec3 posD = neighborPos( uv + vec2( 0.0, texel.y ), dd, pos );
	float threshold = max( pc.materialParams.z, 0.001 );
	vec3 dxL = pos - posL;
	vec3 dxR = posR - pos;
	vec3 dyU = pos - posU;
	vec3 dyD = posD - pos;
	vec3 dx = ( abs( dxL.z ) < abs( dxR.z ) ) ? dxL : dxR;
	vec3 dy = ( abs( dyU.z ) < abs( dyD.z ) ) ? dyU : dyD;
	float confidence = 1.0;
	if ( abs( dx.z ) > threshold ) {
		dx = vec3( texel.x, 0.0, 0.0 );
		confidence *= 0.5;
	}
	if ( abs( dy.z ) > threshold ) {
		dy = vec3( 0.0, texel.y, 0.0 );
		confidence *= 0.5;
	}
	vec3 crossN = cross( dx, dy );
	float crossLen = length( crossN );
	vec3 n = ( crossLen > 1e-6 ) ? ( crossN / crossLen ) : vec3( 0.0, 0.0, 1.0 );
	if ( crossLen <= 1e-6 ) {
		confidence = 0.0;
	}

	float edgeMetric = max( depthGradient( depth, dl, dr ), depthGradient( depth, du, dd ) );
	float edgeFactor = clamp( edgeMetric / max( threshold, 1e-4 ), 0.0, 1.0 );
	/* Deeper confidence falloff on geometric edges reduces deferred lighting flicker into TAA. */
	confidence *= mix( 1.0, 0.35, edgeFactor );
	float fallbackMetalness = baseMaterial.r * ( 1.0 - 0.85 * edgeFactor );
	float fallbackRoughness = mix( baseMaterial.g, 0.92, max( edgeFactor, 1.0 - confidence ) );
	float fallbackAO = mix( 1.0, 0.82, edgeFactor * confidence );

	/*
	 * deferredMsaaSafeMaterials: when depth-fallback is used under MSAA (no direct MRT),
	 * keep a usable confidence floor on flat surfaces so metal/rough do not collapse to defaults.
	 */
	if ( pc.materialParams.w > 0.5 ) {
		confidence = max( confidence, mix( 0.65, 0.35, edgeFactor ) );
		fallbackRoughness = mix( baseMaterial.g, fallbackRoughness, 0.5 );
		fallbackMetalness = mix( baseMaterial.r, fallbackMetalness, 0.5 );
	}

	imageStore( normalOut, ivec2( pix ), vec4( n, confidence ) );
	if ( ( pc.gbufferFlags & GBUFFER_FLAG_COMPACT_DUAL_WRITE ) != 0u ) {
		vec2 oct = GbufEncodeOctahedral( n );
		/* Compact prep: octahedral in material.ba; scaffold XYZ stays in normalOut for lighting. */
		imageStore( materialOut, ivec2( pix ), vec4( fallbackMetalness, fallbackRoughness, oct ) );
	} else {
		/* material.a = sourceConfidence (same signal as normal.a) for classify. */
		imageStore( materialOut, ivec2( pix ), vec4( fallbackMetalness, fallbackRoughness, fallbackAO, confidence ) );
	}
}
