#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#include "hybrid1_ubo.glsl"

layout( location = 0 ) rayPayloadEXT float shadowVis;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT topLevelAS;
layout( rgba16f, set = 0, binding = 1 ) uniform writeonly image2D shadowOut;

layout( set = 0, binding = 3 ) uniform sampler2D depthTex;
layout( set = 0, binding = 4 ) uniform sampler2D normalTex;
layout( set = 0, binding = 5 ) uniform sampler2D materialTex;

/* Forward+ light SSBO (header + records); dummy zeros when Forward+ off. */
layout( set = 0, binding = 11, std430 ) readonly buffer Hybrid1FpLights {
	vec4 fp_light_data[];
};

vec3 hybrid1_softSunDir( vec3 L, vec2 uv, float frameSeed, float radiusDeg )
{
	if ( radiusDeg <= 1e-4 ) {
		return L;
	}
	float r0 = fract( sin( dot( uv * frameSeed, vec2( 12.9898, 78.233 ) ) ) * 43758.5453 );
	float r1 = fract( sin( dot( uv * ( frameSeed + 19.0 ), vec2( 39.346, 11.135 ) ) ) * 22578.1459 );
	vec3 up = abs( L.z ) < 0.999 ? vec3( 0.0, 0.0, 1.0 ) : vec3( 1.0, 0.0, 0.0 );
	vec3 T = normalize( cross( up, L ) );
	vec3 B = cross( L, T );
	float ang = radians( radiusDeg );
	float r = sqrt( r0 ) * tan( ang );
	float phi = 6.2831853 * r1;
	return normalize( L + T * ( cos( phi ) * r ) + B * ( sin( phi ) * r ) );
}

void main()
{
	vec2 extent = max( h1.outputSize.xy, vec2( 1.0 ) );
	vec2 uv = ( vec2( gl_LaunchIDEXT.xy ) + vec2( 0.5 ) ) / extent;
	float depth = textureLod( depthTex, uv, 0.0 ).r;

	if ( depth <= 0.0 || depth >= 1.0 ) {
		imageStore( shadowOut, ivec2( gl_LaunchIDEXT.xy ), vec4( 1.0, 0.0, 0.0, 1.0 ) );
		return;
	}

	vec4 clip = vec4( uv * 2.0 - 1.0, depth, 1.0 );
	vec4 worldPos4 = h1.invViewProj * clip;
	worldPos4 /= max( abs( worldPos4.w ), 1e-6 );
	vec3 worldPos = worldPos4.xyz;

	vec3 N = vec3( 0.0, 0.0, 1.0 );
	if ( h1.params1.z > 0.5 ) {
		N = textureLod( normalTex, uv, 0.0 ).xyz * 2.0 - 1.0;
		float nLen = length( N );
		if ( nLen > 0.01 ) {
			N /= nLen;
		}
	}

	vec3 L = normalize( h1.sunDirection.xyz );
	float shadowAngle = degrees( acos( clamp( dot( N, L ), -1.0, 1.0 ) ) );
	float radiusDeg = max( h1.sunDirection.w, 0.0 );
	if ( h1.params2.z > 0.5 && radiusDeg > 0.0 ) {
		/* Contact harden: shrink penumbra when nearly facing the sun */
		float ndl = clamp( dot( N, L ), 0.0, 1.0 );
		radiusDeg *= mix( 1.0, 0.25, ndl );
	}
	vec3 rd = hybrid1_softSunDir( L, uv, h1.params0.w, radiusDeg );

	vec3 ro = worldPos + N * max( h1.params2.x, 0.0 );

	float sunVis = 1.0;
	shadowVis = 1.0;
	traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, max( h1.params2.y, 1e-4 ), rd, 1.0e5, 0 );
	sunVis = shadowVis;

	float outVis = sunVis;
	float dlightBudget = h1.outputSize.w;
	if ( dlightBudget > 0.5 ) {
		uint want = uint( clamp( dlightBudget, 1.0, 4.0 ) + 0.5 );
		uint packed = uint( max( fp_light_data[0].x, 0.0 ) );
		uint n = min( want, min( packed, 4u ) );
		if ( n > 0u ) {
			float dlVis = 1.0;
			for ( uint i = 0u; i < n; i++ ) {
				uint b0 = 2u + i * 4u;
				vec3 lpos = fp_light_data[b0].xyz;
				float rad = max( fp_light_data[b0].w, 1.0 );
				vec3 toL = lpos - worldPos;
				float dist = length( toL );
				if ( dist < 1e-3 || dist > rad ) {
					continue;
				}
				vec3 dRd = toL / dist;
				shadowVis = 1.0;
				traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, max( h1.params2.y, 1e-4 ), dRd, dist, 0 );
				dlVis = min( dlVis, shadowVis );
			}
			outVis = min( sunVis, mix( 1.0, dlVis, 0.65 ) );
		} else if ( h1.dlightDir.w > 0.01 ) {
			/* Fallback: first refdef dlight packed into UBO when FP SSBO empty */
			vec3 dRd = normalize( h1.dlightDir.xyz - worldPos );
			shadowVis = 1.0;
			traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, max( h1.params2.y, 1e-4 ), dRd, 1.0e5, 0 );
			outVis = min( sunVis, mix( 1.0, shadowVis, clamp( h1.dlightDir.w, 0.0, 1.0 ) ) );
		}
	}

	imageStore( shadowOut, ivec2( gl_LaunchIDEXT.xy ), vec4( outVis, shadowAngle, radiusDeg, 1.0 ) );
}
