#version 450
/*
 * Composite denoised shadow + specular + optional diffuse with raster HDR.
 * Optional Surfel GI irradiance (binding 6) when Hybrid1↔Surfel fusion is active.
 */
layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform sampler2D depthTex;
layout( set = 0, binding = 1 ) uniform sampler2D shadowTex;
layout( set = 0, binding = 2 ) uniform sampler2D specTex;
layout( set = 0, binding = 3 ) uniform sampler2D diffuseTex;
layout( set = 0, binding = 4 ) uniform sampler2D albedoTex;
layout( rgba16f, set = 0, binding = 5 ) uniform image2D colorOut;
layout( set = 0, binding = 6 ) uniform sampler2D surfelIrradianceTex;
layout( set = 0, binding = 7 ) uniform sampler2D ambientVisibilityTex;

layout( push_constant ) uniform Hybrid1CompositePush {
	vec4 extent;
	vec4 strengths; /* x=shadow, y=spec, z=debug mode, w=diffuse */
	vec4 surfel;    /* x=strength, y=useSurfel, z=ambient visibility strength */
} pc;

void main()
{
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= uint( pc.extent.x ) || pix.y >= uint( pc.extent.y ) ) {
		return;
	}

	vec2 uv = ( vec2( pix ) + 0.5 ) / pc.extent.xy;
	float depth = texture( depthTex, uv ).r;
	vec4 scene = imageLoad( colorOut, ivec2( pix ) );

	if ( depth <= 0.0 || depth >= 1.0 ) {
		return;
	}

	float shadowVis = texture( shadowTex, uv ).r;
	vec3 specRgb = texture( specTex, uv ).rgb;
	vec3 diffuseRgb = texture( diffuseTex, uv ).rgb;
	vec3 albedo = texture( albedoTex, uv ).rgb;
	vec3 surfelIrr = texture( surfelIrradianceTex, uv ).rgb;
	float shadowStr = pc.strengths.x;
	float specStr = pc.strengths.y;
	int debugMode = int( pc.strengths.z + 0.5 );
	float diffuseStr = pc.strengths.w;
	float surfelStr = pc.surfel.x;
	float useSurfel = pc.surfel.y;
	float av = mix( 1.0, clamp( texture( ambientVisibilityTex, uv ).r, 0.0, 1.0 ),
		clamp( pc.surfel.z, 0.0, 1.0 ) );

	vec3 outRgb = scene.rgb;

	if ( debugMode == 1 ) {
		outRgb = vec3( shadowVis );
	} else if ( debugMode == 2 ) {
		outRgb = specRgb;
	} else if ( debugMode == 3 ) {
		outRgb = vec3( texture( shadowTex, uv ).g / 90.0 );
	} else if ( debugMode == 4 ) {
		outRgb = diffuseRgb * albedo;
	} else if ( debugMode == 5 ) {
		outRgb = surfelIrr;
	} else {
		float shadowFactor = mix( 1.0, shadowVis, clamp( shadowStr, 0.0, 1.0 ) );
		outRgb = scene.rgb * shadowFactor + specRgb * specStr + diffuseRgb * albedo * diffuseStr;
		if ( useSurfel > 0.5 ) {
			outRgb += albedo * surfelIrr * surfelStr * av;
		}
	}

	imageStore( colorOut, ivec2( pix ), vec4( outRgb, scene.a ) );
}
