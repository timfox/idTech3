#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#include "hybrid1_ubo.glsl"
#include "hybrid1_brdf.glsl"
#include "../glint_ndf.glsl"

layout( location = 0 ) rayPayloadEXT vec4 specRadiance;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT topLevelAS;
layout( rgba16f, set = 0, binding = 1 ) uniform writeonly image2D specOut;

layout( set = 0, binding = 3 ) uniform sampler2D depthTex;
layout( set = 0, binding = 4 ) uniform sampler2D normalTex;
layout( set = 0, binding = 5 ) uniform sampler2D materialTex;

void main()
{
	vec2 extent = max( h1.outputSize.xy, vec2( 1.0 ) );
	vec2 uv = ( vec2( gl_LaunchIDEXT.xy ) + vec2( 0.5 ) ) / extent;
	float depth = textureLod( depthTex, uv, 0.0 ).r;

	if ( depth <= 0.0 || depth >= 1.0 ) {
		imageStore( specOut, ivec2( gl_LaunchIDEXT.xy ), vec4( 0.0, 0.0, 0.0, 1.0 ) );
		return;
	}

	vec4 clip = vec4( uv * 2.0 - 1.0, depth, 1.0 );
	vec4 worldPos4 = h1.invViewProj * clip;
	worldPos4 /= max( abs( worldPos4.w ), 1e-6 );
	vec3 worldPos = worldPos4.xyz;

	vec3 N = vec3( 0.0, 0.0, 1.0 );
	float roughness = 0.5;
	float metalness = 0.0;
	if ( h1.params1.z > 0.5 ) {
		N = textureLod( normalTex, uv, 0.0 ).xyz * 2.0 - 1.0;
		float nLen = length( N );
		if ( nLen > 0.01 ) {
			N /= nLen;
		}
		vec4 mat = textureLod( materialTex, uv, 0.0 );
		metalness = clamp( mat.r, 0.0, 1.0 );
		roughness = clamp( mat.g, 0.02, 1.0 );
	}

	vec3 V = normalize( h1.viewOrigin.xyz - worldPos );
	vec3 R = reflect( -V, N );
	if ( roughness >= h1.params2.w ) {
		imageStore( specOut, ivec2( gl_LaunchIDEXT.xy ), vec4( 0.0, 0.0, 0.0, roughness ) );
		return;
	}

	vec3 ro = worldPos + N * max( h1.params2.x, 0.0 );
	vec3 rd = R;
	vec3 H = N;
	float r0 = fract( sin( dot( uv * h1.params0.w, vec2( 12.9898, 78.233 ) ) ) * 43758.5453 );
	float r1 = fract( sin( dot( uv * ( h1.params0.w + 17.0 ), vec2( 39.346, 11.135 ) ) ) * 22578.1459 );
	if ( h1.params3.x > 0.5 ) {
		H = hybrid1_ggxVndf( V, N, roughness, vec2( r0, r1 ) );
		rd = normalize( reflect( -V, H ) );
	} else if ( roughness > 0.05 ) {
		vec3 jitter = normalize( N + roughness * vec3( r0 * 2.0 - 1.0, r1 * 2.0 - 1.0, ( r0 + r1 ) * 2.0 - 1.0 ) );
		H = normalize( mix( N, jitter, roughness ) );
		rd = normalize( reflect( -V, H ) );
	}

	specRadiance = vec4( 0.0 );
	specRadiance.w = roughness;
	/* Pack metalness into payload alpha high bits via roughness channel already used;
	   store metalness in unused payload by encoding: keep roughness in .w, metalness via params. */
	traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, max( h1.params2.y, 1e-4 ), rd, 1.0e5, 0 );

	vec3 outRgb = specRadiance.rgb;
	if ( h1.params3.x > 0.5 ) {
		vec3 F0 = mix( vec3( 0.04 ), vec3( 1.0 ), metalness );
		float NdotV = max( dot( N, V ), 0.0 );
		outRgb *= hybrid1_fresnelSchlick( NdotV, F0 );
	}

	/* Opt-in glint NDF weight (screen-UV jacobian proxy; material UV needs D2 bindless). */
	if ( h1.params3.w > 0.5 ) {
		float roughLo = min( h1.params5.z, h1.params5.w );
		float roughHi = max( h1.params5.z, h1.params5.w );
		roughHi = max( roughHi, roughLo + 0.001 );
		if ( roughness < roughHi ) {
			float glintWeight = clamp( 1.0 - smoothstep( roughLo, roughHi, roughness ), 0.0, 1.0 );
			if ( glintWeight > 0.0 ) {
				vec3 up = abs( N.z ) < 0.999 ? vec3( 0.0, 0.0, 1.0 ) : vec3( 1.0, 0.0, 0.0 );
				vec3 T = normalize( cross( up, N ) );
				vec3 B = cross( N, T );
				mat3 shadingFrame = mat3( T, B, N );
				vec2 pixel = 1.0 / extent;
				mat2 uvJac = mat2( vec2( pixel.x, 0.0 ), vec2( 0.0, pixel.y ) );
				float alpha = max( roughness * roughness, 0.001 );
				GlintParams gp;
				gp.density = max( h1.params4.x, 1e-3 );
				gp.microfacetRoughness = max( h1.params4.y, 1e-4 );
				gp.pixelFilterSize = max( h1.params4.z, 0.5 );
				gp.sampleBudget = clamp( h1.params4.w, 0.0, 2.0 );
				gp.maxLodClamp = max( h1.params5.x, 0.1 );
				gp.dClamp = max( h1.params5.y, 1.0 );
				float lambda = 0.0;
				float comp = 0.0;
				float Dgl = D_GLINT_GGX( shadingFrame, H, uv, uvJac, alpha, gp, lambda, comp );
				float NdotH = max( dot( N, H ), 0.0 );
				float Dggx = max( hybrid1_dGgx( NdotH, alpha ), 1e-4 );
				float ratio = clamp( Dgl / Dggx, 0.0, 4.0 );
				outRgb *= mix( 1.0, ratio, glintWeight );
			}
		}
	}

	float reinhardMul = max( h1.params0.z, 0.0 );
	if ( reinhardMul > 0.0 ) {
		float l = dot( outRgb, vec3( 0.2126, 0.7152, 0.0722 ) );
		outRgb /= ( 1.0 + l * reinhardMul );
	}

	imageStore( specOut, ivec2( gl_LaunchIDEXT.xy ), vec4( outRgb, roughness ) );
}
