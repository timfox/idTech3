#version 450
/*
 * Hybrid1 temporal accumulation + variance estimation + history rectification.
 * channel: 0 = shadow (R), 1 = specular (RGB)
 * When shsMode!=0, apply Selective Hybrid Shadows / Reflections rejection
 * (prefer noise over ghosting). shsMode 1 = shadow, 2 = specular (SHR).
 */
#extension GL_GOOGLE_include_directive : enable
#include "hybrid1_common.glsl"

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform sampler2D depthTex;
layout( set = 0, binding = 1 ) uniform sampler2D normalTex;
layout( set = 0, binding = 2 ) uniform sampler2D rawTex;
layout( set = 0, binding = 3 ) uniform sampler2D historyTex;
layout( rgba16f, set = 0, binding = 4 ) uniform writeonly image2D filteredOut;
layout( rgba16f, set = 0, binding = 5 ) uniform writeonly image2D historyOut;
layout( set = 0, binding = 6 ) uniform sampler2D varianceHistTex;
layout( rgba16f, set = 0, binding = 7 ) uniform writeonly image2D varianceOut;
layout( set = 0, binding = 8 ) uniform sampler2D motionTex;

layout( push_constant ) uniform Hybrid1TemporalPush {
	mat4 invViewProj;
	mat4 prevViewProj;
	vec4 extent;
	vec4 params; /* x=gamma, y=alpha, z=historyClamp on, w=channel (0 shadow, 1 spec) */
	uint hasGBuffer;
	uint firstFrame;
	uint useMotion;
	uint shsMode;
	vec4 shs; /* x=maxAge, y=hitDistRelTol, z=normalDotMin, w=unused */
} pc;

void main()
{
	uvec2 pix = gl_GlobalInvocationID.xy;
	if ( pix.x >= uint( pc.extent.x ) || pix.y >= uint( pc.extent.y ) ) {
		return;
	}

	vec2 uv = ( vec2( pix ) + 0.5 ) / pc.extent.xy;
	vec2 texel = 1.0 / pc.extent.xy;
	float depth = texture( depthTex, uv ).r;

	if ( depth <= 0.0 || depth >= 1.0 ) {
		vec4 raw = texture( rawTex, uv );
		imageStore( filteredOut, ivec2( pix ), raw );
		imageStore( historyOut, ivec2( pix ), raw );
		imageStore( varianceOut, ivec2( pix ), vec4( 0.0 ) );
		return;
	}

	vec4 raw = texture( rawTex, uv );
	vec3 filtered;
	vec3 histWrite;
	vec3 varWrite;
	float rejectReason = 0.0; /* 0=ok 1=first 2=oob 3=motion 4=normal 5=hitDist 6=age 7=invalid */

	if ( pc.params.w < 0.5 ) {
		float rawVis = raw.r;
		float histVis = rawVis;
		float variance = 0.0;
		float histAge = 0.0;
		float histHitT = raw.g;
		float alpha = pc.params.y;

		if ( pc.firstFrame != 0u ) {
			rejectReason = 1.0;
		} else {
			vec2 histUv = hybrid1_historyUV( pc.invViewProj, pc.prevViewProj, uv, depth, motionTex, pc.useMotion );
			if ( histUv.x < 0.0 || histUv.x > 1.0 || histUv.y < 0.0 || histUv.y > 1.0 ) {
				rejectReason = 2.0;
			} else if ( pc.useMotion != 0u ) {
				vec2 motion = texture( motionTex, uv ).rg;
				if ( any( isnan( motion ) ) || any( isinf( motion ) ) || length( motion ) > 0.35 ) {
					rejectReason = 3.0;
				}
			}

			if ( rejectReason < 0.5 ) {
				vec4 histSample = texture( historyTex, histUv );
				histVis = histSample.r;
				histHitT = histSample.g;
				histAge = histSample.b;
				variance = texture( varianceHistTex, histUv ).r;

				if ( pc.shsMode != 0u ) {
					vec3 N = hybrid1_decodeNormal( normalTex, uv, pc.hasGBuffer );
					vec3 Nh = hybrid1_decodeNormal( normalTex, histUv, pc.hasGBuffer );
					if ( dot( N, Nh ) < pc.shs.z ) {
						rejectReason = 4.0;
					}
					float rel = abs( raw.g - histHitT ) / max( max( raw.g, histHitT ), 1.0 );
					if ( rejectReason < 0.5 && rel > pc.shs.y ) {
						rejectReason = 5.0;
					}
					if ( rejectReason < 0.5 && histAge >= pc.shs.x ) {
						rejectReason = 6.0;
					}
					if ( rejectReason < 0.5 && raw.b < 0.5 ) {
						rejectReason = 7.0;
					}
				}

				if ( rejectReason < 0.5 && pc.params.z > 0.5 ) {
					float mn;
					float mx;
					float mean;
					float varN;
					hybrid1_varianceColorClamp1( rawTex, uv, texel, pc.params.x, mn, mx, mean, varN );
					histVis = hybrid1_clampFloat( histVis, mn, mx );
				}
			}
		}

		if ( rejectReason > 0.5 ) {
			histVis = rawVis;
			histAge = 0.0;
			alpha = 1.0;
		} else {
			histAge = min( histAge + 1.0, pc.shs.x );
			if ( pc.shsMode != 0u ) {
				/* Age-aware: older history contributes less; never a high fixed weight. */
				float ageFade = 1.0 - clamp( histAge / max( pc.shs.x, 1.0 ), 0.0, 0.75 );
				alpha = max( alpha, mix( alpha, 1.0, ageFade * 0.35 ) );
			}
		}

		filtered.r = mix( histVis, rawVis, alpha );
		filtered.g = raw.g;
		filtered.b = rejectReason;
		variance = mix( variance, ( rawVis - filtered.r ) * ( rawVis - filtered.r ), 0.2 );
		histWrite = vec3( filtered.r, raw.g, histAge );
		varWrite = vec3( variance, alpha, rejectReason );
	} else {
		/* Specular channel — SHR (shsMode==2): reject on motion/normal/source/age. */
		vec3 rawRgb = raw.rgb;
		vec3 histRgb = rawRgb;
		vec3 variance = vec3( 0.0 );
		float alpha = pc.params.y;
		float rawHit = ( raw.a >= 0.5 ) ? 1.0 : 0.0;
		float histAge = 0.0;

		if ( pc.firstFrame != 0u ) {
			rejectReason = 1.0;
		} else {
			vec2 histUv = hybrid1_historyUV( pc.invViewProj, pc.prevViewProj, uv, depth, motionTex, pc.useMotion );
			if ( histUv.x < 0.0 || histUv.x > 1.0 || histUv.y < 0.0 || histUv.y > 1.0 ) {
				rejectReason = 2.0;
			} else if ( pc.useMotion != 0u ) {
				vec2 motion = texture( motionTex, uv ).rg;
				if ( any( isnan( motion ) ) || any( isinf( motion ) ) || length( motion ) > 0.35 ) {
					rejectReason = 3.0;
				}
			}

			if ( rejectReason < 0.5 ) {
				vec4 histSample = texture( historyTex, histUv );
				histRgb = histSample.rgb;
				variance = texture( varianceHistTex, histUv ).rgb;
				histAge = variance.g;

				if ( pc.shsMode == 2u ) {
					vec3 N = hybrid1_decodeNormal( normalTex, uv, pc.hasGBuffer );
					vec3 Nh = hybrid1_decodeNormal( normalTex, histUv, pc.hasGBuffer );
					if ( dot( N, Nh ) < pc.shs.z ) {
						rejectReason = 4.0;
					}
					float histHit = ( histSample.a >= 0.5 ) ? 1.0 : 0.0;
					if ( rejectReason < 0.5 && abs( rawHit - histHit ) > 0.5 ) {
						rejectReason = 5.0; /* hit ↔ miss/probe transition */
					}
					if ( rejectReason < 0.5 && histAge >= pc.shs.x ) {
						rejectReason = 6.0;
					}
				}

				if ( rejectReason < 0.5 && pc.params.z > 0.5 ) {
					vec3 mn;
					vec3 mx;
					vec3 mean;
					vec3 varN;
					hybrid1_varianceColorClamp3( rawTex, uv, texel, pc.params.x, mn, mx, mean, varN );
					histRgb = hybrid1_clampVec3( histRgb, mn, mx );
				}
			}
		}

		if ( rejectReason > 0.5 ) {
			histRgb = rawRgb;
			histAge = 0.0;
			alpha = 1.0;
		} else if ( pc.shsMode == 2u ) {
			histAge = min( histAge + 1.0, pc.shs.x );
			float ageFade = 1.0 - clamp( histAge / max( pc.shs.x, 1.0 ), 0.0, 0.75 );
			alpha = max( alpha, mix( alpha, 1.0, ageFade * 0.35 ) );
		}

		filtered = mix( histRgb, rawRgb, alpha );
		variance = mix( variance, ( rawRgb - filtered ) * ( rawRgb - filtered ), vec3( 0.2 ) );
		histWrite = filtered;
		if ( pc.shsMode == 2u ) {
			/* variance: R=luma var, G=age, B=reject (matches shadow debug layout) */
			varWrite = vec3( length( variance ), histAge, rejectReason );
		} else {
			varWrite = variance;
		}
	}

	imageStore( filteredOut, ivec2( pix ), vec4( filtered, raw.a ) );
	imageStore( historyOut, ivec2( pix ), vec4( histWrite, raw.a ) );
	imageStore( varianceOut, ivec2( pix ), vec4( varWrite, 1.0 ) );
}
