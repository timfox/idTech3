#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;

#include "av_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D avIn;
layout(set = 0, binding = 1) uniform sampler2D auxIn;
layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3) uniform sampler2D normalTex;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D avOut;

layout(push_constant) uniform FilterPush {
	uvec4 extentFlags;       /* xy extent, z normalsAreWorld, w enabled */
	mat4 invView;
	vec4 params;             /* relative depth sharpness, normal power, hit sigma, radius */
	vec4 projInfo;           /* invProj00, invProj11, proj10, proj14 — for view-depth */
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(pix, pc.extentFlags.xy))) return;
	ivec2 ip = ivec2(pix);
	vec2 traceExtent = vec2(max(pc.extentFlags.xy, uvec2(1u)));
	vec2 uv = (vec2(ip) + 0.5) / traceExtent;
	vec4 center = texelFetch(avIn, ip, 0);
	if (pc.extentFlags.w == 0u) {
		imageStore(avOut, ip, center);
		return;
	}
	/*
	 * avIn/auxIn are trace-resolution images, but depthTex and normalTex are
	 * full-resolution G-buffer resources.  Integer-fetching all of them with
	 * ip aliases a half-resolution AV pixel to the wrong full-resolution
	 * screen location.  Address full-resolution guidance through normalized
	 * texel-center UVs derived from the trace extent.
	 */
	float centerDepth = textureLod(depthTex, uv, 0.0).r;
	float centerView = av_positive_view_depth(centerDepth, pc.projInfo);
	vec3 centerN = av_world_normal(textureLod(normalTex, uv, 0.0).xyz,
		pc.extentFlags.z, pc.invView);
	vec4 centerAux = texelFetch(auxIn, ip, 0);
	float centerHit = centerAux.r;
	float variance = centerAux.y;
	int radius = int(clamp(pc.params.w + sqrt(max(variance, 0.0)) * 4.0, 1.0, 3.0));
	ivec2 tmax = ivec2(int(pc.extentFlags.x) - 1, int(pc.extentFlags.y) - 1);
	float visSum = 0.0, coneSum = 0.0, weightSum = 0.0;
	vec3 bentSum = vec3(0.0);
	float depthSharp = max(pc.params.x, 1.0);
	for (int y = -3; y <= 3; ++y) for (int x = -3; x <= 3; ++x) {
		if (abs(x) > radius || abs(y) > radius) continue;
		ivec2 sp = clamp(ip + ivec2(x, y), ivec2(0), tmax);
		vec2 suv = (vec2(sp) + 0.5) / traceExtent;
		vec4 s = texelFetch(avIn, sp, 0);
		float sd = textureLod(depthTex, suv, 0.0).r;
		float sv = av_positive_view_depth(sd, pc.projInfo);
		vec3 sn = av_world_normal(textureLod(normalTex, suv, 0.0).xyz,
			pc.extentFlags.z, pc.invView);
		float sh = texelFetch(auxIn, sp, 0).r;
		float spatial = exp2(-0.5 * float(x * x + y * y));
		float depthW = av_bilateral_depth_weight(centerView, sv, depthSharp);
		float normalW = pow(max(dot(centerN, sn), 0.0), pc.params.y);
		float hitW = exp2(-abs(sh - centerHit) * pc.params.z);
		float w = spatial * depthW * normalW * hitW;
		visSum += s.r * w;
		bentSum += av_oct_decode(s.gb) * w;
		coneSum += s.a * w;
		weightSum += w;
	}
	/* Zero-weight fallback: keep the center sample (do not invent neighbors). */
	if (weightSum < 1e-5) {
		imageStore(avOut, ip, center);
		return;
	}
	vec3 bent = av_safe_normalize(bentSum, av_oct_decode(center.gb));
	imageStore(avOut, ip, vec4(visSum / weightSum, av_oct_encode(bent),
		coneSum / weightSum));
}
