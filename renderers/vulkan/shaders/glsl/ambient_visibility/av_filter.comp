#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;

#include "av_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D avIn;
layout(set = 0, binding = 1) uniform sampler2D auxIn;
layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3) uniform sampler2D normalTex;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D avOut;

layout(push_constant) uniform FilterPush {
	uvec4 extentFlags;       /* xy extent, z normalsAreWorld, w enabled */
	mat4 invView;
	vec4 params;             /* depth sigma, normal power, hit sigma, radius */
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(pix, pc.extentFlags.xy))) return;
	ivec2 ip = ivec2(pix);
	vec2 uv = (vec2(pix) + 0.5) / vec2(pc.extentFlags.xy);
	vec4 center = textureLod(avIn, uv, 0.0);
	if (pc.extentFlags.w == 0u) {
		imageStore(avOut, ip, center);
		return;
	}
	float centerDepth = textureLod(depthTex, uv, 0.0).r;
	vec3 centerN = av_world_normal(textureLod(normalTex, uv, 0.0).xyz,
		pc.extentFlags.z, pc.invView);
	float centerHit = textureLod(auxIn, uv, 0.0).r;
	float variance = textureLod(auxIn, uv, 0.0).y;
	int radius = int(clamp(pc.params.w + sqrt(max(variance, 0.0)) * 4.0, 1.0, 3.0));
	vec2 texel = 1.0 / vec2(pc.extentFlags.xy);
	float visSum = 0.0, coneSum = 0.0, weightSum = 0.0;
	vec3 bentSum = vec3(0.0);
	for (int y = -3; y <= 3; ++y) for (int x = -3; x <= 3; ++x) {
		if (abs(x) > radius || abs(y) > radius) continue;
		vec2 suv = clamp(uv + vec2(x, y) * texel, vec2(0.0), vec2(1.0));
		vec4 s = textureLod(avIn, suv, 0.0);
		float sd = textureLod(depthTex, suv, 0.0).r;
		vec3 sn = av_world_normal(textureLod(normalTex, suv, 0.0).xyz,
			pc.extentFlags.z, pc.invView);
		float sh = textureLod(auxIn, suv, 0.0).r;
		float spatial = exp2(-0.5 * float(x * x + y * y));
		float depthW = exp2(-abs(sd - centerDepth) * pc.params.x);
		float normalW = pow(max(dot(centerN, sn), 0.0), pc.params.y);
		float hitW = exp2(-abs(sh - centerHit) * pc.params.z);
		float w = spatial * depthW * normalW * hitW;
		visSum += s.r * w;
		bentSum += av_oct_decode(s.gb) * w;
		coneSum += s.a * w;
		weightSum += w;
	}
	vec3 bent = av_safe_normalize(bentSum, av_oct_decode(center.gb));
	imageStore(avOut, ip, vec4(visSum / max(weightSum, 1e-5), av_oct_encode(bent),
		coneSum / max(weightSum, 1e-5)));
}
