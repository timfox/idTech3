#version 450

/*
 * Arc Blanc — velocity frequency field at depth y (Algis eq. 22).
 */
layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

layout( std430, set = 0, binding = 0 ) readonly buffer H0SSBO {
	vec2 h0[];
} h0Buf;

layout( std430, set = 0, binding = 1 ) readonly buffer H0ConjSSBO {
	vec2 h0conj[];
} h0conjBuf;

layout( std430, set = 0, binding = 2 ) readonly buffer OmegaSSBO {
	float omega[];
} omegaBuf;

layout( std430, set = 0, binding = 3 ) readonly buffer KMagSSBO {
	float kMag[];
} kMagBuf;

layout( std430, set = 0, binding = 4 ) buffer OutVxSSBO {
	vec2 outVx[];
} outVx;

layout( std430, set = 0, binding = 5 ) buffer OutVySSBO {
	vec2 outVy[];
} outVy;

layout( std430, set = 0, binding = 6 ) buffer OutVzSSBO {
	vec2 outVz[];
} outVz;

layout( push_constant ) uniform Push {
	uint gridN;
	float time;
	float tileLength;
	float depthY;
} pc;

const float GRAVITY = 9.80665;
const float PI = 3.141592653589793;

float attenuation( float kmag, float y ) {
	if ( y > 0.0 ) {
		return 1.0 + kmag * y;
	}
	return exp( kmag * y );
}

void main() {
	uvec2 gid = gl_GlobalInvocationID.xy;
	uint n = pc.gridN;
	uint i;

	if ( gid.x >= n || gid.y >= n ) {
		return;
	}

	i = gid.y * n + gid.x;
	{
		int ix = int( gid.x );
		int iz = int( gid.y );
		int nHalf = int( n >> 1u );
		float invL = 1.0 / pc.tileLength;
		float kx = 2.0 * PI * float( ix - nHalf ) * invL;
		float kz = 2.0 * PI * float( iz - nHalf ) * invL;
		float w = omegaBuf.omega[i];
		float kmag = kMagBuf.kMag[i];
		float att = attenuation( kmag, pc.depthY );
		float invW = ( w > 1.0e-8 ) ? ( 1.0 / w ) : 0.0;
		float cw = cos( w * pc.time );
		float sw = sin( w * pc.time );
		vec2 h0v = h0Buf.h0[i];
		vec2 h0c = h0conjBuf.h0conj[i];
		vec2 a = vec2(
			h0v.x * cw - h0v.y * sw,
			h0v.x * sw + h0v.y * cw
		);
		vec2 b = vec2(
			h0c.x * cw + h0c.y * sw,
			-h0c.x * sw + h0c.y * cw
		);
		vec2 drive = vec2( a.x - b.x, a.y - b.y );
		float scaleX = att * ( -kx * GRAVITY * invW );
		float scaleZ = att * ( -kz * GRAVITY * invW );

		outVx.outVx[i] = drive * scaleX;
		outVz.outVz[i] = drive * scaleZ;
		outVy.outVy[i] = vec2( att * w * ( -drive.y ), att * w * drive.x );
	}
}
