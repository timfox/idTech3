#version 450
/* Add decoded neural irradiance * albedo into scene color (G-buffer path). */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D albedoTex;
layout(set = 0, binding = 2) uniform sampler2D irradianceTex;
layout(set = 0, binding = 3) uniform sampler2D normalTex;
layout(set = 0, binding = 4) uniform sampler2D aoTex;
layout(rgba16f, set = 0, binding = 5) uniform image2D colorOut;

layout(push_constant) uniform NivCompositePush {
	uvec2 extent;
	float strength;
	uint skipSky;
	float normalAtten;
	float aoStrength;
	uint hasNormal;
	uint hasAO;
} pc;

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (pix.x >= pc.extent.x || pix.y >= pc.extent.y) {
		return;
	}

	vec2 uv = (vec2(pix) + 0.5) / vec2(pc.extent);
	float depth = texture(depthTex, uv).r;
	if (pc.skipSky != 0u && (depth <= 0.0 || depth >= 1.0)) {
		return;
	}

	vec3 albedo = texture(albedoTex, uv).rgb;
	vec3 irr = texture(irradianceTex, uv).rgb;
	float weight = 1.0;
	if (pc.hasNormal != 0u && pc.normalAtten > 0.0) {
		vec3 n = texture(normalTex, uv).xyz * 2.0 - 1.0;
		float confidence = smoothstep(0.05, 0.35, length(n));
		vec3 nn = normalize(n + vec3(0.0, 0.0, 1e-4));
		float facing = clamp(nn.z * 0.5 + 0.5, 0.0, 1.0);
		weight *= mix(1.0, mix(0.35, 1.0, facing) * confidence, clamp(pc.normalAtten, 0.0, 1.0));
	}
	if (pc.hasAO != 0u && pc.aoStrength > 0.0) {
		float ao = clamp(texture(aoTex, uv).r, 0.0, 1.0);
		weight *= mix(1.0, ao, clamp(pc.aoStrength, 0.0, 1.0));
	}
	vec3 gi = irr * albedo * pc.strength * weight;
	vec4 cur = imageLoad(colorOut, ivec2(pix));
	imageStore(colorOut, ivec2(pix), vec4(cur.rgb + gi, cur.a));
}
