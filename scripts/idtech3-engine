#!/usr/bin/env bash
# Friendly project front-end for the idTech3 Engine SDK.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${IDTECH3_SDK_ROOT:-}" ]]; then
  SDK_ROOT="$IDTECH3_SDK_ROOT"
elif [[ -f "$SELF_DIR/create_starter_game.sh" ]]; then
  SDK_ROOT="$(cd "$SELF_DIR/.." && pwd)"
else
  SDK_ROOT="$(cd "$SELF_DIR/../share/idtech3/sdk" 2>/dev/null && pwd || true)"
fi
ENGINE_DIR="${IDTECH3_ENGINE_DIR:-$SELF_DIR}"

die() { echo "idtech3-engine: $*" >&2; exit 1; }
project_dir() {
  local path="${1:-.}"
  [[ -d "$path" ]] || die "project directory not found: $path"
  (cd "$path" && pwd)
}
project_ident() {
  python3 - "$1/game.idproj" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
if not p.is_file():
    raise SystemExit(f"idtech3-engine: not a project (missing {p})")
print(json.loads(p.read_text(encoding="utf-8"))["Ident"])
PY
}
usage() {
  cat <<'EOF'
idtech3-engine - the idTech3 game-development front end

Usage:
  idtech3-engine new <name> [directory]  Create a ready-to-run game project
  idtech3-engine run [project] [args...] Run a project with live script reload
  idtech3-engine editor [project]        Run the project with Studio tools open
  idtech3-engine vr [project] [args...]  Run with headset tracking and stereo
  idtech3-engine package [project]       Validate and create the project's pk3
  idtech3-engine doctor                  Check the installation and host tools
  idtech3-engine help                    Show this help

Environment: IDTECH3_ENGINE_DIR overrides the binary directory and
IDTECH3_SDK_ROOT overrides the installed SDK support directory.
EOF
}

command="${1:-help}"; shift || true
case "$command" in
  new)
    name="${1:-}"; [[ -n "$name" ]] || die "new requires a project name"
    [[ "$name" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] || die "name must begin with a letter and contain only letters, numbers, _ or -"
    out="${2:-$PWD/$name}"
    [[ -x "$SDK_ROOT/scripts/create_starter_game.sh" ]] || die "SDK files not found (set IDTECH3_SDK_ROOT)"
    "$SDK_ROOT/scripts/create_starter_game.sh" "$name" "$out" "$ENGINE_DIR"
    ;;
  run|editor|vr)
    project="$(project_dir "${1:-.}")"; [[ $# -eq 0 ]] || shift
    ident="$(project_ident "$project")"
    engine="${IDTECH3_ENGINE_BIN:-$ENGINE_DIR/idtech3}"
    [[ -x "$engine" ]] || die "client binary not found: $engine"
    args=(+set fs_basepath "$(dirname "$project")" +set fs_game "$ident" +set com_scriptWatch 1)
    [[ "$command" == editor ]] && args+=(+set r_studio_tools 1)
    # UX credit: Trinity VR makes headset play a first-class launch target rather
    # than requiring authors to remember a collection of console variables.
    [[ "$command" == vr ]] && args+=(+set vr_openhmd 1 +set vr_openhmdStereo 1)
    exec "$engine" "${args[@]}" "$@"
    ;;
  package)
    project="$(project_dir "${1:-.}")"
    [[ -x "$project/pack_game.sh" ]] || die "project has no pack_game.sh"
    (cd "$project" && exec ./pack_game.sh "${@:2}")
    ;;
  doctor)
    failures=0
    check() { if "$@" >/dev/null 2>&1; then printf '  [OK] %s\n' "$*"; else printf '  [MISSING] %s\n' "$*"; failures=$((failures + 1)); fi; }
    echo "idTech3 engine SDK diagnostics"
    check test -x "$ENGINE_DIR/idtech3"
    check test -x "$ENGINE_DIR/idtech3_server"
    check test -f "$ENGINE_DIR/idtech3_vulkan.so"
    check command -v python3
    check command -v zip
    echo "  SDK: $SDK_ROOT"
    [[ $failures -eq 0 ]] || die "$failures required component(s) missing"
    ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$command' (try: idtech3-engine help)" ;;
esac
