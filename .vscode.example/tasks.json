{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_release_vulkan",
            "type": "shell",
            "command": "./scripts/compile_engine.sh",
            "args": ["vulkan"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "gcc",
                    "fileLocation": "relative",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "build_debug_opengl",
            "type": "shell",
            "command": "./scripts/compile_engine.sh",
            "args": ["opengl", "debug"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "gcc",
                    "fileLocation": "relative",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "build_release_full",
            "type": "shell",
            "command": "./scripts/compile_both.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "format_changed_files",
            "type": "shell",
            "command": "git",
            "args": [
                "diff",
                "--name-only",
                "HEAD~1",
                "--",
                "*.c",
                "*.cpp",
                "*.h",
                "*.hpp"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "format_all_changed_files",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "git diff --name-only HEAD~1 -- '*.c' '*.cpp' '*.h' '*.hpp' | xargs -r clang-format -i && echo '✅ Formatted changed C/C++ files'"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "run_clang_tidy_changed",
            "type": "shell",
            "command": "./scripts/run_clang_tidy.sh",
            "args": ["--changed-only"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "clang-tidy",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note|info):\\s+(.*)\\s+\\[([^\\]]+)\\]$",
                            "file": 1,
                            "line": 2,
                            "column": 3,
                            "severity": 4,
                            "message": 5,
                            "code": 6
                        }
                    ]
                }
            ]
        },
        {
            "label": "run_cppcheck",
            "type": "shell",
            "command": "./scripts/run_cppcheck.sh",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "cppcheck",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^(.*):(\\d+):\\s+(warning|error|style|performance|portability|information):\\s+(.*)$",
                            "file": 1,
                            "line": 2,
                            "column": 3,
                            "severity": 4,
                            "message": 5
                        }
                    ]
                }
            ]
        },
