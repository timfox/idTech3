<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Phase 5d: shared 2026 layout roots (bridge symlinks under engine/platform/). -->
  <PropertyGroup Label="IdTech3Layout2026">
    <IdTech3RepoRoot>$(MSBuildThisFileDirectory)..\..\..\..</IdTech3RepoRoot>
    <IdTech3EngineRoot>$(IdTech3RepoRoot)\engine</IdTech3EngineRoot>
    <IdTech3EngineCore>$(IdTech3RepoRoot)\engine\core</IdTech3EngineCore>
    <IdTech3RuntimeClient>$(IdTech3RepoRoot)\runtime\client</IdTech3RuntimeClient>
    <IdTech3RuntimeClientPlatform>$(IdTech3RuntimeClient)\platform</IdTech3RuntimeClientPlatform>
    <IdTech3RuntimeClientCore>$(IdTech3RuntimeClient)\core</IdTech3RuntimeClientCore>
    <IdTech3RuntimeClientWorld>$(IdTech3RuntimeClient)\world</IdTech3RuntimeClientWorld>
    <IdTech3RuntimeClientMedia>$(IdTech3RuntimeClient)\media</IdTech3RuntimeClientMedia>
    <IdTech3RuntimeGame>$(IdTech3RepoRoot)\runtime\game</IdTech3RuntimeGame>
    <IdTech3ThirdParty>$(IdTech3RepoRoot)\third_party</IdTech3ThirdParty>
    <IdTech3ExtensionsResearch>$(IdTech3RepoRoot)\extensions\research</IdTech3ExtensionsResearch>
    <IdTech3ExtensionsGenerative>$(IdTech3RepoRoot)\extensions\generative</IdTech3ExtensionsGenerative>
    <!-- Prefer canonical third_party (not the platform/external bridge): Windows link.exe
         does not reliably follow Unix symlinks, and layout_forwarding_windows.ps1 historically
         only junctioned engine\external. -->
    <ExternalRoot>$(IdTech3ThirdParty)</ExternalRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(IdTech3EngineRoot);$(IdTech3EngineCore);$(IdTech3RuntimeClient);$(IdTech3RuntimeClientPlatform);$(IdTech3RuntimeClientCore);$(IdTech3RuntimeClientWorld);$(IdTech3RuntimeClientMedia);$(IdTech3RuntimeGame);$(IdTech3ExtensionsResearch);$(IdTech3ExtensionsGenerative);$(ExternalRoot)\include\entt\single_include;$(ExternalRoot)\src\jpeg;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
