#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

// Two-pass motion blur: first pass computes velocity tiles, second pass applies blur
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D colorBuffer;
layout(set = 0, binding = 1) uniform sampler2D velocityBuffer;
layout(set = 0, binding = 2) uniform sampler2D depthBuffer;
layout(set = 0, binding = 3) uniform sampler2D velocityTiles; // Pre-computed velocity tiles

layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outputImage;

layout(push_constant) uniform MotionBlurConstants {
    vec2 resolution;
    vec2 invResolution;
    int numSamples;
    float exposureTime; // Shutter speed (0.0-1.0)
    int useVelocityTiles; // 0=traditional, 1=velocity tiles
    vec2 tileSize; // Size of velocity tiles
    vec2 invTileSize;
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y)) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;
    vec3 color = texture(colorBuffer, uv).rgb;

    if (pc.useVelocityTiles > 0) {
        // Velocity tiles motion blur - more efficient and stable

        // Determine which tile this pixel belongs to
        ivec2 tileCoord = ivec2(floor(vec2(pixel) / pc.tileSize));
        vec2 tileUV = (vec2(tileCoord) + 0.5) * pc.invTileSize;

        // Sample the maximum velocity for this tile
        vec2 maxVelocity = texture(velocityTiles, tileUV).xy * pc.exposureTime;
        float velocityMagnitude = length(maxVelocity);

        // Skip if no motion in this tile
        if (velocityMagnitude < 0.001) {
            imageStore(outputImage, pixel, vec4(color, 1.0));
            return;
        }

        // Sample along the tile's maximum velocity vector
        vec3 blurredColor = vec3(0.0);
        float totalWeight = 0.0;

        int samples = min(pc.numSamples, 12); // Fewer samples for tiles
        for (int i = 0; i < samples; i++) {
            float t = (float(i) / float(samples - 1)) - 0.5;
            vec2 sampleUV = uv + maxVelocity * t;

            // Clamp to valid range
            sampleUV = clamp(sampleUV, vec2(0.0), vec2(1.0));

            vec3 sampleColor = texture(colorBuffer, sampleUV).rgb;

            // Weight by distance from center (gaussian-like)
            float weight = 1.0 - abs(t) * 2.0;
            weight = max(0.0, weight);

            // Additional weight based on depth similarity (reduce bleeding)
            float depthDiff = abs(texture(depthBuffer, sampleUV).r - texture(depthBuffer, uv).r);
            weight *= exp(-depthDiff * 10.0);

            blurredColor += sampleColor * weight;
            totalWeight += weight;
        }

        if (totalWeight > 0.001) {
            color = blurredColor / totalWeight;
        }
    } else {
        // Traditional motion blur

        // Sample velocity
        vec2 velocity = texture(velocityBuffer, uv).xy * pc.exposureTime;
        float velocityMagnitude = length(velocity);

        // Skip if no motion
        if (velocityMagnitude < 0.001) {
            imageStore(outputImage, pixel, vec4(color, 1.0));
            return;
        }

        // Sample along motion vector
        vec3 blurredColor = vec3(0.0);
        float totalWeight = 0.0;

        int samples = min(pc.numSamples, 16);
        for (int i = 0; i < samples; i++) {
            float t = (float(i) / float(samples - 1)) - 0.5;
            vec2 sampleUV = uv + velocity * t;

            // Clamp to valid range
            if (sampleUV.x >= 0.0 && sampleUV.x <= 1.0 && sampleUV.y >= 0.0 && sampleUV.y <= 1.0) {
                vec3 sampleColor = texture(colorBuffer, sampleUV).rgb;

                // Weight by distance from center (gaussian-like)
                float weight = 1.0 - abs(t) * 2.0;
                weight = max(0.0, weight);

                blurredColor += sampleColor * weight;
                totalWeight += weight;
            }
        }

        // Normalize
        if (totalWeight > 0.001) {
            color = blurredColor / totalWeight;
        }
    }

    imageStore(outputImage, pixel, vec4(color, 1.0));
}

