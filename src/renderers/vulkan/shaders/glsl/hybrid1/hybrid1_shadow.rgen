#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#include "hybrid1_ubo.glsl"

layout( location = 0 ) rayPayloadEXT float shadowVis;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT topLevelAS;
layout( rgba16f, set = 0, binding = 1 ) uniform writeonly image2D shadowOut;

layout( set = 0, binding = 3 ) uniform sampler2D depthTex;
layout( set = 0, binding = 4 ) uniform sampler2D normalTex;
layout( set = 0, binding = 5 ) uniform sampler2D materialTex;

void main()
{
	vec2 extent = max( h1.outputSize.xy, vec2( 1.0 ) );
	vec2 uv = ( vec2( gl_LaunchIDEXT.xy ) + vec2( 0.5 ) ) / extent;
	float depth = textureLod( depthTex, uv, 0.0 ).r;

	if ( depth <= 0.0 || depth >= 1.0 ) {
		imageStore( shadowOut, ivec2( gl_LaunchIDEXT.xy ), vec4( 1.0, 0.0, 0.0, 1.0 ) );
		return;
	}

	vec4 clip = vec4( uv * 2.0 - 1.0, depth, 1.0 );
	vec4 worldPos4 = h1.invViewProj * clip;
	worldPos4 /= max( abs( worldPos4.w ), 1e-6 );
	vec3 worldPos = worldPos4.xyz;

	vec3 N = vec3( 0.0, 0.0, 1.0 );
	if ( h1.params1.z > 0.5 ) {
		N = textureLod( normalTex, uv, 0.0 ).xyz * 2.0 - 1.0;
		float nLen = length( N );
		if ( nLen > 0.01 ) {
			N /= nLen;
		}
	}

	vec3 L = normalize( h1.sunDirection.xyz );
	float shadowAngle = degrees( acos( clamp( dot( N, L ), -1.0, 1.0 ) ) );

	vec3 ro = worldPos + N * 0.02;
	vec3 rd = L;

	shadowVis = 1.0;
	traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, 0.01, rd, 1.0e5, 0 );

	imageStore( shadowOut, ivec2( gl_LaunchIDEXT.xy ), vec4( shadowVis, shadowAngle, 0.0, 1.0 ) );
}
