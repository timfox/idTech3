#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

layout(push_constant) uniform ChromaticAberrationConstants {
    vec2 resolution;
    vec2 invResolution;
    vec2 center; // Center point for aberration (0.5, 0.5 = screen center)
    float strength; // Aberration strength
    float radialScale; // Radial falloff
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y)) {
        return;
    }
    
    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;
    
    // Calculate radial distance from center
    vec2 dir = uv - pc.center;
    float dist = length(dir);
    vec2 normalizedDir = normalize(dir);
    
    // Calculate aberration offset
    float aberration = dist * pc.strength * pc.radialScale;
    
    // Sample RGB channels with different offsets
    vec2 offsetR = normalizedDir * aberration * 1.0;
    vec2 offsetG = normalizedDir * aberration * 0.0; // Green channel stays centered
    vec2 offsetB = normalizedDir * aberration * -1.0;
    
    float r = texture(inputImage, uv + offsetR).r;
    float g = texture(inputImage, uv + offsetG).g;
    float b = texture(inputImage, uv + offsetB).b;
    
    vec3 color = vec3(r, g, b);
    
    imageStore(outputImage, pixel, vec4(color, 1.0));
}

