#version 450
/* Clear per-tile splat counts (WebGPU: simple 1D dispatch). */
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer TileCounts {
	uint counts[];
} tileCounts;

layout(push_constant) uniform WspClearPush {
	int tileCount;
	int pad0;
	int pad1;
	int pad2;
} pc;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if ( int(i) >= pc.tileCount ) {
		return;
	}
	tileCounts.counts[i] = 0u;
}
