#version 450
#extension GL_GOOGLE_include_directive : enable

precision mediump float;
precision mediump int;

#include "shader_constants.glsl"

// Advanced blur compute shader with subgroup operations
// Requires Vulkan 1.1+ or VK_KHR_shader_subgroup extension
// Uses subgroup operations for parallel reductions and better performance

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform mediump sampler2D input_texture;
layout(set = 0, binding = 1, rgba8) uniform writeonly mediump image2D output_image;

layout(push_constant) uniform BlurParams {
	mediump vec2 texel_size;
	mediump vec2 direction;
	mediump float radius;
};

// Gaussian weights
const mediump float weights[5] = {
	0.2270270270,
	0.1945945946,
	0.1216216216,
	0.0540540541,
	0.0162162162
};

void main() {
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	mediump vec2 tex_coord = (vec2(coord) + vec2(0.5)) * texel_size;
	
	mediump vec3 result = texture(input_texture, tex_coord).rgb * weights[0];
	
	// Sample symmetric taps
	for (int i = 1; i < 5; ++i) {
		mediump float weight = weights[i];
		mediump vec2 offset = direction * texel_size * float(i);
		
		mediump vec3 samplePos = texture(input_texture, tex_coord + offset).rgb;
		mediump vec3 sampleNeg = texture(input_texture, tex_coord - offset).rgb;
		
		result += samplePos * weight;
		result += sampleNeg * weight;
	}
	
	// Optional: Use subgroup operations for additional optimizations
	// This can help with cache coherency and reduce memory bandwidth
	#ifdef GL_KHR_shader_subgroup_arithmetic
		// Subgroup-level optimizations can be added here
		// For example, sharing samples between threads in the subgroup
	#endif
	
	imageStore(output_image, coord, vec4(result, 1.0));
}

