#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#include "raygun_common.glsl"

layout( location = 0 ) rayPayloadEXT vec3 primaryColor;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT topLevelAS;
layout( set = 0, binding = 1, rgba16f ) uniform writeonly image2D outImage;
layout( set = 0, binding = 3 ) uniform sampler2D depthTex;

vec2 rgSampleOffset( int index )
{
	switch ( index & 3 ) {
		case 0: return vec2( 0.5, 0.5 );
		case 1: return vec2( 0.25, 0.75 );
		case 2: return vec2( 0.75, 0.25 );
		default: return vec2( 0.125, 0.375 );
	}
}

vec3 rgTracePrimary( vec2 uv )
{
	float d = textureLod( depthTex, uv, 0.0 ).r;
	vec3 ro = rg.viewOrigin.xyz;
	vec3 rd;

	if ( d <= 0.0 || d >= 1.0 ) {
		vec4 farClip = vec4( uv * 2.0 - 1.0, 0.0, 1.0 );
		vec4 farW = rg.invViewProj * farClip;
		farW /= max( abs( farW.w ), 1e-6 );
		rd = normalize( farW.xyz - ro );
	} else {
		vec4 clip = vec4( uv * 2.0 - 1.0, d, 1.0 );
		vec4 worldPos = rg.invViewProj * clip;
		worldPos /= max( abs( worldPos.w ), 1e-6 );
		rd = normalize( worldPos.xyz - ro );
	}

	primaryColor = vec3( 0.0 );
	traceRayEXT( topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, 0u, 0u, 0u, ro, 0.01, rd, 1.0e5, 0 );
	return primaryColor;
}

void main()
{
	vec2 extent = max( rg.outputSize.xy, vec2( 1.0 ) );
	int sampleCount = int( clamp( rg.traceParams.x, 1.0, 4.0 ) );
	vec3 accum = vec3( 0.0 );

	for ( int i = 0; i < sampleCount; ++i ) {
		vec2 uv = ( vec2( gl_LaunchIDEXT.xy ) + rgSampleOffset( i ) ) / extent;
		accum += rgTracePrimary( uv );
	}

	vec3 color = accum / float( sampleCount );
	imageStore( outImage, ivec2( gl_LaunchIDEXT.xy ), vec4( color, 1.0 ) );
}
