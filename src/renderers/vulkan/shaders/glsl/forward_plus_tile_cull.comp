#version 450

/*
 * Forward+ scaffolding: per-tile light index list (max 8 per tile; tile pixel size = viewport / tileGrid).
 * CPU-packed lights: binding 0 — vec4 (x=count,...), vec4 (tiles_x, tiles_y, viewport_w, viewport_h), then count * 4 vec4 records.
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define MAX_PER_TILE 8u
#define MAX_LIGHTS 32u
#define REC_VEC4S 4u

layout(std430, set = 0, binding = 0) readonly buffer LightSSBO {
	vec4 data[];
} lights;

layout(std430, set = 0, binding = 1) buffer TileSSBO {
	uint cells[];
} tiles;

layout(std430, set = 0, binding = 2) readonly buffer ParamSSBO {
	mat4 clipFromWorld;
	uvec4 tiles_xy_viewport;
	vec4 viewOrg;
} params;

layout(push_constant) uniform Push {
	uvec2 tileGrid;
	uint totalTiles;
	uint numLights;
	uint maxPerTile;
	uint luminanceSort;
	uint distanceSort;
} pc;

bool sphere_tile_overlap(vec2 centerPx, float radiusPx, uint tileX, uint tileY, float tilePxX, float tilePxY) {
	float minX = float(tileX) * tilePxX;
	float minY = float(tileY) * tilePxY;
	float maxX = minX + tilePxX;
	float maxY = minY + tilePxY;
	vec2 closest = clamp(centerPx, vec2(minX, minY), vec2(maxX, maxY));
	return distance(centerPx, closest) <= radiusPx + 1e-3;
}

void main() {
	uint tileId = gl_GlobalInvocationID.x;
	if (tileId >= pc.totalTiles) {
		return;
	}

	uint tilesX = pc.tileGrid.x;
	uint tilesY = pc.tileGrid.y;
	uint tileX = tileId % tilesX;
	uint tileY = tileId / tilesX;

	uint base = tileId * MAX_PER_TILE;
	for (uint k = 0u; k < MAX_PER_TILE; k++) {
		tiles.cells[base + k] = 0xFFFFFFFFu;
	}

	uint n = uint(max(lights.data[0].x + 0.5, 0.0));
	n = min(n, min(pc.numLights, MAX_LIGHTS));

	uint cap = pc.maxPerTile;
	if (cap < 1u) {
		cap = MAX_PER_TILE;
	}
	cap = min(cap, MAX_PER_TILE);

	float vw = lights.data[1].z;
	float vh = lights.data[1].w;
	float tilePxX = vw / max(float(tilesX), 1.0);
	float tilePxY = vh / max(float(tilesY), 1.0);

	uint candLi[MAX_LIGHTS];
	float candLum[MAX_LIGHTS];
	float candDistSq[MAX_LIGHTS];
	uint candCount = 0u;
	vec3 viewOrg = params.viewOrg.xyz;

	for (uint li = 0u; li < n; li++) {
		uint b = 2u + li * REC_VEC4S;
		vec3 worldPos = lights.data[b].xyz;
		float radius = max(lights.data[b].w, 1e-4);

		vec4 clip = params.clipFromWorld * vec4(worldPos, 1.0);
		if (abs(clip.w) < 1e-5) {
			continue;
		}

		vec3 ndc = clip.xyz / clip.w;
		if (ndc.z < -1.0 || ndc.z > 1.0 || ndc.x < -1.2 || ndc.x > 1.2 || ndc.y < -1.2 || ndc.y > 1.2) {
			continue;
		}

		vec2 centerPx;
		centerPx.x = 0.5 * (1.0 + ndc.x) * vw;
		centerPx.y = 0.5 * (1.0 + ndc.y) * vh;

		float distW = max(abs(clip.w), 1e-3);
		float radiusPx = clamp(radius * (0.5 * vw) / distW, 2.0, vw + vh);

		if (!sphere_tile_overlap(centerPx, radiusPx, tileX, tileY, tilePxX, tilePxY)) {
			continue;
		}

		vec4 lc = lights.data[b + 1u];
		float lum = lc.x + lc.y + lc.z;

		candLi[candCount] = li;
		candLum[candCount] = lum;
		vec3 delta = worldPos - viewOrg;
		candDistSq[candCount] = dot(delta, delta);
		candCount++;
	}

	uint useCount = min(candCount, cap);

	if (pc.distanceSort != 0u && candCount > cap) {
		for (uint k = 0u; k < cap; k++) {
			uint bestJ = k;
			float bestVal = candDistSq[k];
			for (uint j = k + 1u; j < candCount; j++) {
				if (candDistSq[j] < bestVal) {
					bestVal = candDistSq[j];
					bestJ = j;
				}
			}
			if (bestJ != k) {
				uint tmpI = candLi[bestJ];
				float tmpL = candLum[bestJ];
				float tmpD = candDistSq[bestJ];
				candLi[bestJ] = candLi[k];
				candLum[bestJ] = candLum[k];
				candDistSq[bestJ] = candDistSq[k];
				candLi[k] = tmpI;
				candLum[k] = tmpL;
				candDistSq[k] = tmpD;
			}
		}
	} else if (pc.luminanceSort != 0u && candCount > cap) {
		for (uint k = 0u; k < cap; k++) {
			uint bestJ = k;
			float bestVal = candLum[k];
			for (uint j = k + 1u; j < candCount; j++) {
				if (candLum[j] > bestVal) {
					bestVal = candLum[j];
					bestJ = j;
				}
			}
			if (bestJ != k) {
				uint tmpI = candLi[bestJ];
				float tmpL = candLum[bestJ];
				float tmpD = candDistSq[bestJ];
				candLi[bestJ] = candLi[k];
				candLum[bestJ] = candLum[k];
				candDistSq[bestJ] = candDistSq[k];
				candLi[k] = tmpI;
				candLum[k] = tmpL;
				candDistSq[k] = tmpD;
			}
		}
	}

	for (uint k = 0u; k < useCount; k++) {
		tiles.cells[base + k] = candLi[k];
	}
}
