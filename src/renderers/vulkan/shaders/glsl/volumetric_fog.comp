#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthBuffer;
layout(set = 0, binding = 1) uniform sampler3D noiseTexture;

layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outputImage;

layout(push_constant) uniform VolumetricFogConstants {
    mat4 projectionMatrix;
    mat4 viewMatrix;
    mat4 invProjectionMatrix;
    mat4 invViewMatrix;
    vec2 resolution;
    vec2 invResolution;
    vec3 cameraPos;
    vec3 lightDir;
    vec3 lightColor;
    float lightIntensity;
    float fogDensity;
    float fogHeight;
    float fogFalloff;
    int numSamples;
    float scattering;
    float absorption;
} pc;

// Reconstruct world position from depth
vec3 reconstructPosition(vec2 uv, float depth)
{
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos = pc.invProjectionMatrix * clipPos;
    viewPos /= viewPos.w;
    vec4 worldPos = pc.invViewMatrix * viewPos;
    return worldPos.xyz;
}

// Calculate fog density at position
float fogDensityAt(vec3 pos)
{
    float height = pos.y;
    float density = pc.fogDensity;
    
    // Height-based falloff
    if (height > pc.fogHeight) {
        density *= exp(-(height - pc.fogHeight) * pc.fogFalloff);
    }
    
    // Sample noise for variation
    vec3 noiseUV = pos * 0.1 + vec3(pc.cameraPos.x * 0.01, 0.0, pc.cameraPos.z * 0.01);
    float noise = texture(noiseTexture, noiseUV).r;
    density *= 0.5 + noise * 0.5;
    
    return density;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y)) {
        return;
    }
    
    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;
    
    float depth = texture(depthBuffer, uv).r;
    if (depth >= 1.0) {
        imageStore(outputImage, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }
    
    vec3 rayStart = pc.cameraPos;
    vec3 rayEnd = reconstructPosition(uv, depth);
    vec3 rayDir = normalize(rayEnd - rayStart);
    float rayLength = length(rayEnd - rayStart);
    
    // Ray march through volume
    float stepSize = rayLength / float(pc.numSamples);
    vec3 step = rayDir * stepSize;
    
    vec3 transmittance = vec3(1.0);
    vec3 scatteringLight = vec3(0.0);
    
    vec3 currentPos = rayStart;
    
    for (int i = 0; i < pc.numSamples; i++) {
        currentPos += step;
        
        if (length(currentPos - rayStart) > rayLength) {
            break;
        }
        
        float density = fogDensityAt(currentPos);
        
        if (density > 0.001) {
            // Calculate transmittance
            float extinction = density * (pc.scattering + pc.absorption);
            vec3 stepTransmittance = vec3(exp(-extinction * stepSize));
            transmittance *= stepTransmittance;
            
            // Calculate scattering (simplified - would use phase function)
            float lightDot = dot(rayDir, pc.lightDir);
            float phase = 0.75 * (1.0 + lightDot * lightDot); // Henyey-Greenstein approximation
            
            vec3 scattering = density * pc.scattering * pc.lightColor * pc.lightIntensity * phase;
            scatteringLight += scattering * transmittance * stepSize;
        }
    }
    
    vec3 fogColor = scatteringLight;
    float fogAlpha = 1.0 - min(transmittance.r, min(transmittance.g, transmittance.b));
    
    imageStore(outputImage, pixel, vec4(fogColor, fogAlpha));
}

