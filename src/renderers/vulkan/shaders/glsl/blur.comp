#version 450
#extension GL_GOOGLE_include_directive : enable

precision mediump float;
precision mediump int;

#include "shader_constants.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform mediump sampler2D input_texture;
layout(set = 0, binding = 1, rgba8) uniform writeonly mediump image2D output_image;

layout(push_constant) uniform BlurParams {
	mediump vec2 texel_size;  // 1.0 / texture_size
	mediump vec2 direction;   // Blur direction (1,0) or (0,1) for gaussian
	mediump float radius;     // Blur radius
	mediump int use_kawase;   // 0=gaussian, 1=kawase
	mediump int iteration;    // Kawase iteration (0,1,2,3...)
};

// Gaussian weights for 5-tap blur
const mediump float weights[5] = {
	0.2270270270,  // Center
	0.1945945946,  // ±1
	0.1216216216,  // ±2
	0.0540540541,  // ±3
	0.0162162162   // ±4
};

void main() {
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	mediump vec2 tex_coord = (vec2(coord) + vec2(0.5)) * texel_size;

	mediump vec3 result;

	if (use_kawase > 0) {
		// Kawase blur - fast, high-quality blur for bloom
		// Each iteration increases the blur radius
		mediump float offset = float(iteration + 1);

		// Sample in diamond pattern: (0,±1), (±1,0), (±1,±1) scaled by offset
		mediump vec2 sample_uv[8];
		sample_uv[0] = tex_coord + vec2(0.0, -offset) * texel_size;
		sample_uv[1] = tex_coord + vec2(0.0, offset) * texel_size;
		sample_uv[2] = tex_coord + vec2(-offset, 0.0) * texel_size;
		sample_uv[3] = tex_coord + vec2(offset, 0.0) * texel_size;
		sample_uv[4] = tex_coord + vec2(-offset, -offset) * texel_size;
		sample_uv[5] = tex_coord + vec2(offset, -offset) * texel_size;
		sample_uv[6] = tex_coord + vec2(-offset, offset) * texel_size;
		sample_uv[7] = tex_coord + vec2(offset, offset) * texel_size;

		result = vec3(0.0);
		for (int i = 0; i < 8; ++i) {
			result += texture(input_texture, sample_uv[i]).rgb;
		}
		result *= 0.125; // Average of 8 samples
	} else {
		// Gaussian blur - traditional separable blur
		result = texture(input_texture, tex_coord).rgb * weights[0];

		// Sample symmetric taps
		for (int i = 1; i < 5; ++i) {
			mediump float weight = weights[i];
			mediump vec2 offset = direction * texel_size * float(i);

			result += texture(input_texture, tex_coord + offset).rgb * weight;
			result += texture(input_texture, tex_coord - offset).rgb * weight;
		}
	}

	imageStore(output_image, coord, vec4(result, 1.0));
}
