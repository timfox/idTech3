#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D colorBuffer;
layout(set = 0, binding = 1) uniform sampler2D normalBuffer;
layout(set = 0, binding = 2) uniform sampler2D depthBuffer;
layout(set = 0, binding = 3) uniform sampler2D blueNoise;

layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outputImage;

layout(push_constant) uniform SSRConstants {
    mat4 projectionMatrix;
    mat4 viewMatrix;
    mat4 invProjectionMatrix;
    mat4 invViewMatrix;
    vec2 resolution;
    vec2 invResolution;
    vec3 cameraPos;
    float maxDistance;
    float thickness;
    int numSteps;
    int numBinarySteps;
    float roughnessThreshold;
} pc;

// Reconstruct world position from depth
vec3 reconstructPosition(vec2 uv, float depth)
{
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos = pc.invProjectionMatrix * clipPos;
    viewPos /= viewPos.w;
    vec4 worldPos = pc.invViewMatrix * viewPos;
    return worldPos.xyz;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y)) {
        return;
    }
    
    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;
    
    float depth = texture(depthBuffer, uv).r;
    if (depth >= 1.0) {
        imageStore(outputImage, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }
    
    vec3 position = reconstructPosition(uv, depth);
    vec3 normal = normalize(texture(normalBuffer, uv).xyz * 2.0 - 1.0);
    vec3 viewDir = normalize(pc.cameraPos - position);
    
    // Calculate reflection direction
    vec3 reflectDir = reflect(-viewDir, normal);
    
    // Ray march in screen space
    vec3 rayStart = position;
    vec3 rayEnd = rayStart + reflectDir * pc.maxDistance;
    
    // Project to screen space
    vec4 rayStartClip = pc.projectionMatrix * pc.viewMatrix * vec4(rayStart, 1.0);
    rayStartClip /= rayStartClip.w;
    vec2 rayStartUV = rayStartClip.xy * 0.5 + 0.5;
    
    vec4 rayEndClip = pc.projectionMatrix * pc.viewMatrix * vec4(rayEnd, 1.0);
    rayEndClip /= rayEndClip.w;
    vec2 rayEndUV = rayEndClip.xy * 0.5 + 0.5;
    
    vec2 rayDirUV = rayEndUV - rayStartUV;
    float rayLengthUV = length(rayDirUV);
    vec2 rayStepUV = rayDirUV / float(pc.numSteps);
    
    vec3 reflectionColor = vec3(0.0);
    bool hit = false;
    
    // Ray march
    for (int i = 1; i <= pc.numSteps; i++) {
        vec2 sampleUV = rayStartUV + rayStepUV * float(i);
        
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {
            break;
        }
        
        float sampleDepth = texture(depthBuffer, sampleUV).r;
        vec3 samplePos = reconstructPosition(sampleUV, sampleDepth);
        
        // Calculate distance along ray
        float t = float(i) / float(pc.numSteps);
        vec3 currentPos = mix(rayStart, rayEnd, t);
        
        // Check intersection
        float depthDiff = length(currentPos - samplePos);
        
        if (depthDiff < pc.thickness) {
            // Binary search for better accuracy
            vec2 binaryStartUV = sampleUV - rayStepUV;
            vec2 binaryEndUV = sampleUV;
            
            for (int j = 0; j < pc.numBinarySteps; j++) {
                vec2 binaryUV = (binaryStartUV + binaryEndUV) * 0.5;
                float binaryDepth = texture(depthBuffer, binaryUV).r;
                vec3 binaryPos = reconstructPosition(binaryUV, binaryDepth);
                
                float binaryT = mix(float(i - 1), float(i), 0.5) / float(pc.numSteps);
                vec3 binaryRayPos = mix(rayStart, rayEnd, binaryT);
                
                if (length(binaryRayPos - binaryPos) < pc.thickness) {
                    binaryEndUV = binaryUV;
                } else {
                    binaryStartUV = binaryUV;
                }
            }
            
            reflectionColor = texture(colorBuffer, binaryEndUV).rgb;
            hit = true;
            break;
        }
    }
    
    // Fallback to sky if no hit
    if (!hit) {
        // Sample sky color based on reflection direction
        float skyIntensity = max(0.0, reflectDir.y);
        reflectionColor = vec3(0.5, 0.7, 1.0) * (0.5 + skyIntensity * 0.5);
    }
    
    imageStore(outputImage, pixel, vec4(reflectionColor, hit ? 1.0 : 0.0));
}

