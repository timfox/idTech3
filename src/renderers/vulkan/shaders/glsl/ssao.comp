#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthBuffer;
layout(set = 0, binding = 1) uniform sampler2D normalBuffer;
layout(set = 0, binding = 2) uniform sampler2D blueNoise;
layout(set = 0, binding = 3) uniform sampler2D colorBuffer; // For LISSAO indirect lighting

layout(set = 0, binding = 4, r8) uniform writeonly image2D outputImage;

layout(push_constant) uniform SSAOConstants {
    mat4 projectionMatrix;
    mat4 invProjectionMatrix;
    vec2 resolution;
    vec2 invResolution;
    float radius;
    float bias;
    float intensity;
    int numSamples;
    int enableLISSAO;
    float indirectIntensity;
    float indirectRadius;
} pc;

// Reconstruct view position from depth
vec3 reconstructViewPos(vec2 uv, float depth)
{
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 viewPos = pc.invProjectionMatrix * clipPos;
    return viewPos.xyz / viewPos.w;
}

// Generate sample points in hemisphere
vec3 getSamplePoint(vec2 uv, int index)
{
    // Use blue noise for sample positions
    vec2 noiseUV = uv + vec2(index % 4, index / 4) * pc.invResolution * 4.0;
    vec3 noise = texture(blueNoise, noiseUV).xyz * 2.0 - 1.0;

    // Create hemisphere sample
    float r = sqrt(float(index + 0.5) / float(pc.numSamples));
    float theta = float(index) * 2.0 * 3.14159 / float(pc.numSamples);

    vec3 samplePoint;
    samplePoint.x = r * cos(theta);
    samplePoint.y = r * sin(theta);
    samplePoint.z = sqrt(1.0 - r * r); // Ensure z is positive for hemisphere

    // Rotate by noise
    samplePoint = normalize(samplePoint + noise * 0.5);

    return samplePoint;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y)) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;

    float depth = texture(depthBuffer, uv).r;
    if (depth >= 1.0) {
        // Skybox/background - no occlusion
        imageStore(outputImage, pixel, vec4(1.0));
        return;
    }

    vec3 viewPos = reconstructViewPos(uv, depth);
    vec3 viewNormal = normalize(texture(normalBuffer, uv).xyz * 2.0 - 1.0);

    // Traditional SSAO/SAO
    float directOcclusion = 0.0;
    vec3 indirectLighting = vec3(0.0);

    for (int i = 0; i < pc.numSamples; i++) {
        // Get sample point in tangent space
        vec3 samplePoint = getSamplePoint(uv, i);

        // Transform to view space
        vec3 viewSamplePoint = viewPos + samplePoint * pc.radius;

        // Project back to screen space
        vec4 projSamplePoint = pc.projectionMatrix * vec4(viewSamplePoint, 1.0);
        projSamplePoint /= projSamplePoint.w;

        // Convert to UV coordinates
        vec2 sampleUV = projSamplePoint.xy * 0.5 + 0.5;

        // Check bounds
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {
            continue;
        }

        // Get sample depth
        float sampleDepth = texture(depthBuffer, sampleUV).r;
        vec3 sampleViewPos = reconstructViewPos(sampleUV, sampleDepth);

        // Check if sample is occluded
        float rangeCheck = smoothstep(0.0, 1.0, pc.radius / abs(viewPos.z - sampleViewPos.z));
        if (sampleViewPos.z >= viewSamplePoint.z + pc.bias) {
            directOcclusion += rangeCheck;

            // LISSAO: Sample indirect lighting from nearby surfaces
            if (pc.enableLISSAO > 0) {
                vec3 sampleNormal = normalize(texture(normalBuffer, sampleUV).xyz * 2.0 - 1.0);
                vec3 sampleColor = texture(colorBuffer, sampleUV).rgb;

                // Check if this sample can contribute indirect light
                // (surface is visible and facing the right direction)
                float normalSimilarity = max(0.0, dot(viewNormal, sampleNormal));
                float distanceAttenuation = 1.0 / (1.0 + length(sampleViewPos - viewPos) / pc.indirectRadius);

                // Indirect light contribution
                vec3 indirectContribution = sampleColor * normalSimilarity * distanceAttenuation * rangeCheck;
                indirectLighting += indirectContribution;
            }
        }
    }

    // Normalize occlusion
    directOcclusion = directOcclusion / float(pc.numSamples);
    directOcclusion = 1.0 - directOcclusion;
    directOcclusion = pow(directOcclusion, pc.intensity);

    // Apply LISSAO indirect lighting
    if (pc.enableLISSAO > 0) {
        indirectLighting /= float(pc.numSamples);
        indirectLighting *= pc.indirectIntensity;

        // Combine direct occlusion with indirect lighting
        // Indirect lighting reduces occlusion in shadowed areas
        float indirectOcclusion = 1.0 - min(length(indirectLighting), 1.0);
        directOcclusion = min(directOcclusion, indirectOcclusion);
    }

    imageStore(outputImage, pixel, vec4(directOcclusion));
}
