#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

#include "rt_defines.glsl"
#include "rt_helpers.glsl"
#include "rt_random.glsl"

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba16f) uniform image2D outputImage;
layout(binding = 2, set = 0) uniform UniformBuffer {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 cameraPos;
    vec2 resolution;
    float time;
    float nearPlane;
    float farPlane;
    float exposure;
    int frameIndex;
    int samplesPerPixel;
    int debugMagenta; // 0=normal, 1=gradient test
    float temporalAlpha; // Blend factor for temporal accumulation
    mat4 previousViewInverse;
    mat4 previousProjInverse;
    vec4 previousCameraPos;
    int pathTracing; // 0 = hybrid, 1 = full path tracing
} ubo;
layout(binding = 5, set = 0, rgba16f) uniform image2D historyImage; // Previous frame RT output
layout(binding = 6, set = 0, rg16f) uniform image2D motionVectorImage; // Motion vectors for reprojection

layout(location = 0) rayPayloadEXT vec3 hitValue;
layout(location = 1) rayPayloadEXT float hitDistance;
layout(location = 2) rayPayloadEXT int bounceCount;
layout(location = 3) rayPayloadEXT vec3 accumulatedColor;

void main()
{
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    
    // Bounds check to prevent out-of-bounds writes
    if (pixel.x >= gl_LaunchSizeEXT.x || pixel.y >= gl_LaunchSizeEXT.y) {
        return;
    }
    
    const vec2 pixelCenter = vec2(pixel) + vec2(0.5);
    
    // Debug mode: gradient test (magenta clear + gradient overlay)
    if (ubo.debugMagenta != 0) {
        vec2 uv = pixelCenter / ubo.resolution;
        imageStore(outputImage, pixel, vec4(uv, 0.0, 1.0));
        return;
    }
    
    // Calculate UV coordinates
    const vec2 inUV = pixelCenter / ubo.resolution;
    
    // Get camera position and ray direction
    vec3 origin = getWorldRayOrigin(ubo.viewInverse);
    vec3 direction = getWorldRayDirection(inUV, ubo.viewInverse, ubo.projInverse);
    
    // Add jitter for anti-aliasing. The helper uses a blue-noise texture array
    // when available (USE_BLUE_NOISE), otherwise it falls back to hash-based RNG.
    if (ubo.samplesPerPixel > 1) {
        uvec2 pix = uvec2(pixel);
        float jx = rt_getRNG(false, 0u, pix, uint(ubo.frameIndex));
        float jy = rt_getRNG(false, 1u, pix, uint(ubo.frameIndex));
        vec2 jitter = (vec2(jx, jy) - 0.5) / ubo.resolution;
        direction = getWorldRayDirection(inUV + jitter, ubo.viewInverse, ubo.projInverse);
    }
    
    // Initialize payload for multi-bounce GI
    hitValue = vec3(0.0);
    hitDistance = 0.0;
    bounceCount = 0;
    accumulatedColor = vec3(0.0);
    
    // Trace primary ray
    uint rayFlags = gl_RayFlagsOpaqueEXT;
    float tMin = ubo.nearPlane;
    float tMax = ubo.farPlane;
    
    traceRayEXT(
        topLevelAS,        // accelerationStructure
        rayFlags,          // rayFlags
        0xFF,              // cullMask
        0,                 // sbtRecordOffset
        0,                 // sbtRecordStride
        0,                 // missIndex
        origin,            // origin
        tMin,              // Tmin
        direction,         // direction
        tMax,              // Tmax
        0                  // payload
    );
    
    // Apply exposure (keep in HDR linear space for ray tracing output)
    // Tonemapping will be done in the composite pass
    vec3 currentColor = hitValue * ubo.exposure;
    
    // Temporal accumulation: blend with previous frame
    vec3 finalColor = currentColor;
    if (ubo.temporalAlpha > 0.0 && ubo.frameIndex > 0) {
        // Calculate motion vector: reproject current pixel to previous frame
        vec3 worldPos = origin + direction * hitDistance;
        
        // Transform world position to previous frame's clip space
        vec4 prevClipPos = ubo.previousProjInverse * ubo.previousViewInverse * vec4(worldPos, 1.0);
        prevClipPos /= prevClipPos.w;
        
        // Convert to UV coordinates
        vec2 prevUV = prevClipPos.xy * 0.5 + 0.5;
        prevUV.y = 1.0 - prevUV.y; // Flip Y for Vulkan
        
        // Calculate motion vector (in screen space)
        vec2 motionVec = (prevUV - inUV) * ubo.resolution;
        
        // Write motion vector
        imageStore(motionVectorImage, pixel, vec4(motionVec, 0.0, 1.0));
        
        // Sample history at reprojected position
        vec2 historyUV = prevUV;
        bool historyValid = all(greaterThanEqual(historyUV, vec2(0.0))) && all(lessThanEqual(historyUV, vec2(1.0)));
        
        vec3 historyColor = vec3(0.0);
        if (historyValid) {
            ivec2 historyPixel = ivec2(historyUV * ubo.resolution);
            historyPixel = clamp(historyPixel, ivec2(0), ivec2(ubo.resolution) - ivec2(1));
            historyColor = imageLoad(historyImage, historyPixel).rgb;
        }
        
        // Blend current frame with history using exponential moving average
        float alpha = 1.0 - ubo.temporalAlpha;
        finalColor = mix(historyColor, currentColor, alpha);
        
        // Simple disocclusion detection: if motion vector is too large, reject history
        float motionMagnitude = length(motionVec);
        if (motionMagnitude > 10.0) {
            finalColor = currentColor; // Reject history on large motion
        }
    } else {
        // First frame or temporal disabled, use current color only
        finalColor = currentColor;
    }
    
    // Write HDR color to output image (no tonemapping/sRGB conversion here)
    imageStore(outputImage, pixel, vec4(finalColor, 1.0));
}
