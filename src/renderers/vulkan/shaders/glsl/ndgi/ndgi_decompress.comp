#version 450
/*
 * Neural Dynamic GI — per-tile decompress (GPU path, experimental).
 * Mirrors CPU MLP in vk_ndgi.c; output RGBA8 lightmap page.
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D featureAtlas;
layout(binding = 1, std430) readonly buffer NdgiWeights {
	float data[];
} weights;
layout(binding = 2, rgba8) uniform writeonly image2D lightmapPage;

layout(push_constant) uniform NdgiPush {
	int state0;
	int state1;
	float blend;
	int featureDim;
	int hiddenDim;
	int pageOriginX;
	int pageOriginY;
} pc;

float relu(float x) { return max(x, 0.0); }
float sigmoid(float x) { return 1.0 / (1.0 + exp(-x)); }

vec3 mlpDecode(vec4 feat) {
	int h = pc.hiddenDim;
	int f = pc.featureDim;
	float hidden[32];
	vec3 outRgb = vec3(0.0);
	int wBase = 0;
	int i;
	int c;

	for (i = 0; i < 32; i++) {
		hidden[i] = 0.0;
	}

	for (i = 0; i < h && i < 32; i++) {
		float sum = weights.data[wBase + (h * f) + i];
		int j;
		for (j = 0; j < f && j < 4; j++) {
			sum += weights.data[wBase + i * f + j] * feat[j];
		}
		hidden[i] = relu(sum);
	}

	wBase += h * f + h;
	for (c = 0; c < 3; c++) {
		float sum = weights.data[wBase + (3 * h) + c];
		for (i = 0; i < h && i < 32; i++) {
			sum += weights.data[wBase + c * h + i] * hidden[i];
		}
		outRgb[c] = sigmoid(sum);
	}
	return outRgb;
}

void main() {
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	ivec2 pageSize = imageSize(lightmapPage);
	if (gid.x >= pageSize.x || gid.y >= pageSize.y) {
		return;
	}

	vec2 uv = (vec2(gid) + 0.5) / vec2(pageSize);
	float v0 = (float(pc.state0) + 0.5) / max(float(pc.state1 + 1), 1.0);
	float v1 = (float(pc.state1) + 0.5) / max(float(pc.state1 + 1), 1.0);
	vec4 f0 = texture(featureAtlas, vec2(uv.x, v0));
	vec4 f1 = texture(featureAtlas, vec2(uv.x, v1));
	vec4 feat = mix(f0, f1, clamp(pc.blend, 0.0, 1.0));
	vec3 rgb = mlpDecode(feat);
	imageStore(lightmapPage, gid, vec4(rgb, 1.0));
}
