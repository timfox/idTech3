vec3 lightmapDecode( vec3 c ) {
	/* sRGB to linear: use when BSP lightmaps are gamma-encoded (q3map2 -gamma, etc.) */
	return mix( c / 12.92, pow( ( c + 0.055 ) / 1.055, vec3( 2.4 ) ), step( 0.04045, c ) );
}

vec3 CalcNormal( in vec3 vertexNormal, in vec4 vertexTangent, in vec2 frag_tex_coord )
{
	if ( normal_texture_set >= 0 ) {
		vec3 biTangent = vertexTangent.w * cross(vertexNormal, vertexTangent.xyz);
		vec3 n = texture(normal_texture, frag_tex_coord).agb - vec3(0.5);

		n.xy *= vec2( normalScale_x, normalScale_y );
		n.z = sqrt(clamp((0.25 - n.x * n.x) - n.y * n.y, 0.0, 1.0));
		n = n.x * vertexTangent.xyz + n.y * biTangent + n.z * vertexNormal;

		return normalize(n);
	}else {
		return normalize(vertexNormal);
	}
}

float WrapLambert( in float NL, in float w )
{
	return clamp((NL + w) / pow(1.0 + w, 2.0), 0.0, 1.0);
}

vec3 Diffuse_Lambert(in vec3 DiffuseColor)
{
	return DiffuseColor * (1.0 / PI);
}

float Pow5( in float x )
{
	float x2 = x * x;
	return x2 * x2 * x;
}

vec3 Diffuse_Burley( in vec3 diffuseColor, in float NE, in float NL, in float LH, in float roughness )
{
	// Disney 2012 diffuse term for direct lighting.
	float FD90 = 0.5 + 2.0 * LH * LH * roughness;
	float lightScatter = 1.0 + ( FD90 - 1.0 ) * Pow5( 1.0 - NL );
	float viewScatter = 1.0 + ( FD90 - 1.0 ) * Pow5( 1.0 - NE );
	return diffuseColor * (1.0 / PI) * lightScatter * viewScatter;
}

vec3 CalcDiffuse( in vec3 diffuse, in float NE, in float NL,
	in float LH, in float roughness )
{
	// Keep Lambert as a fallback during Disney diffuse rollout.
	const bool useDisneyDiffuse = true;
	if ( useDisneyDiffuse )
		return Diffuse_Burley( diffuse, NE, NL, LH, roughness );
	return Diffuse_Lambert( diffuse );
}

// Schlick Fresnel (2025 PBR standard). F0 = reflectance at normal incidence.
// F = F0 + (1 - F0) * (1 - V·H)^5. Use Pow5 for consistency with Disney diffuse.
vec3 F_Schlick( in vec3 F0, in float VH )
{
	float Fc = Pow5( 1.0 - clamp( VH, 0.0, 1.0 ) );
	return F0 + ( 1.0 - F0 ) * Fc;
}

// Roughness-dependent Fresnel (Disney/Epic): very rough surfaces attenuate grazing Fresnel.
// Use when pbrAdvancedParams.z > 0.5 for improved energy conservation on rough materials.
vec3 F_SchlickRoughness( in vec3 F0, in float VH, in float roughness )
{
	float Fc = Pow5( 1.0 - clamp( VH, 0.0, 1.0 ) );
	float atten = 1.0 - roughness * roughness;  // attenuate Fresnel kick for rough surfaces
	return F0 + ( 1.0 - F0 ) * Fc * atten;
}

float D_GGX( in float NH, in float alpha )
{
	// Trowbridge-Reitz GGX NDF using alpha (where alpha = roughness^2).
	float alphaSq = alpha * alpha;
	float d = (NH * alphaSq - NH) * NH + 1;
	return alphaSq / (PI * d * d);
}

float CalcVisibility( in float NL, in float NE, in float alpha )
{
	// Smith masking-shadowing using GGX lambda formulation with alpha.
	float alphaSq = alpha * alpha;

	float lambdaE = NL * sqrt((-NE * alphaSq + NE) * NE + alphaSq);
	float lambdaL = NE * sqrt((-NL * alphaSq + NL) * NL + alphaSq);

	/* Guard against division by zero at grazing angles (lambdaE+lambdaL ~ 0) */
	return 0.5 / max( lambdaE + lambdaL, 1e-7 );
}

float glintDebugD = 0.0;
float glintDebugLambda = 0.0;
float glintDebugComp = 0.0;
float glintDebugWeight = 0.0;

vec3 CalcSpecular( in vec3 specular, in vec3 H, in float NH, in float NL,
	in float NE, float LH, in float VH, in float roughness,
	in vec2 uv, in mat3 base )
{
	if ( NL <= 0.0 || NE <= 0.0 || NH <= 0.0 ) {
		glintDebugD = 0.0;
		glintDebugLambda = 0.0;
		glintDebugComp = 0.0;
		glintDebugWeight = 0.0;
		return vec3( 0.0 );
	}

	float alpha = max( roughness * roughness, 0.001 );
	vec3  F = ( pbrAdvancedParams.z > 0.5 )
		? F_SchlickRoughness( specular, VH, roughness )
		: F_Schlick( specular, VH );
	float D = D_GGX(NH, alpha);
	float V = CalcVisibility(NL, NE, alpha);

	glintDebugD = 0.0;
	glintDebugLambda = 0.0;
	glintDebugComp = 0.0;
	glintDebugWeight = 0.0;

	float dClamp = max( pbrGlintParams1.y, 1.0 );
	float roughnessLo = min( pbrGlintParams1.z, pbrGlintParams1.w );
	float roughnessHi = max( pbrGlintParams1.z, pbrGlintParams1.w );
	roughnessHi = max( roughnessHi, roughnessLo + 0.001 );

	float glintEnabled = pbrGlintFlags.x;
	float glintMode = pbrGlintFlags.y;

	if ( glintEnabled > 0.5 && glintMode >= 0.5 && roughness < roughnessHi ) {
		float glintWeight = clamp( 1.0 - smoothstep( roughnessLo, roughnessHi, roughness ), 0.0, 1.0 );
		if ( glintWeight > 0.0 ) {
			mat2 uvJac = mat2( dFdx( uv ), dFdy( uv ) );
			GlintParams glintParams;
			glintParams.density = max( pbrGlintParams0.x, 1e-3 );
			glintParams.microfacetRoughness = max( pbrGlintParams0.y, 1e-4 );
			glintParams.pixelFilterSize = max( pbrGlintParams0.z, 0.5 );
			glintParams.sampleBudget = clamp( pbrGlintParams0.w, 0.0, 2.0 );
			glintParams.maxLodClamp = max( pbrGlintParams1.x, 0.1 );
			glintParams.dClamp = max( pbrGlintParams1.y, 1.0 );

			float lambda = 0.0;
			float comp = 0.0;
			float D_glint = D_GLINT_GGX( base, H, uv, uvJac, alpha, glintParams, lambda, comp );
			D = mix( D, D_glint, glintWeight );
			glintDebugD = D_glint;
			glintDebugLambda = lambda;
			glintDebugComp = comp;
			glintDebugWeight = glintWeight;
		}
	}

	D = min( D, dClamp );
	return D * F * V;
}


vec3 CalcIBLContribution( in float roughness, in vec3 N, in vec3 E,
	in float NE, in vec3 specular )
{
	vec3 R = reflect(-E, N);
	R.y *= -1.0f;
	
	uint envLevels = textureQueryLevels(env_texture);
	float maxEnvLod = (envLevels > 0u) ? float(envLevels - 1u) : 0.0;
	float envLod = min( roughness * 6.0, maxEnvLod );
	vec3 cubeLightColor = textureLod(env_texture, R, envLod).rgb;
	vec2 EnvBRDF = texture(brdflut_texture, vec2(NE, 1.0 - roughness)).rg;
	vec3 FssEss = (specular.rgb * EnvBRDF.x + EnvBRDF.y);

	// Step 3 (Kulla-Conty): optional multiple-scattering compensation for specular IBL.
	if ( pbrAdvancedParams.x > 0.5 ) {
		float Ess = clamp( EnvBRDF.x + EnvBRDF.y, 0.0, 1.0 );
		float Ems = 1.0 - Ess;
		vec3 Favg = specular + (1.0 - specular) * (1.0 / 21.0);
		vec3 Fms = (FssEss * Favg) / max( vec3(1.0 - Ems * Favg), vec3(1e-3) );
		float strength = clamp( pbrAdvancedParams.y, 0.0, 2.0 );
		return cubeLightColor * (FssEss + Fms * strength);
	}

	return cubeLightColor * FssEss;
}

vec3 EvalSH9( in vec3 n )
{
	float x = n.x;
	float y = n.y;
	float z = n.z;

	// L0..L2 order: (0,0), (1,-1), (1,0), (1,1), (2,-2), (2,-1), (2,0), (2,1), (2,2)
	vec3 c0 = pbrShCoeffs[0].xyz;
	vec3 c1 = pbrShCoeffs[1].xyz;
	vec3 c2 = pbrShCoeffs[2].xyz;
	vec3 c3 = pbrShCoeffs[3].xyz;
	vec3 c4 = pbrShCoeffs[4].xyz;
	vec3 c5 = pbrShCoeffs[5].xyz;
	vec3 c6 = pbrShCoeffs[6].xyz;
	vec3 c7 = pbrShCoeffs[7].xyz;
	vec3 c8 = pbrShCoeffs[8].xyz;

	return c0 +
		c1 * y +
		c2 * z +
		c3 * x +
		c4 * (x * y) +
		c5 * (y * z) +
		c6 * (3.0 * z * z - 1.0) +
		c7 * (x * z) +
		c8 * (x * x - y * y);
}

vec3 CalcDiffuseIrradiance( in vec3 N )
{
	vec3 irradiance = EvalSH9( N );
	if ( irradiance_texture_set >= 0 ) {
		vec3 R = N;
		R.y *= -1.0f;
		irradiance += texture( irradiance_texture, R ).rgb;
	}
	return irradiance;
}

vec3 CalcBurleySubsurface( in vec3 N, in vec3 L, in vec3 subsurfaceColor, in float strength, in float wrap )
{
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float wrapValue = clamp( wrap, 0.0, 1.0 );
	float scatter = WrapLambert( NL, wrapValue );
	return subsurfaceColor * strength * scatter;
}
