vec3 lightmapDecode( vec3 c ) {
	/* sRGB to linear: use when BSP lightmaps are gamma-encoded (q3map2 -gamma, etc.) */
	return mix( c / 12.92, pow( ( c + 0.055 ) / 1.055, vec3( 2.4 ) ), step( 0.04045, c ) );
}

vec2 lightmapTexCoord( void ) {
#if defined(USE_TX2)
	if ( lightmap_texture_set == 2 )
		return frag_tex_coord2;
#endif
#if defined(USE_TX1)
	if ( lightmap_texture_set == 1 )
		return frag_tex_coord1;
#endif
	return frag_tex_coord0;
}

vec3 sampleLightmap( void ) {
	const vec2 uv = lightmapTexCoord();
#if defined(USE_TX2)
	if ( lightmap_texture_set == 2 )
		return texture( texture2, uv ).rgb;
#endif
#if defined(USE_TX1)
	if ( lightmap_texture_set == 1 )
		return texture( texture1, uv ).rgb;
#endif
	return texture( texture0, uv ).rgb;
}

float SampleParallaxHeight( vec2 uv )
{
	if ( pom_height_source == 1 ) {
		if ( normal_texture_set < 0 )
			return 0.0;
		return clamp( texture( normal_texture, uv ).a, 0.0, 1.0 );
	}
	if ( physical_texture_set != 0 )
		return 0.0;
	return clamp( texture( physical_texture, uv ).r, 0.0, 1.0 );
}

/* Parallax occlusion: viewDirTS is normalized in tangent space (+Z = surface normal). */
vec2 ParallaxOcclusionMap( vec2 uv, vec3 viewDirTS, float heightScale, int maxSteps, float surfaceBias )
{
	if ( heightScale <= 0.0 || maxSteps < 2 )
		return uv;
	vec3 vd = normalize( viewDirTS );
	float dz = max( abs( vd.z ), 0.05 );
	vec2 deltaUV = heightScale * vd.xy / ( dz * float( maxSteps ) );
	float layerDepth = 1.0 / float( maxSteps );
	float curLayerDepth = 0.0;
	float curH = SampleParallaxHeight( uv );
	float prevH = curH;
	vec2 prevUV = uv;
	int i;
	for ( i = 0; i < maxSteps; i++ ) {
		if ( curLayerDepth >= curH )
			break;
		prevUV = uv;
		prevH = curH;
		uv -= deltaUV;
		curLayerDepth += layerDepth;
		curH = SampleParallaxHeight( uv );
	}
	vec2 p0 = prevUV;
	vec2 p1 = uv;
	float h0 = prevH - ( curLayerDepth - layerDepth );
	float h1 = curH - curLayerDepth;
	float denom = max( abs( h1 - h0 ), 1e-5 );
	float w = clamp( h0 / denom, 0.0, 1.0 );
	return mix( p0, p1, w ) + surfaceBias * deltaUV;
}

float ParallaxSoftShadow( vec2 uv, vec3 lightDirTS, float heightScale, int shadowSteps )
{
	if ( heightScale <= 0.0 || shadowSteps < 2 || pbrParallaxParams.y <= 0.001 )
		return 1.0;
	vec3 ld = normalize( lightDirTS );
	if ( ld.z <= 0.001 )
		return 1.0;
	float h0 = SampleParallaxHeight( uv );
	float dz = max( ld.z, 0.05 );
	vec2 delta = heightScale * ld.xy / ( dz * float( shadowSteps ) );
	float sh = 1.0;
	float rayH = h0;
	int s;
	for ( s = 1; s < shadowSteps; s++ ) {
		vec2 suv = uv + delta * float( s );
		float surf = SampleParallaxHeight( suv );
		if ( surf + 0.005 > rayH ) {
			sh *= clamp( 1.0 - ( surf - rayH ) * 8.0, 0.0, 1.0 );
		}
		rayH += ( 1.0 / float( shadowSteps ) ) * 0.25;
	}
	return mix( 1.0, sh, clamp( pbrParallaxParams.y, 0.0, 1.0 ) );
}

vec3 CalcNormal( in vec3 vertexNormal, in vec4 vertexTangent, in vec2 frag_tex_coord )
{
	if ( normal_texture_set >= 0 ) {
		vec3 biTangent = vertexTangent.w * cross(vertexNormal, vertexTangent.xyz);
		vec3 n = texture(normal_texture, frag_tex_coord).agb - vec3(0.5);

		n.xy *= vec2( normalScale_x, normalScale_y );
		n.z = sqrt(clamp((0.25 - n.x * n.x) - n.y * n.y, 0.0, 1.0));
		n = n.x * vertexTangent.xyz + n.y * biTangent + n.z * vertexNormal;

		return normalize(n);
	}else {
		return normalize(vertexNormal);
	}
}

float ApplySpecularAA( in float roughness, in vec3 N )
{
	if ( pbrAdvancedParams.w <= 0.0 || normal_texture_set < 0 ) {
		return roughness;
	}

	vec3 dndx = dFdx( N );
	vec3 dndy = dFdy( N );
	float variance = min( dot( dndx, dndx ) + dot( dndy, dndy ), 0.5 );
	float alpha = max( roughness * roughness, 0.0004 );

	alpha = clamp( alpha + variance * pbrAdvancedParams.w, 0.0004, 1.0 );
	return clamp( sqrt( alpha ), 0.02, 1.0 );
}

float WrapLambert( in float NL, in float w )
{
	return clamp((NL + w) / pow(1.0 + w, 2.0), 0.0, 1.0);
}

float Pow5( in float x )
{
	float x2 = x * x;
	return x2 * x2 * x;
}

/* Charlie sheen distribution (cloth / fabric glancing lobe), roughness in (0,1] */
float D_Charlie( in float nh, in float roughness )
{
	float r = clamp( roughness, 0.07, 1.0 );
	float invR = 1.0 / r;
	float sin2h = max( 1.0 - nh * nh, 0.0 );
	return ( 2.0 + invR ) * pow( sin2h, invR * 0.5 ) / ( 2.0 * PI );
}

vec3 Diffuse_Burley( in vec3 diffuseColor, in float NE, in float NL, in float LH, in float roughness )
{
	// Disney 2012 diffuse term for direct lighting.
	float FD90 = 0.5 + 2.0 * LH * LH * roughness;
	float lightScatter = 1.0 + ( FD90 - 1.0 ) * Pow5( 1.0 - NL );
	float viewScatter = 1.0 + ( FD90 - 1.0 ) * Pow5( 1.0 - NE );
	return diffuseColor * (1.0 / PI) * lightScatter * viewScatter;
}

vec3 CalcDiffuse( in vec3 diffuse, in float NE, in float NL,
	in float LH, in float roughness )
{
	return Diffuse_Burley( diffuse, NE, NL, LH, roughness );
}

// F0 from IOR (Belcour/Gulbrandsen): F0 = ((n1-n2)/(n1+n2))^2 for dielectrics.
// n1=1 (air), n2=IOR. e.g. IOR 1.5 -> F0 ~0.04. Use when material provides explicit IOR.
float F0_from_IOR( in float ior )
{
	float n = clamp( ior, 1.0, 3.0 );
	float f = ( 1.0 - n ) / ( 1.0 + n );
	return f * f;
}

// Schlick Fresnel (2025 PBR standard). F0 = reflectance at normal incidence.
// F = F0 + (1 - F0) * (1 - V·H)^5. Use Pow5 for consistency with Disney diffuse.
vec3 F_Schlick( in vec3 F0, in float VH )
{
	float Fc = Pow5( 1.0 - clamp( VH, 0.0, 1.0 ) );
	return F0 + ( 1.0 - F0 ) * Fc;
}

// Roughness-dependent Fresnel (Disney/Epic): very rough surfaces attenuate grazing Fresnel.
// Use when pbrAdvancedParams.z > 0.5 for improved energy conservation on rough materials.
vec3 F_SchlickRoughness( in vec3 F0, in float VH, in float roughness )
{
	float Fc = Pow5( 1.0 - clamp( VH, 0.0, 1.0 ) );
	float atten = 1.0 - roughness * roughness;  // attenuate Fresnel kick for rough surfaces
	return F0 + ( 1.0 - F0 ) * Fc * atten;
}

float D_GGX( in float NH, in float alpha )
{
	// Trowbridge-Reitz GGX NDF using alpha (where alpha = roughness^2).
	float alphaSq = alpha * alpha;
	float d = (NH * alphaSq - NH) * NH + 1;
	return alphaSq / (PI * d * d);
}

// Anisotropic GGX NDF (Filament / Burley-style): HoX = dot(H,T), HoY = dot(H,B), NoH = dot(N,H).
// ax, ay are linear roughness along tangent X and bitangent Y (both > 0).
float D_GGX_Anisotropic( in float NoH, in float HoX, in float HoY, in float ax, in float ay )
{
	float a2 = ax * ay;
	float f = ( HoX * HoX ) / max( ax * ax, 1e-8 ) + ( HoY * HoY ) / max( ay * ay, 1e-8 ) + NoH * NoH;
	return 1.0 / max( PI * a2 * f * f, 1e-12 );
}

float CalcVisibility( in float NL, in float NE, in float alpha )
{
	// Smith masking-shadowing using GGX lambda formulation with alpha.
	float alphaSq = alpha * alpha;

	float lambdaE = NL * sqrt((-NE * alphaSq + NE) * NE + alphaSq);
	float lambdaL = NE * sqrt((-NL * alphaSq + NL) * NL + alphaSq);

	/* Guard against division by zero at grazing angles (lambdaE+lambdaL ~ 0) */
	return 0.5 / max( lambdaE + lambdaL, 1e-7 );
}

// Anisotropic visibility (height-correlated Smith GGX), Filament-style formulation.
// X/Y = tangent / bitangent; NoL, NoV on the same hemisphere as direct lighting.
float CalcVisibilityAnisotropic( in float NoL, in float NoV,
	in float XoL, in float YoL, in float XoV, in float YoV,
	in float ax, in float ay )
{
	vec3 vA = vec3( ax * XoV, ay * YoV, NoV );
	vec3 lA = vec3( ax * XoL, ay * YoL, NoL );
	float lambdaV = NoL * length( vA );
	float lambdaL = NoV * length( lA );
	return 0.5 / max( lambdaV + lambdaL, 1e-7 );
}

float glintDebugD = 0.0;
float glintDebugLambda = 0.0;
float glintDebugComp = 0.0;
float glintDebugWeight = 0.0;

vec3 CalcSpecular( in vec3 specular, in vec3 H, in float NH, in float NL,
	in float NE, float LH, in float VH, in float roughness,
	in vec2 uv, in mat3 base, in float anisoAmount,
	in vec3 Ldir, in vec3 Vdir )
{
	if ( NL <= 0.0 || NE <= 0.0 || NH <= 0.0 ) {
		glintDebugD = 0.0;
		glintDebugLambda = 0.0;
		glintDebugComp = 0.0;
		glintDebugWeight = 0.0;
		return vec3( 0.0 );
	}

	float alpha = max( roughness * roughness, 0.001 );
	vec3  F = ( pbrAdvancedParams.z > 0.5 )
		? F_SchlickRoughness( specular, VH, roughness )
		: F_Schlick( specular, VH );
	float anisoDirectEnabled = pbrGlintFlags.z;
	vec3 Tn = normalize( base[0] );
	vec3 Bn = normalize( base[1] );
	float HoX = dot( H, Tn );
	float HoY = dot( H, Bn );
	float D;
	float V;
	float aniso = clamp( anisoAmount, 0.0, 1.0 );
	if ( anisoDirectEnabled > 0.5 && aniso > 1e-4 ) {
		/* Elongate highlights along tangent: aspect < 1 => tighter along bitangent, wider along tangent */
		float aspect = sqrt( max( 0.011111, 1.0 - 0.9 * aniso ) );
		float ax = max( alpha / aspect, 1e-4 );
		float ay = max( alpha * aspect, 1e-4 );
		D = D_GGX_Anisotropic( NH, HoX, HoY, ax, ay );
		vec3 Nn = normalize( base[2] );
		float NoL = max( dot( Nn, Ldir ), 1e-5 );
		float NoV = max( dot( Nn, Vdir ), 1e-5 );
		float XoL = dot( Tn, Ldir );
		float YoL = dot( Bn, Ldir );
		float XoV = dot( Tn, Vdir );
		float YoV = dot( Bn, Vdir );
		V = CalcVisibilityAnisotropic( NoL, NoV, XoL, YoL, XoV, YoV, ax, ay );
	} else {
		D = D_GGX( NH, alpha );
		V = CalcVisibility( NL, NE, alpha );
	}

	glintDebugD = 0.0;
	glintDebugLambda = 0.0;
	glintDebugComp = 0.0;
	glintDebugWeight = 0.0;

	float dClamp = max( pbrGlintParams1.y, 1.0 );
	float roughnessLo = min( pbrGlintParams1.z, pbrGlintParams1.w );
	float roughnessHi = max( pbrGlintParams1.z, pbrGlintParams1.w );
	roughnessHi = max( roughnessHi, roughnessLo + 0.001 );

	float glintEnabled = pbrGlintFlags.x;
	float glintMode = pbrGlintFlags.y;

	if ( glintEnabled > 0.5 && glintMode >= 0.5 && roughness < roughnessHi ) {
		float glintWeight = clamp( 1.0 - smoothstep( roughnessLo, roughnessHi, roughness ), 0.0, 1.0 );
		if ( glintWeight > 0.0 ) {
			mat2 uvJac = mat2( dFdx( uv ), dFdy( uv ) );
			GlintParams glintParams;
			glintParams.density = max( pbrGlintParams0.x, 1e-3 );
			glintParams.microfacetRoughness = max( pbrGlintParams0.y, 1e-4 );
			glintParams.pixelFilterSize = max( pbrGlintParams0.z, 0.5 );
			glintParams.sampleBudget = clamp( pbrGlintParams0.w, 0.0, 2.0 );
			glintParams.maxLodClamp = max( pbrGlintParams1.x, 0.1 );
			glintParams.dClamp = max( pbrGlintParams1.y, 1.0 );

			float lambda = 0.0;
			float comp = 0.0;
			float D_glint = D_GLINT_GGX( base, H, uv, uvJac, alpha, glintParams, lambda, comp );
			D = mix( D, D_glint, glintWeight );
			glintDebugD = D_glint;
			glintDebugLambda = lambda;
			glintDebugComp = comp;
			glintDebugWeight = glintWeight;
		}
	}

	D = min( D, dClamp );
	return D * F * V;
}


vec3 CalcIBLContribution( in float roughness, in vec3 N, in vec3 E,
	in float NE, in vec3 specular, in float iblAnisoStretch, in float anisoAmount )
{
	vec3 R = reflect(-E, N);
	R.y *= -1.0f;
	
	uint envLevels = textureQueryLevels(env_texture);
	float maxEnvLod = (envLevels > 0u) ? float(envLevels - 1u) : 0.0;
	float envRough = roughness;
	if ( iblAnisoStretch > 1e-4 && anisoAmount > 1e-4 ) {
		/* Same aspect as direct anisotropic GGX: blurrier reflections when stretched */
		float aspect = sqrt( max( 0.011111, 1.0 - 0.9 * clamp( anisoAmount, 0.0, 1.0 ) ) );
		float alpha = max( roughness * roughness, 0.001 );
		float ax = max( alpha / aspect, 1e-4 );
		float ay = max( alpha * aspect, 1e-4 );
		float stretch = sqrt( max( ax / ay, ay / ax ) );
		envRough = clamp( roughness * mix( 1.0, stretch, clamp( iblAnisoStretch, 0.0, 1.0 ) ), 0.02, 1.0 );
	}
	float envLod = min( envRough * 6.0, maxEnvLod );
	vec3 cubeLightColor = textureLod(env_texture, R, envLod).rgb;
	vec2 EnvBRDF = texture(brdflut_texture, vec2(NE, 1.0 - envRough)).rg;
	vec3 FssEss = (specular.rgb * EnvBRDF.x + EnvBRDF.y);

	// Step 3 (Kulla-Conty): optional multiple-scattering compensation for specular IBL.
	if ( pbrAdvancedParams.x > 0.5 ) {
		float Ess = clamp( EnvBRDF.x + EnvBRDF.y, 0.0, 1.0 );
		float Ems = 1.0 - Ess;
		vec3 Favg = specular + (1.0 - specular) * (1.0 / 21.0);
		vec3 Fms = (FssEss * Favg) / max( vec3(1.0 - Ems * Favg), vec3(1e-3) );
		float strength = clamp( pbrAdvancedParams.y, 0.0, 2.0 );
		return cubeLightColor * (FssEss + Fms * strength);
	}

	return cubeLightColor * FssEss;
}

vec3 EvalSH9( in vec3 n )
{
	float x = n.x;
	float y = n.y;
	float z = n.z;

	// L0..L2 order: (0,0), (1,-1), (1,0), (1,1), (2,-2), (2,-1), (2,0), (2,1), (2,2)
	vec3 c0 = pbrShCoeffs[0].xyz;
	vec3 c1 = pbrShCoeffs[1].xyz;
	vec3 c2 = pbrShCoeffs[2].xyz;
	vec3 c3 = pbrShCoeffs[3].xyz;
	vec3 c4 = pbrShCoeffs[4].xyz;
	vec3 c5 = pbrShCoeffs[5].xyz;
	vec3 c6 = pbrShCoeffs[6].xyz;
	vec3 c7 = pbrShCoeffs[7].xyz;
	vec3 c8 = pbrShCoeffs[8].xyz;

	return c0 +
		c1 * y +
		c2 * z +
		c3 * x +
		c4 * (x * y) +
		c5 * (y * z) +
		c6 * (3.0 * z * z - 1.0) +
		c7 * (x * z) +
		c8 * (x * x - y * y);
}

vec3 CalcDiffuseIrradiance( in vec3 N )
{
	vec3 irradiance = EvalSH9( N );
	if ( irradiance_texture_set >= 0 ) {
		vec3 R = N;
		R.y *= -1.0f;
		irradiance += texture( irradiance_texture, R ).rgb;
	}
	return irradiance;
}

vec3 CalcBurleySubsurface( in vec3 N, in vec3 L, in vec3 subsurfaceColor, in float strength, in float wrap )
{
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float wrapValue = clamp( wrap, 0.0, 1.0 );
	float scatter = WrapLambert( NL, wrapValue );
	return subsurfaceColor * strength * scatter;
}
