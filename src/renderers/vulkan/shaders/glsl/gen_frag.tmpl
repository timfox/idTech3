	float metalness = 0.0;
	float AO = 1.0;
	vec3 emissive = vec3( 0.0 );
	vec3 subsurfaceColor = pbrSubsurfaceColor.rgb;
	float subsurfaceStrength = pbrSubsurfaceParams.x;
	float subsurfaceWrap = pbrSubsurfaceParams.y;

	// metallic roughness workflow
	if ( physical_texture_set >= 0 ) {
		if ( physical_texture_set == 0 ) {
			vec4 ORMS = texture( physical_texture, pbrSurfUV );
			ORMS.xyzw *= vec4( specularScale_z, specularScale_w, specularScale_x, specularScale_y );
			metalness = clamp( ORMS.z, 0.0, 1.0 );

			// 0.04 ≈ F0_from_IOR(1.5); use F0_from_IOR when material has explicit IOR (Belcour 2020).
			float dielectricF0 = 0.04 * clamp( ORMS.w, 0.0, 1.0 );
			specular.rgb = mix( vec3( dielectricF0 ), diffuse.rgb, metalness );
			diffuse.rgb *= vec3( 1.0 - metalness );

			roughness = mix( 0.01, 1.0, ORMS.y );
			AO = min( ORMS.x, AO );
		}
		else if ( physical_texture_set == 1 ) {
			specular = texture( physical_texture, pbrSurfUV );
			specular.rgb *= vec3( specularScale_x, specularScale_y, specularScale_z );
			roughness = mix( 1.0, 0.01, specular.a * ( 1.0 - specularScale_w ) );
		}
	}

	float anisoAmount = 0.0;
	if ( anisotropy_texture_set >= 0 ) {
		anisoAmount = clamp( texture( anisotropy_texture, pbrSurfUV ).r * pbrAnisotropyScale.x, 0.0, 1.0 );
	}
	roughness = ApplySpecularAA( roughness, N );
	roughness = clamp( roughness, 0.02, 1.0 );

	if ( emissive_texture_set >= 0 ) {
		emissive = texture( emissive_texture, pbrSurfUV ).rgb * pbrEmissiveScale.rgb;
	}

	if ( subsurface_texture_set >= 0 ) {
		vec4 subTex = texture( subsurface_texture, pbrSurfUV );
		subsurfaceColor *= subTex.rgb;
		subsurfaceStrength *= subTex.a;
	}

	/* detail map: high-frequency tiling overlay (multiply blend, 0.5 gray = 1.0) */
	if ( detail_texture_set >= 0 ) {
		vec3 detailSample = texture( detail_texture, pbrSurfUV * detail_scale ).rgb;
		diffuse.rgb *= mix( vec3( 1.0 ), detailSample * 2.0, 0.5 );
	}

	ambientColor *= AO;

	vec3  H  = normalize( L + E );
	float NE = abs( dot( N, E ) ) + 1e-5;
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float LH = clamp( dot( L, H ), 0.0, 1.0 );
	vec3 tangent = normalize( var_Tangent.xyz );
	vec3 bitangent = cross( N, tangent );
	if ( length( bitangent ) < 1e-5 ) {
		vec3 fallback = abs( tangent.y ) < 0.99 ? vec3( 0.0, 1.0, 0.0 ) : vec3( 0.0, 0.0, 1.0 );
		bitangent = cross( tangent, fallback );
	}
	bitangent = normalize( bitangent ) * var_Tangent.w;
	mat3 shadingFrame = mat3( tangent, bitangent, N );
	vec2 baseUV = pbrSurfUV;

	vec3  Fd = CalcDiffuse( diffuse.rgb, NE, NL, LH, roughness );
	vec3  Fs = vec3( 0.0 );

	float NH = clamp( dot( N, H ), 0.0, 1.0 );
	float VH = clamp( dot( E, H ), 0.0, 1.0 );
	vec3  kS = clamp(
		( pbrAdvancedParams.z > 0.5 )
			? F_SchlickRoughness( specular.rgb, VH, roughness )
			: F_Schlick( specular.rgb, VH ),
		vec3(0.0), vec3(1.0) );
	vec3  kD = ( vec3( 1.0 ) - kS ) * ( 1.0 - metalness );
	Fd *= kD;


	#if ( defined(USE_TX1) || defined(USE_TX2) )
		if ( deluxe_mapping > -1 )
		{
			Fs = CalcSpecular( specular.rgb, H, NH, NL, NE, LH, VH, roughness, baseUV, shadingFrame, anisoAmount, L, E ) * deluxe_specular_scale;
		}
		else if ( deluxe_specular_scale != 0.0 )
		{
			Fs = CalcSpecular( specular.rgb, H, NH, NL, NE, LH, VH, roughness, baseUV, shadingFrame, anisoAmount, L, E );
		}
	#else
		/* PBR with single texture (tx0): compute direct specular for glint support */
		Fs = CalcSpecular( specular.rgb, H, NH, NL, NE, LH, VH, roughness, baseUV, shadingFrame, anisoAmount, L, E );
	#endif



	vec3 reflectance = Fd + Fs;

	vec3 fpAdd = vec3( 0.0 );
#ifdef USE_FORWARD_PLUS_FRAG
#if defined(USE_FORWARD_PLUS_WORLD_POS)
	if ( forward_plus_shade_strength > 1e-6 ) {
		uint tilesX = uint( fp_lights.fp_light_data[1].x + 0.5 );
		uint tilesY = uint( fp_lights.fp_light_data[1].y + 0.5 );
		float vw = fp_lights.fp_light_data[1].z;
		float vh = fp_lights.fp_light_data[1].w;
				if ( tilesX > 0u && tilesY > 0u && vw > 1.0 && vh > 1.0 ) {
					float tilePxX = vw / max( float( tilesX ), 1.0 );
					float tilePxY = vh / max( float( tilesY ), 1.0 );
					vec4 wc = fp_params.fp_clip_from_world * vec4( var_WorldPos, 1.0 );
					if ( abs( wc.w ) > 1e-5 ) {
						vec3 ndc = wc.xyz / wc.w;
						if ( ndc.z >= -1.0 && ndc.z <= 1.0 && ndc.x >= -1.05 && ndc.x <= 1.05 && ndc.y >= -1.05 && ndc.y <= 1.05 ) {
							vec2 px;
							px.x = 0.5 * ( 1.0 + ndc.x ) * vw;
							px.y = 0.5 * ( 1.0 + ndc.y ) * vh;
							uint tx = min( uint( px.x / tilePxX ), tilesX - 1u );
							uint ty = min( uint( px.y / tilePxY ), tilesY - 1u );
					uint tileId = ty * tilesX + tx;
					uint tbase = tileId * 8u;
					float nLights = fp_lights.fp_light_data[0].x;
					uint maxPerTile = uint( max( fp_lights.fp_light_data[0].z + 0.5, 1.0 ) );
					maxPerTile = min( maxPerTile, 8u );
					uint skipMask = floatBitsToUint( pbrForwardPlus.y );
					for ( uint k = 0u; k < maxPerTile; k++ ) {
						uint li = fp_tiles.fp_tile_cells[ tbase + k ];
						if ( li == 0xFFFFFFFFu ) {
							continue;
						}
						if ( float( li ) + 0.5 >= nLights ) {
							continue;
						}
						if ( skipMask != 0u && li < 32u && ( skipMask & ( 1u << li ) ) != 0u ) {
							continue;
						}
						uint b0 = 2u + li * 4u;
						vec3 lpos = fp_lights.fp_light_data[ b0 ].xyz;
						float rad = max( fp_lights.fp_light_data[ b0 ].w, 1e-3 );
						vec4 lc = fp_lights.fp_light_data[ b0 + 1u ];
						vec4 lpack = fp_lights.fp_light_data[ b0 + 2u ];
						vec3 Ldir;
						float att = 0.0;
						float NLfp = 0.0;
						if ( lc.w < 0.5 ) {
							vec3 Lw = lpos - var_WorldPos;
							float dist = length( Lw );
							if ( dist > rad ) {
								continue;
							}
							/* Match classic projected dlight falloff (light_frag.tmpl / VK_SetLightParams):
							 * intensFactor = 1 - (dist^2)/(rad^2), not (1-dist/rad)^2. */
							float dr = dist / max( rad, 1e-4 );
							att = clamp( 1.0 - dr * dr, 0.0, 1.0 );
							Ldir = Lw / max( dist, 1e-4 );
							NLfp = max( dot( N, Ldir ), 0.0 );
						} else {
							vec3 axis = normalize( vec3( lpack.x, lpack.y, lpack.z ) );
							float cosOuter = lpack.w;
							float cosInner = fp_lights.fp_light_data[ b0 + 3u ].x;
							float segLen = max( fp_lights.fp_light_data[ b0 + 3u ].y, 1e-3 );
							vec3 v = var_WorldPos - lpos;
							float tAx = dot( v, axis );
							float tCl = clamp( tAx, 0.0, segLen );
							vec3 closest = lpos + axis * tCl;
							float dPerp = length( var_WorldPos - closest );
							if ( dPerp > rad ) {
								continue;
							}
							vec3 wDir = v / max( length( v ), 1e-4 );
							float cosAng = dot( wDir, axis );
							float cone = smoothstep( cosOuter, cosInner, cosAng );
							if ( cone <= 1e-4 ) {
								continue;
							}
							float axAtt = 1.0 - smoothstep( segLen * 0.85, segLen, tCl );
							float rp = dPerp / max( rad, 1e-4 );
							float radAtt = clamp( 1.0 - rp * rp, 0.0, 1.0 );
							att = cone * axAtt * radAtt;
							Ldir = -wDir;
							NLfp = max( dot( N, Ldir ), 0.0 );
						}
						if ( att <= 0.0 || NLfp <= 0.0 ) {
							continue;
						}
						/* Packed dlight_t.additive (vk_forward_plus.c rec[14]) — slightly stronger add like legacy ADD blend. */
						float fpAdditive = fp_lights.fp_light_data[ b0 + 3u ].z;
						float addBoost = mix( 1.0, 1.25, step( 0.5, fpAdditive ) );
						vec3 Lfp = Ldir;
						vec3 Hfp = normalize( Lfp + E );
						float NHfp = clamp( dot( N, Hfp ), 0.0, 1.0 );
						float LHfp = clamp( dot( Lfp, Hfp ), 0.0, 1.0 );
						float VHfp = clamp( dot( E, Hfp ), 0.0, 1.0 );
						float specMul = ( deluxe_mapping > 0 ) ? deluxe_specular_scale : 1.0;
						vec3 Fsfp = CalcSpecular( specular.rgb, Hfp, NHfp, NLfp, NE, LHfp, VHfp, roughness, baseUV, shadingFrame, anisoAmount, Lfp, E ) * specMul;
						fpAdd += lc.rgb * addBoost * ( Fd * ( att * NLfp * forward_plus_shade_strength )
							+ Fsfp * ( att * forward_plus_shade_strength * 0.65 ) );
					}
				}
			}
		}
	}
#endif
#endif

	vec3 primaryDirect = lightColor * reflectance * ( attenuation * NL ) * pomSelfShadow;
	float fpRenorm = 1.0;
	if ( forward_plus_shade_strength > 1e-6 ) {
		float pL = length( primaryDirect );
		float fL = length( fpAdd );
		fpRenorm = clamp( 1.0 - ( fL / ( pL + 1e-3 ) ) * 0.45, 0.35, 1.0 );
	}
	vec3 directLighting = primaryDirect * fpRenorm + fpAdd;
	vec3 ambientContribution = ambientColor * diffuse.rgb * kD;
	vec3 diffuseIrradiance = vec3( 0.0 );
	if ( irradiance_texture_set >= 0 ) {
		diffuseIrradiance = CalcDiffuseIrradiance( N ) * diffuse.rgb * AO * kD;
	}
	vec3 iblSpec = vec3( 0.0 );
	if ( env_texture_set >= 0 ) {
		iblSpec = CalcIBLContribution( roughness, N, E, NE, specular.rgb * AO, pbrGlintFlags.w, anisoAmount );
	}

	vec3 debugDir = reflect( -E, N );
	debugDir.y *= -1.0;
	int debugMode = int( pbrDebugMode.x + 0.5 );
	if ( debugMode != 0 ) {
		vec3 envDebugSample = vec3( 0.0 );
		vec3 irrDebugSample = vec3( 0.0 );
		if ( env_texture_set >= 0 ) {
			envDebugSample = textureLod( env_texture, debugDir, 0.0 ).rgb;
		}
		if ( irradiance_texture_set >= 0 ) {
			irrDebugSample = texture( irradiance_texture, debugDir ).rgb;
		}
		vec3 debugColor = vec3( 0.0 );
		if ( debugMode == 1 ) {
			debugColor = directLighting;
		} else if ( debugMode == 2 ) {
			debugColor = iblSpec;
		} else if ( debugMode == 3 ) {
			debugColor = diffuseIrradiance;
		} else if ( debugMode == 4 ) {
			debugColor = mix( envDebugSample, irrDebugSample, 0.5 );
		} else if ( debugMode == 5 ) {
			debugColor = vec3( log2( 1.0 + glintDebugD * 1000.0 ) );
		} else if ( debugMode == 6 ) {
			float lambdaNorm = max( pbrGlintParams1.x, 0.1 );
			debugColor = vec3( clamp( glintDebugLambda / lambdaNorm, 0.0, 1.0 ) );
		} else if ( debugMode == 7 ) {
			debugColor = vec3( clamp( abs( glintDebugComp ) * 10.0, 0.0, 1.0 ) );
		} else if ( debugMode == 8 ) {
			debugColor = vec3( clamp( glintDebugWeight, 0.0, 1.0 ) );
		}
		out_color = vec4( debugColor, 1.0 );
		return;
	}

	out_color.rgb = directLighting;
	out_color.rgb += ambientContribution;
	if ( irradiance_texture_set >= 0 ) {
		out_color.rgb += diffuseIrradiance;
	}
	if ( env_texture_set >= 0 ) {
		out_color.rgb += iblSpec;
	}

	// Clearcoat: second specular lobe on top; scale by (1 - max F0 of base) for approximate energy balance.
	if ( clearcoat_texture_set >= 0 ) {
		vec4 cc = texture( clearcoat_texture, frag_tex_coord0 );
		float ccStrength = clamp( cc.r * pbrClearcoatScale.x, 0.0, 1.0 );
		float ccRoughness = clamp( cc.g * pbrClearcoatScale.y, 0.02, 1.0 );
		vec3 ccSpec = CalcSpecular( vec3(0.04), H, NH, NL, NE, LH, VH, ccRoughness, baseUV, shadingFrame, 0.0, L, E );
		float baseF0m = max( max( specular.r, specular.g ), specular.b );
		float coatAtten = ( 1.0 - ccStrength ) * ( 1.0 - baseF0m );
		out_color.rgb *= coatAtten;
		out_color.rgb += lightColor * ccSpec * ( attenuation * NL ) * ccStrength;
	}

	// Sheen: Charlie NDF + same Smith visibility form as base specular (no separate Fresnel here).
	if ( sheen_texture_set >= 0 ) {
		vec3 sheenColor = texture( sheen_texture, frag_tex_coord0 ).rgb * pbrSheenScale.rgb;
		float sheenRough = clamp( pbrSheenScale.w, 0.07, 1.0 );
		float sheenWeight = clamp( max( max( sheenColor.r, sheenColor.g ), sheenColor.b ), 0.0, 1.0 );
		if ( sheenWeight > 1e-5 && NL > 1e-5 && NE > 1e-5 && NH > 1e-5 ) {
			float alphaS = max( sheenRough * sheenRough, 0.001 );
			float sheenVis = CalcVisibility( NL, NE, alphaS );
			float sheenD = D_Charlie( NH, sheenRough );
			vec3 sheenSpec = sheenColor * sheenD * sheenVis;
			out_color.rgb += lightColor * sheenSpec * ( attenuation * NL );
		}
	}

	// subsurface term (Burley-style wrap approximation)
	if ( subsurfaceStrength > 0.0 ) {
		out_color.rgb += lightColor * CalcBurleySubsurface( N, L, subsurfaceColor, subsurfaceStrength, subsurfaceWrap ) * attenuation;
	}

	// transmission term
	if ( transmission_texture_set >= 0 ) {
		float transmission = texture( transmission_texture, frag_tex_coord0 ).r * pbrTransmissionScale.x;
		float transmitFactor = transmission * ( 1.0 - roughness );
		diffuse.rgb *= ( 1.0 - transmitFactor );
		out_color.rgb += lightColor * diffuse.rgb * ( attenuation * NL ) * transmitFactor;
	}

#ifdef USE_FORWARD_PLUS_FRAG
	{
		const float fp_dbg = fp_lights.fp_light_data[0].w;
		if ( fp_dbg > 1e-6 ) {
			uint tilesX = uint( fp_lights.fp_light_data[1].x + 0.5 );
			uint tilesY = uint( fp_lights.fp_light_data[1].y + 0.5 );
			float vwDbg = fp_lights.fp_light_data[1].z;
			float vhDbg = fp_lights.fp_light_data[1].w;
			if ( tilesX > 0u && tilesY > 0u && vwDbg > 1.0 && vhDbg > 1.0 ) {
				float tilePxX = vwDbg / max( float( tilesX ), 1.0 );
				float tilePxY = vhDbg / max( float( tilesY ), 1.0 );
				vec2 px = gl_FragCoord.xy;
				uint tx = min( uint( px.x / tilePxX ), tilesX - 1u );
				uint ty = min( uint( px.y / tilePxY ), tilesY - 1u );
				uint tileId = ty * tilesX + tx;
				uint base = tileId * 8u;
				uint maxPerTile = uint( max( fp_lights.fp_light_data[0].z + 0.5, 1.0 ) );
				maxPerTile = min( maxPerTile, 8u );
				float occ = 0.0;
				for ( uint k = 0u; k < maxPerTile; k++ ) {
					if ( fp_tiles.fp_tile_cells[ base + k ] != 0xFFFFFFFFu ) {
						occ += 1.0;
					}
				}
				occ = ( maxPerTile > 0u ) ? ( occ / float( maxPerTile ) ) : 0.0;
				vec3 col;
				if ( occ < 0.25 ) {
					col = mix( vec3( 0.02, 0.04, 0.18 ), vec3( 0.0, 0.55, 1.0 ), occ * 4.0 );
				} else if ( occ < 0.5 ) {
					col = mix( vec3( 0.0, 0.55, 1.0 ), vec3( 0.05, 0.85, 0.25 ), ( occ - 0.25 ) * 4.0 );
				} else if ( occ < 0.75 ) {
					col = mix( vec3( 0.05, 0.85, 0.25 ), vec3( 1.0, 0.88, 0.05 ), ( occ - 0.5 ) * 4.0 );
				} else {
					col = mix( vec3( 1.0, 0.88, 0.05 ), vec3( 0.92, 0.08, 0.02 ), ( occ - 0.75 ) * 4.0 );
				}
				vec2 f = fract( vec2( px.x / tilePxX, px.y / tilePxY ) );
				float edge = min( min( f.x, 1.0 - f.x ), min( f.y, 1.0 - f.y ) );
				float border = smoothstep( 0.0, 0.35, edge );
				col = mix( vec3( 0.08 ), col, border );
				out_color.rgb += col * fp_dbg;
			}
		}
	}
#endif
	
	out_color.rgb += emissive;
	
	out_color.a = diffuse.a;
#else
	out_color = base;
#endif
#endif
}
