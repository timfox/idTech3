void main() {
#ifndef USE_DF
	out_motion = vec2(0.0);
	if ( abs(var_CurrentClip.w) > 1e-6 && abs(var_PrevClip.w) > 1e-6 ) {
		vec2 currUV = var_CurrentClip.xy / var_CurrentClip.w * 0.5 + 0.5;
		vec2 prevUV = var_PrevClip.xy / var_PrevClip.w * 0.5 + 0.5;
		out_motion = currUV - prevUV;
	}
#endif
	vec4 diffuse;
	float attenuation;
	vec3 viewDir, lightColor, ambientColor;
	vec3 L, N, E;

#ifdef USE_FOG
	vec4 fog = texture(fog_texture, fog_tex_coord);
#endif

	vec2 uv0 = frag_tex_coord0;
#if defined(USE_FLOWMAP)
	// flowmap: sample flow vectors, offset UV for texture0
	vec2 flowVec = texture(flowmap_texture, frag_tex_coord0).rg - 0.5;
	uv0 = frag_tex_coord0 + flowVec * flowmapParams.x * flowmapParams.y;
#endif
#if defined (USE_CLX_IDENT)
	vec4 color0 = texture(texture0, uv0);
#elif defined (USE_FIXED_COLOR)
	const vec4 frag_color = vec4(identity_color, identity_color,identity_color, identity_alpha);
	vec4 color0 = texture(texture0, uv0) * frag_color;
#elif defined (USE_ENT_COLOR)
	vec4 color0 = texture(texture0, uv0) * ent_color0;
#else
	vec4 color0 = texture(texture0, uv0) * frag_color0;
#endif
	vec4 base;

	// triple-texture with non-identity colors in color1 and color2
#if defined (USE_TX2)
#ifdef USE_CL2
	// special blend modes for non-identity colors
	if ( tex_mode == 1 || tex_mode == 2 )
	{
		// add
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif

		base = vec4( color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a );
	}
	else if ( tex_mode == 3 )
	{
		// modulate by alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif
		color0 *= color0.a;
		color1 *= color1.a;
		color2 *= color2.a;
		base = vec4( color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a );
	}
	else if ( tex_mode == 4 )
	{
		// modulate by 1.0-alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif
		color0 *= 1.0-color0.a;
		color1 *= 1.0-color1.a;
		color2 *= 1.0-color2.a;
		base = vec4( color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a );
	}
	else if ( tex_mode == 5 )
	{
		// mix by src alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif
		//base = mix( color0, color1, color1.a );
		//base = mix( base, color2, color2.a );
		base = mix( mix( color0, color1, color1.a ), color2, color2.a );
	}
	else if ( tex_mode == 6 )
	{
		// mix by 1-src alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif
		//base = mix( color1, color0, color1.a );
		//base = mix( color2, base, color2.a );
		base = mix( color2, mix( color1, color0, color1.a ), color2.a );
	}
	else if ( tex_mode == 7 ) // 0 + 2x GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_DST_COLOR
	{
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif
		base = (color2 + color2.a) * (color1 + color1.a) * color0;
	}
	else
	{
		// default case, modulate
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
#endif
		base = color0 * color1 * color2;
	}
#else // !USE_CL2
	// triple-texture with identity colors (1.0) in color1 and color2
	if ( tex_mode == 1 )
	{
		// add (identity color0 == 1.0)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
		base = vec4(color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a);
	}
	else if ( tex_mode == 2 )
	{
		// add (color0 != 1.0)
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * ent_color2;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color0;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color0;
#endif
		base = vec4(color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a);
	}
	else 
	{
		// default case, modulate
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
		base = color0 * color1 * color2;
	}
#endif // !USE_TX2
#elif defined(USE_TX1)
	// double-texture with non-identity colors in color1
#ifdef USE_CL1
	// special blend modes for non-identity colors
	if ( tex_mode == 1 || tex_mode == 2 )
	{
		// add
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		base = vec4( color0.rgb + color1.rgb, color0.a * color1.a );
	}
	else if ( tex_mode == 3 ) // 2x GLS_DSTBLEND_ONE | GLS_SRCBLEND_SRC_ALPHA
	{
		// modulate by alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		color0 *= color0.a;
		color1 *= color1.a;
		base = vec4( color0.rgb + color1.rgb, color0.a * color1.a );
	}
	else if ( tex_mode == 4 ) // 2x GLS_DSTBLEND_ONE | GLS_SRCBLEND_ONE_MINUS_SRC_ALPHA
	{
		// modulate by 1.0-alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		color0 *= 1.0-color0.a;
		color1 *= 1.0-color1.a;
		base = vec4( color0.rgb + color1.rgb, color0.a * color1.a );
	}
	else if ( tex_mode == 5 ) // 0 + GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA | GLS_SRCBLEND_SRC_ALPHA
	{
		// mix by src alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		base = mix( color0, color1, color1.a );
	}
	else if ( tex_mode == 6 ) // 0 + GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_ONE_MINUS_SRC_ALPHA
	{
		// mix by 1-src alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		base = mix( color1, color0, color1.a );
	}
	else if ( tex_mode == 7 ) // 0 + GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_DST_COLOR
	{
		// modulate color1 by color0
		// moduleta color0 by color1.alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		base = (color1 + color1.a) * color0;
	}
	else
	{
		// default case, modulate
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
#endif
		base = color0 * color1;
	}
#else
	// double-texture with identity colors (1.0) in color1
	if ( tex_mode == 1 )
	{
		// add (identity)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		base = vec4(color0.rgb + color1.rgb, color0.a * color1.a);
	}
	else if ( tex_mode == 2 )
	{
		// add
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color0;
#endif
		base = vec4(color0.rgb + color1.rgb, color0.a * color1.a);
	}
	else // default case
	{
		// modulate
#if defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1);
#endif
		base = color0 * color1;
	}
#endif // !USE_CL1
#endif // !USE_TX1

#ifdef USE_ATEST
#if 0
	if (alpha_to_coverage != 0) {
		if (alpha_test_func == 1) {
			base.a =  base.a > 0.0 ? 1.0 : 0.0;
		} else if (alpha_test_func == 2) {
			base.a = CorrectAlpha(alpha_test_value, 1.0 - base.a, frag_tex_coord0);
		} else if (alpha_test_func == 3) {
			base.a = CorrectAlpha(alpha_test_value, base.a, frag_tex_coord0);
		}
	} else
#endif
	// specialization: alpha-test function
	if (alpha_test_func == 1) {
		if (color0.a == alpha_test_value) discard;
	} else if (alpha_test_func == 2) {
		if (color0.a >= alpha_test_value) discard;
	} else if (alpha_test_func == 3) {
		if (color0.a < alpha_test_value) discard;
	}
#endif

#if !defined(USE_TX1) && !defined(USE_TX2)
	base = color0;
#endif

#ifdef USE_FOG
	if ( acff == 1 ) {
		// ACFF_RGB
		base.rgb = base.rgb * (1.0 - fog.w);
	} else if ( acff == 2 ) {
		// ACFF_RGBA
		base = base * (1.0 - fog.w);
	} else if ( acff == 3 ) {
		// ACFF_ALPHA
		base.a = base.a * (1.0 - fog.w);
	} else {
		// default: ACFF_NONE
		base = mix( base, fog * fogColor, fog.a );
	}
#endif

	if ( discard_mode == 1 ) {
		if ( base.a == 0.0 ) {
			discard;
		}
	} else if ( discard_mode == 2 ) {
		if ( dot( base.rgb, base.rgb ) == 0.0 ) {
			discard;
		}
	}

#ifdef USE_DF
	if ( base.a < depth_fragment )
		discard;

	gl_FragDepth = gl_FragCoord.z;
#else

#ifdef USE_VK_PBR
	viewDir = var_ViewDir.xyz;
	E = normalize(viewDir);

	L = var_LightDir.xyz;
	float sqrLightDist = dot(L, L);
	L /= sqrt(sqrLightDist);

	/* bias_color source by vertex color mode */
	#if defined (USE_CLX_IDENT)
			vec3 bias_color = vec3(1.0);
	#elif defined (USE_FIXED_COLOR)
			vec3 bias_color = frag_color.rgb;
	#elif defined (USE_ENT_COLOR)
			vec3 bias_color = ent_color1.rgb;
	#else
			vec3 bias_color = frag_color0.rgb;
	#endif

	#if ( defined(USE_TX1) || defined(USE_TX2) )
		if ( lightmap_texture_set >= 0 ) {
			vec3 raw = texture(texture1, frag_tex_coord1).rgb;
			if ( lightmap_srgb_decode > 0 )
				raw = lightmapDecode( raw );
			vec3 lightmapColor = raw * lightmap_scale;

			lightColor = lightmapColor * bias_color;
			diffuse = color0;

			if ( deluxe_mapping > 0 )
				L = ( texture(deluxe_texture, frag_tex_coord1).rgb - vec3(0.5) );
		}
		else {
			lightColor = bias_color;
			diffuse = base;
		}
		ambientColor = vec3 (0.0);
		attenuation = 1.0;
	#else
		lightColor = bias_color;
		diffuse = base;
		ambientColor = vec3 (0.0);
		attenuation = 1.0;
	#endif

	N = CalcNormal( var_Normal.xyz, var_Tangent, frag_tex_coord0 );	

	#if defined(USE_TX1) || defined(USE_TX2)
		if ( lightmap_texture_set >= 0 ) {
			ambientColor = lightColor;
			float surfNL = clamp(dot(var_Normal.xyz, L), 0.0, 1.0);
			lightColor /= max( surfNL, 0.25 );
			ambientColor = max( ambientColor - lightColor * surfNL, 0.0 );
		}
	#endif

	vec4 specular = vec4( 0.04, 0.04, 0.04, 1.0 );
	float roughness = 0.99;
	float metalness = 0.0;
	float AO = 1.0;
	vec3 emissive = vec3( 0.0 );
	vec3 subsurfaceColor = pbrSubsurfaceColor.rgb;
	float subsurfaceStrength = pbrSubsurfaceParams.x;
	float subsurfaceWrap = pbrSubsurfaceParams.y;

	// metallic roughness workflow
	if ( physical_texture_set >= 0 ) {
		if ( physical_texture_set == 0 ) {
			vec4 ORMS = texture( physical_texture, frag_tex_coord0 );
			ORMS.xyzw *= vec4( specularScale_z, specularScale_w, specularScale_x, specularScale_y );
			metalness = clamp( ORMS.z, 0.0, 1.0 );

			float dielectricF0 = 0.04 * clamp( ORMS.w, 0.0, 1.0 );
			specular.rgb = mix( vec3( dielectricF0 ), diffuse.rgb, metalness );
			diffuse.rgb *= vec3( 1.0 - metalness );

			roughness = mix( 0.01, 1.0, ORMS.y );
			AO = min( ORMS.x, AO );
		}
		else if ( physical_texture_set == 1 ) {
			specular = texture( physical_texture, frag_tex_coord0 );
			specular.rgb *= vec3( specularScale_x, specularScale_y, specularScale_z );
			roughness = mix( 1.0, 0.01, specular.a * ( 1.0 - specularScale_w ) );
		}
	}

	if ( anisotropy_texture_set >= 0 ) {
		float aniso = texture( anisotropy_texture, frag_tex_coord0 ).r * pbrAnisotropyScale.x;
		roughness = mix( roughness, max( 0.02, roughness * ( 1.0 - aniso ) ), aniso );
	}
	roughness = clamp( roughness, 0.02, 1.0 );

	if ( emissive_texture_set >= 0 ) {
		emissive = texture( emissive_texture, frag_tex_coord0 ).rgb * pbrEmissiveScale.rgb;
	}

	if ( subsurface_texture_set >= 0 ) {
		vec4 subTex = texture( subsurface_texture, frag_tex_coord0 );
		subsurfaceColor *= subTex.rgb;
		subsurfaceStrength *= subTex.a;
	}

	/* detail map: high-frequency tiling overlay (multiply blend, 0.5 gray = 1.0) */
	if ( detail_texture_set >= 0 ) {
		vec3 detailSample = texture( detail_texture, frag_tex_coord0 * detail_scale ).rgb;
		diffuse.rgb *= mix( vec3( 1.0 ), detailSample * 2.0, 0.5 );
	}

	ambientColor *= AO;

	vec3  H  = normalize( L + E );
	float NE = abs( dot( N, E ) ) + 1e-5;
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float LH = clamp( dot( L, H ), 0.0, 1.0 );
	vec3 tangent = normalize( var_Tangent.xyz );
	vec3 bitangent = cross( N, tangent );
	if ( length( bitangent ) < 1e-5 ) {
		vec3 fallback = abs( tangent.y ) < 0.99 ? vec3( 0.0, 1.0, 0.0 ) : vec3( 0.0, 0.0, 1.0 );
		bitangent = cross( tangent, fallback );
	}
	bitangent = normalize( bitangent ) * var_Tangent.w;
	mat3 shadingFrame = mat3( tangent, bitangent, N );
	vec2 baseUV = frag_tex_coord0;

	vec3  Fd = CalcDiffuse( diffuse.rgb, NE, NL, LH, roughness );
	vec3  Fs = vec3( 0.0 );

	float NH = clamp( dot( N, H ), 0.0, 1.0 );
	float VH = clamp( dot( E, H ), 0.0, 1.0 );
	vec3  kS = clamp(
		( pbrAdvancedParams.z > 0.5 )
			? F_SchlickRoughness( specular.rgb, VH, roughness )
			: F_Schlick( specular.rgb, VH ),
		vec3(0.0), vec3(1.0) );
	vec3  kD = ( vec3( 1.0 ) - kS ) * ( 1.0 - metalness );
	Fd *= kD;


	#if ( defined(USE_TX1) || defined(USE_TX2) )
		if ( deluxe_mapping > -1 )
		{
			Fs = CalcSpecular( specular.rgb, H, NH, NL, NE, LH, VH, roughness, baseUV, shadingFrame ) * deluxe_specular_scale;
		}
		else if ( deluxe_specular_scale != 0.0 )
		{
			Fs = CalcSpecular( specular.rgb, H, NH, NL, NE, LH, VH, roughness, baseUV, shadingFrame );
		}
	#else
		/* PBR with single texture (tx0): compute direct specular for glint support */
		Fs = CalcSpecular( specular.rgb, H, NH, NL, NE, LH, VH, roughness, baseUV, shadingFrame );
	#endif



	vec3 reflectance = Fd + Fs;

	vec3 directLighting = lightColor * reflectance * ( attenuation * NL );
	vec3 ambientContribution = ambientColor * diffuse.rgb * kD;
	vec3 diffuseIrradiance = vec3( 0.0 );
	if ( irradiance_texture_set >= 0 ) {
		diffuseIrradiance = CalcDiffuseIrradiance( N ) * diffuse.rgb * AO * kD;
	}
	vec3 iblSpec = vec3( 0.0 );
	if ( env_texture_set >= 0 ) {
		iblSpec = CalcIBLContribution( roughness, N, E, NE, specular.rgb * AO );
	}

	vec3 debugDir = reflect( -E, N );
	debugDir.y *= -1.0;
	int debugMode = int( pbrDebugMode.x + 0.5 );
	if ( debugMode != 0 ) {
		vec3 envDebugSample = vec3( 0.0 );
		vec3 irrDebugSample = vec3( 0.0 );
		if ( env_texture_set >= 0 ) {
			envDebugSample = textureLod( env_texture, debugDir, 0.0 ).rgb;
		}
		if ( irradiance_texture_set >= 0 ) {
			irrDebugSample = texture( irradiance_texture, debugDir ).rgb;
		}
		vec3 debugColor = vec3( 0.0 );
		if ( debugMode == 1 ) {
			debugColor = directLighting;
		} else if ( debugMode == 2 ) {
			debugColor = iblSpec;
		} else if ( debugMode == 3 ) {
			debugColor = diffuseIrradiance;
		} else if ( debugMode == 4 ) {
			debugColor = mix( envDebugSample, irrDebugSample, 0.5 );
		} else if ( debugMode == 5 ) {
			debugColor = vec3( log2( 1.0 + glintDebugD * 1000.0 ) );
		} else if ( debugMode == 6 ) {
			float lambdaNorm = max( pbrGlintParams1.x, 0.1 );
			debugColor = vec3( clamp( glintDebugLambda / lambdaNorm, 0.0, 1.0 ) );
		} else if ( debugMode == 7 ) {
			debugColor = vec3( clamp( abs( glintDebugComp ) * 10.0, 0.0, 1.0 ) );
		} else if ( debugMode == 8 ) {
			debugColor = vec3( clamp( glintDebugWeight, 0.0, 1.0 ) );
		}
		out_color = vec4( debugColor, 1.0 );
		return;
	}

	out_color.rgb = directLighting;
	out_color.rgb += ambientContribution;
	if ( irradiance_texture_set >= 0 ) {
		out_color.rgb += diffuseIrradiance;
	}
	if ( env_texture_set >= 0 ) {
		out_color.rgb += iblSpec;
	}

	// legacy approximation kept intentionally for Step 2 scope containment.
	// Step 2b pending: Disney clearcoat/sheen energy normalization.
	// clearcoat lobe
	if ( clearcoat_texture_set >= 0 ) {
		vec4 cc = texture( clearcoat_texture, frag_tex_coord0 );
		float ccStrength = cc.r * pbrClearcoatScale.x;
		float ccRoughness = clamp( cc.g * pbrClearcoatScale.y, 0.02, 1.0 );
		vec3 ccSpec = CalcSpecular( vec3(0.04), H, NH, NL, NE, LH, VH, ccRoughness, baseUV, shadingFrame );
		out_color.rgb += lightColor * ccSpec * ( attenuation * NL ) * ccStrength;
	}

	// legacy approximation kept intentionally for Step 2 scope containment.
	// Step 2b pending: Disney clearcoat/sheen energy normalization.
	// sheen term
	if ( sheen_texture_set >= 0 ) {
		vec3 sheenColor = texture( sheen_texture, frag_tex_coord0 ).rgb * pbrSheenScale.rgb;
		out_color.rgb += sheenColor * NL * 0.05;
	}

	// subsurface term (Burley-style wrap approximation)
	if ( subsurfaceStrength > 0.0 ) {
		out_color.rgb += lightColor * CalcBurleySubsurface( N, L, subsurfaceColor, subsurfaceStrength, subsurfaceWrap ) * attenuation;
	}

	// transmission term
	if ( transmission_texture_set >= 0 ) {
		float transmission = texture( transmission_texture, frag_tex_coord0 ).r * pbrTransmissionScale.x;
		float transmitFactor = transmission * ( 1.0 - roughness );
		diffuse.rgb *= ( 1.0 - transmitFactor );
		out_color.rgb += lightColor * diffuse.rgb * ( attenuation * NL ) * transmitFactor;
	}
	
	out_color.rgb += emissive;
	
	out_color.a = diffuse.a;
#else
	out_color = base;
#endif
#endif
}
