#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D velocityBuffer;
layout(set = 0, binding = 1) uniform sampler2D depthBuffer;

layout(set = 0, binding = 2, rg16f) uniform writeonly image2D velocityTiles;

layout(push_constant) uniform VelocityTilesConstants {
    vec2 tileResolution; // Resolution of the tile texture
    vec2 invTileResolution;
    vec2 pixelsPerTile; // How many pixels per tile
    vec2 invPixelsPerTile;
} pc;

void main()
{
    ivec2 tileCoord = ivec2(gl_GlobalInvocationID.xy);
    if (tileCoord.x >= int(pc.tileResolution.x) || tileCoord.y >= int(pc.tileResolution.y)) {
        return;
    }

    // Find the maximum velocity in this tile
    vec2 maxVelocity = vec2(0.0);
    float maxVelocityMagnitude = 0.0;

    // Sample multiple pixels within this tile
    vec2 tileStart = vec2(tileCoord) * pc.pixelsPerTile;
    ivec2 tileStartInt = ivec2(tileStart);
    ivec2 tileEndInt = ivec2(tileStart + pc.pixelsPerTile);

    for (int y = tileStartInt.y; y < tileEndInt.y; y++) {
        for (int x = tileStartInt.x; x < tileEndInt.x; x++) {
            vec2 pixelUV = (vec2(x, y) + 0.5) * pc.invPixelsPerTile / pc.tileResolution;
            pixelUV = clamp(pixelUV, vec2(0.0), vec2(1.0));

            vec2 velocity = texture(velocityBuffer, pixelUV).xy;
            float magnitude = length(velocity);

            if (magnitude > maxVelocityMagnitude) {
                maxVelocity = velocity;
                maxVelocityMagnitude = magnitude;
            }
        }
    }

    // Store the maximum velocity for this tile
    imageStore(velocityTiles, tileCoord, vec4(maxVelocity, 0.0, 1.0));
}
