#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D colorBuffer;
layout(set = 0, binding = 1) uniform sampler2D depthBuffer;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D raysImage;

layout(push_constant) uniform GodRaysConstants {
    vec2 lightPos;           // Screen space light position (0-1)
    vec3 lightColor;         // Light color
    float lightIntensity;    // Light intensity
    float density;           // Scattering density
    float weight;            // Weight factor
    float decay;             // Decay factor
    float exposure;          // Exposure adjustment
    int numSamples;          // Number of radial samples
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 resolution = vec2(imageSize(raysImage));
    if (pixel.x >= int(resolution.x) || pixel.y >= int(resolution.y)) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / resolution;
    vec2 deltaUV = uv - pc.lightPos;

    // Calculate ray direction from pixel to light
    float rayLength = length(deltaUV);
    vec2 rayDir = normalize(deltaUV);

    // Sample color at current pixel
    vec4 color = texture(colorBuffer, uv);

    // Early exit if no significant color
    if (dot(color.rgb, vec3(0.299, 0.587, 0.114)) < 0.1) {
        imageStore(raysImage, pixel, vec4(0.0));
        return;
    }

    // Radial blur effect
    vec3 raysColor = vec3(0.0);
    float illuminationDecay = 1.0;

    // Sample along the ray from light to pixel
    for (int i = 0; i < pc.numSamples; i++) {
        vec2 sampleUV = pc.lightPos + rayDir * (float(i) / float(pc.numSamples)) * rayLength;

        // Skip if outside screen bounds
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {
            continue;
        }

        // Sample color along the ray
        vec4 sampleColor = texture(colorBuffer, sampleUV);

        // Apply decay
        sampleColor.rgb *= illuminationDecay;

        // Accumulate
        raysColor += sampleColor.rgb;

        // Update decay
        illuminationDecay *= pc.decay;
    }

    // Average the samples
    raysColor /= float(pc.numSamples);

    // Apply density and weight
    raysColor *= pc.density * pc.weight * pc.lightIntensity;

    // Apply light color
    raysColor *= pc.lightColor;

    // Apply exposure
    raysColor *= pc.exposure;

    // Store result
    imageStore(raysImage, pixel, vec4(raysColor, 1.0));
}