#version 450
/*
 * Neural Visibility Cache — per-pixel visibility + disocclusion hints for ReSTIR-style sampling.
 * Depth/normal features + tiny MLP; output RGBA16F: vis, confidence, disocclusion, motion proxy.
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(std430, set = 0, binding = 2) readonly buffer NvcWeights {
	float data[];
} weights;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D cacheOut;

layout(push_constant) uniform NvcCachePush {
	vec4 extent;
	vec4 featureHidden;
	uint useGBufferNormal;
	uint hasGBuffer;
	uint pad0;
	uint pad1;
} pc;

float relu(float x) { return max(x, 0.0); }
float sigmoid(float x) { return 1.0 / (1.0 + exp(-x)); }

float mlpVis(vec4 feat) {
	int h = int(pc.featureHidden.y);
	int f = int(pc.featureHidden.x);
	float hidden[16];
	int wBase = 0;
	int i;
	float sum;

	for (i = 0; i < 16; i++) {
		hidden[i] = 0.0;
	}
	for (i = 0; i < h && i < 16; i++) {
		sum = weights.data[wBase + h * f + i];
		int j;
		for (j = 0; j < f && j < 4; j++) {
			sum += weights.data[wBase + i * f + j] * feat[j];
		}
		hidden[i] = relu(sum);
	}
	wBase += h * f + h;
	sum = weights.data[wBase];
	for (i = 0; i < h && i < 16; i++) {
		sum += weights.data[wBase + 1 + i] * hidden[i];
	}
	return sigmoid(sum);
}

vec3 decodeNormal(vec2 uv) {
	if (pc.hasGBuffer != 0u && pc.useGBufferNormal != 0u) {
		vec3 n = texture(normalTex, uv).xyz * 2.0 - 1.0;
		float len = length(n);
		if (len > 0.01) {
			return n / len;
		}
	}
	vec2 texel = 1.0 / pc.extent.xy;
	float dL = texture(depthTex, uv + vec2(-texel.x, 0.0)).r;
	float dR = texture(depthTex, uv + vec2(texel.x, 0.0)).r;
	float dD = texture(depthTex, uv + vec2(0.0, -texel.y)).r;
	float dU = texture(depthTex, uv + vec2(0.0, texel.y)).r;
	vec3 dpdx = vec3(texel.x * 2.0, 0.0, dR - dL);
	vec3 dpdy = vec3(0.0, texel.y * 2.0, dU - dD);
	return normalize(cross(dpdx, dpdy));
}

float depthEdge(vec2 uv) {
	vec2 texel = 1.0 / pc.extent.xy;
	float d = texture(depthTex, uv).r;
	float e = 0.0;
	e = max(e, abs(d - texture(depthTex, uv + vec2(texel.x, 0.0)).r));
	e = max(e, abs(d - texture(depthTex, uv + vec2(-texel.x, 0.0)).r));
	e = max(e, abs(d - texture(depthTex, uv + vec2(0.0, texel.y)).r));
	e = max(e, abs(d - texture(depthTex, uv + vec2(0.0, -texel.y)).r));
	return e;
}

void main() {
	uvec2 pix = gl_GlobalInvocationID.xy;
	if (pix.x >= uint(pc.extent.x) || pix.y >= uint(pc.extent.y)) {
		return;
	}

	vec2 uv = (vec2(pix) + 0.5) / pc.extent.xy;
	float depth = texture(depthTex, uv).r;

	if (depth <= 0.0 || depth >= 1.0) {
		imageStore(cacheOut, ivec2(pix), vec4(0.0));
		return;
	}

	vec3 N = decodeNormal(uv);
	float dEdge = depthEdge(uv);
	float ndotV = clamp(dot(N, vec3(0.0, 0.0, 1.0)), 0.0, 1.0);
	float disocclusion = clamp(dEdge * 32.0, 0.0, 1.0);

	vec4 feat = vec4(
		clamp(dEdge * 8.0, 0.0, 1.0),
		ndotV,
		1.0 - ndotV,
		disocclusion);

	float vis = mlpVis(feat);
	float confidence = clamp(1.0 - disocclusion * 0.85, 0.05, 1.0) * vis;
	float motionProxy = disocclusion * (1.0 - confidence);

	imageStore(cacheOut, ivec2(pix), vec4(vis, confidence, disocclusion, motionProxy));
}
