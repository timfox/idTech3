#version 450

/*
 * External force injection compute shader.
 *
 * Adds velocity and density from emitters into the simulation grid.
 * Also applies global forces like wind and buoyancy.
 *
 * Emitter data is passed via a storage buffer containing position,
 * radius, density, temperature, and velocity for each emitter.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, rgba16f) uniform image3D velocity;
layout(binding = 1, r16f)    uniform image3D density;
layout(binding = 2, r16f)    uniform image3D temperature;

struct Emitter {
	vec4 posRadius;
	vec4 densTemp;
	vec4 velocity;
};

layout(std430, binding = 3) readonly buffer EmitterBuffer {
	int numEmitters;
	int pad0;
	int pad1;
	int pad2;
	Emitter emitters[];
};

layout(push_constant) uniform Params {
	float dt;
	float buoyancy;
	float ambientTemp;
	int   gridSize;
	vec4  wind;
} params;

void main() {
	ivec3 gid = ivec3(gl_GlobalInvocationID);
	int N = params.gridSize;

	if (any(greaterThanEqual(gid, ivec3(N)))) {
		return;
	}

	vec3 cellPos = (vec3(gid) + 0.5) / float(N);
	vec4 vel = imageLoad(velocity, gid);
	float dens = imageLoad(density, gid).r;
	float temp = imageLoad(temperature, gid).r;

	for (int i = 0; i < numEmitters && i < 16; i++) {
		vec3 ePos = emitters[i].posRadius.xyz;
		float eRadius = emitters[i].posRadius.w;
		float eDensity = emitters[i].densTemp.x;
		float eTemp = emitters[i].densTemp.y;
		vec3 eVel = emitters[i].velocity.xyz;

		float dist = length(cellPos - ePos);
		float falloff = max(1.0 - dist / max(eRadius, 0.001), 0.0);
		falloff = falloff * falloff;

		vel.xyz += eVel * falloff * params.dt;
		dens += eDensity * falloff * params.dt;
		temp += eTemp * falloff * params.dt;
	}

	vel.xyz += params.wind.xyz * params.dt;

	float buoyancyForce = params.buoyancy * (temp - params.ambientTemp);
	vel.y += buoyancyForce * params.dt;

	imageStore(velocity, gid, vel);
	imageStore(density, gid, vec4(dens));
	imageStore(temperature, gid, vec4(temp));
}
