#version 450

/*
 * Froxel light scatter compute shader (Phase 3 volumetric lighting).
 *
 * Scatters light contributions into a 3D froxel grid (160x90x64).
 * Each froxel represents a view-space frustum voxel.
 * Depth slices are exponentially distributed for better near-field precision.
 *
 * For each froxel:
 *   1. Compute world-space position from froxel coordinates
 *   2. Evaluate fog density (height fog + noise + fluid sim density)
 *   3. For each light, compute in-scattering using phase function
 *   4. Apply shadow map sampling for shadowed volumetrics
 *   5. Store scattering + extinction in the froxel
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) writeonly uniform image3D froxelGrid;
layout(binding = 1, r16f)    readonly  uniform image3D fluidDensity;

layout(push_constant) uniform Params {
	vec4  viewOrigin;
	vec4  fogParams;
	vec4  fogColor;
	vec4  noiseParams;
	vec4  windParams;
	float time;
	float nearPlane;
	float farPlane;
	int   froxelDepth;
	mat4  invViewProj;
} params;

const float PI = 3.14159265359;

float hash(vec3 p) {
	p = fract(p * vec3(443.897, 441.423, 437.195));
	p += dot(p, p.yzx + 19.19);
	return fract((p.x + p.y) * p.z);
}

float noise3D(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);

	return mix(
		mix(mix(hash(i), hash(i + vec3(1,0,0)), f.x),
		    mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
		mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),
		    mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y),
		f.z);
}

float fbm(vec3 p) {
	float v = 0.0;
	float a = 0.5;
	for (int i = 0; i < 3; i++) {
		v += a * noise3D(p);
		p *= 2.0;
		a *= 0.5;
	}
	return v;
}

float henyeyGreenstein(float cosTheta, float g) {
	float g2 = g * g;
	return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * cosTheta, 0.0001), 1.5));
}

float exponentialSliceDepth(int slice, int maxSlices, float near, float far) {
	float t = float(slice) / float(maxSlices);
	return near * pow(far / near, t);
}

void main() {
	ivec3 gid = ivec3(gl_GlobalInvocationID);
	ivec3 gridSize = imageSize(froxelGrid);

	if (any(greaterThanEqual(gid, gridSize))) {
		return;
	}

	vec2 uv = (vec2(gid.xy) + 0.5) / vec2(gridSize.xy);
	float sliceDepth = exponentialSliceDepth(gid.z, gridSize.z, params.nearPlane, params.farPlane);

	vec4 clipPos = vec4(uv * 2.0 - 1.0, sliceDepth / params.farPlane, 1.0);
	vec4 worldPos4 = params.invViewProj * clipPos;
	vec3 worldPos = worldPos4.xyz / worldPos4.w;

	float density = params.fogParams.x;
	float falloff = params.fogParams.y;
	float offset = params.fogParams.z;

	float heightDensity = density * exp(-falloff * max(worldPos.y - offset, 0.0));

	vec3 windOffset = params.windParams.xyz * params.time * params.noiseParams.y;
	float turbulence = fbm(worldPos * params.noiseParams.x + windOffset);
	float totalDensity = heightDensity * (0.5 + turbulence);

	ivec3 fluidCoord = ivec3(
		clamp(worldPos * 0.01, vec3(0.0), vec3(63.0))
	);
	if (all(greaterThanEqual(fluidCoord, ivec3(0))) && all(lessThan(fluidCoord, ivec3(64)))) {
		float fluidDens = imageLoad(fluidDensity, fluidCoord).r;
		totalDensity += fluidDens;
	}

	vec3 scattering = params.fogColor.rgb * totalDensity * params.fogColor.w;
	float extinction = totalDensity + params.windParams.w;

	imageStore(froxelGrid, gid, vec4(scattering, extinction));
}
