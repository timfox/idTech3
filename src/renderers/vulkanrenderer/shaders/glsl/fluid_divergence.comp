 *
 * Divergence computation for pressure projection.
 *
 * Computes the divergence of the velocity field:
 *   div(v) = (v[i+1].x - v[i-1].x + v[j+1].y - v[j-1].y + v[k+1].z - v[k-1].z) / (2*h)
 *
 * This is the right-hand side of the pressure Poisson equation:
 *   Laplacian(p) = div(v)
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, rgba16f) readonly uniform image3D velocity;
layout(binding = 1, r16f)    writeonly uniform image3D divergence;

layout(push_constant) uniform Params {
	float gridScale;
	int   gridSize;
	float pad0;
	float pad1;
} params;

void main() {
	ivec3 gid = ivec3(gl_GlobalInvocationID);
	int N = params.gridSize;

	if (any(greaterThanEqual(gid, ivec3(N)))) {
		return;
	}

	ivec3 left  = ivec3(max(gid.x - 1, 0),   gid.y, gid.z);
	ivec3 right = ivec3(min(gid.x + 1, N-1),  gid.y, gid.z);
	ivec3 down  = ivec3(gid.x, max(gid.y - 1, 0),   gid.z);
	ivec3 up    = ivec3(gid.x, min(gid.y + 1, N-1),  gid.z);
	ivec3 back  = ivec3(gid.x, gid.y, max(gid.z - 1, 0));
	ivec3 front = ivec3(gid.x, gid.y, min(gid.z + 1, N-1));

	float vR = imageLoad(velocity, right).x;
	float vL = imageLoad(velocity, left).x;
	float vU = imageLoad(velocity, up).y;
	float vD = imageLoad(velocity, down).y;
	float vF = imageLoad(velocity, front).z;
	float vB = imageLoad(velocity, back).z;

	float div = -0.5 * params.gridScale * (vR - vL + vU - vD + vF - vB);

	imageStore(divergence, gid, vec4(div));
}
