 *
 * Gradient subtraction compute shader.
 *
 * Enforces the incompressibility constraint by subtracting the
 * pressure gradient from the velocity field:
 *   v = v - gradient(p)
 *
 * After this step, the velocity field is divergence-free:
 *   div(v) ≈ 0
 *
 * This is the final step of the Helmholtz-Hodge decomposition
 * that projects the velocity field onto its divergence-free component.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, rgba16f) uniform image3D velocity;
layout(binding = 1, r16f)    readonly uniform image3D pressure;

layout(push_constant) uniform Params {
	float gridScale;
	int   gridSize;
	float pad0;
	float pad1;
} params;

void main() {
	ivec3 gid = ivec3(gl_GlobalInvocationID);
	int N = params.gridSize;

	if (any(greaterThanEqual(gid, ivec3(N)))) {
		return;
	}

	float pL = imageLoad(pressure, ivec3(max(gid.x - 1, 0),   gid.y, gid.z)).r;
	float pR = imageLoad(pressure, ivec3(min(gid.x + 1, N-1),  gid.y, gid.z)).r;
	float pD = imageLoad(pressure, ivec3(gid.x, max(gid.y - 1, 0),   gid.z)).r;
	float pU = imageLoad(pressure, ivec3(gid.x, min(gid.y + 1, N-1),  gid.z)).r;
	float pB = imageLoad(pressure, ivec3(gid.x, gid.y, max(gid.z - 1, 0))).r;
	float pF = imageLoad(pressure, ivec3(gid.x, gid.y, min(gid.z + 1, N-1))).r;

	vec3 gradient = vec3(pR - pL, pU - pD, pF - pB) * 0.5 / params.gridScale;

	vec4 vel = imageLoad(velocity, gid);
	vel.xyz -= gradient;
	imageStore(velocity, gid, vel);
}
