 *
 * Semi-Lagrangian advection compute shader for Navier-Stokes simulation.
 *
 * For each grid cell, traces back along the velocity field by -dt,
 * samples the quantity at that position using trilinear interpolation,
 * and stores it as the new value. This approach is unconditionally stable
 * regardless of time step size (Jos Stam, "Stable Fluids" 1999).
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, rgba16f) uniform image3D velocityIn;
layout(binding = 1, rgba16f) uniform image3D velocityOut;
layout(binding = 2, r16f)    uniform image3D densityIn;
layout(binding = 3, r16f)    uniform image3D densityOut;

layout(push_constant) uniform Params {
	float dt;
	float dissipation;
	float gridScale;
	int   gridSize;
} params;

vec4 sampleTrilinear(layout(rgba16f) image3D img, vec3 pos) {
	vec3 clamped = clamp(pos, vec3(0.5), vec3(float(params.gridSize) - 0.5));
	ivec3 i0 = ivec3(floor(clamped - 0.5));
	ivec3 i1 = i0 + 1;
	i0 = clamp(i0, ivec3(0), ivec3(params.gridSize - 1));
	i1 = clamp(i1, ivec3(0), ivec3(params.gridSize - 1));

	vec3 f = fract(clamped - 0.5);

	vec4 c000 = imageLoad(img, i0);
	vec4 c100 = imageLoad(img, ivec3(i1.x, i0.y, i0.z));
	vec4 c010 = imageLoad(img, ivec3(i0.x, i1.y, i0.z));
	vec4 c110 = imageLoad(img, ivec3(i1.x, i1.y, i0.z));
	vec4 c001 = imageLoad(img, ivec3(i0.x, i0.y, i1.z));
	vec4 c101 = imageLoad(img, ivec3(i1.x, i0.y, i1.z));
	vec4 c011 = imageLoad(img, ivec3(i0.x, i1.y, i1.z));
	vec4 c111 = imageLoad(img, i1);

	vec4 c00 = mix(c000, c100, f.x);
	vec4 c10 = mix(c010, c110, f.x);
	vec4 c01 = mix(c001, c101, f.x);
	vec4 c11 = mix(c011, c111, f.x);

	vec4 c0 = mix(c00, c10, f.y);
	vec4 c1 = mix(c01, c11, f.y);

	return mix(c0, c1, f.z);
}

float sampleTrilinearScalar(layout(r16f) image3D img, vec3 pos) {
	vec3 clamped = clamp(pos, vec3(0.5), vec3(float(params.gridSize) - 0.5));
	ivec3 i0 = ivec3(floor(clamped - 0.5));
	ivec3 i1 = i0 + 1;
	i0 = clamp(i0, ivec3(0), ivec3(params.gridSize - 1));
	i1 = clamp(i1, ivec3(0), ivec3(params.gridSize - 1));

	vec3 f = fract(clamped - 0.5);

	float c000 = imageLoad(img, i0).r;
	float c100 = imageLoad(img, ivec3(i1.x, i0.y, i0.z)).r;
	float c010 = imageLoad(img, ivec3(i0.x, i1.y, i0.z)).r;
	float c110 = imageLoad(img, ivec3(i1.x, i1.y, i0.z)).r;
	float c001 = imageLoad(img, ivec3(i0.x, i0.y, i1.z)).r;
	float c101 = imageLoad(img, ivec3(i1.x, i0.y, i1.z)).r;
	float c011 = imageLoad(img, ivec3(i0.x, i1.y, i1.z)).r;
	float c111 = imageLoad(img, i1).r;

	float c00 = mix(c000, c100, f.x);
	float c10 = mix(c010, c110, f.x);
	float c01 = mix(c001, c101, f.x);
	float c11 = mix(c011, c111, f.x);

	float c0 = mix(c00, c10, f.y);
	float c1 = mix(c01, c11, f.y);

	return mix(c0, c1, f.z);
}

void main() {
	ivec3 gid = ivec3(gl_GlobalInvocationID);

	if (any(greaterThanEqual(gid, ivec3(params.gridSize)))) {
		return;
	}

	vec3 pos = vec3(gid) + 0.5;
	vec4 velocity = imageLoad(velocityIn, gid);

	vec3 backPos = pos - params.dt * velocity.xyz / params.gridScale;

	vec4 newVelocity = sampleTrilinear(velocityIn, backPos) * params.dissipation;
	imageStore(velocityOut, gid, newVelocity);

	float newDensity = sampleTrilinearScalar(densityIn, backPos) * params.dissipation;
	imageStore(densityOut, gid, vec4(newDensity));
}
