#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(binding = 0, rgba16f) uniform writeonly image3D froxelVolume;
layout(binding = 1, rgba16f) uniform readonly image3D froxelHistory;
layout(binding = 2) uniform sampler2D depthTexture;

layout(std140, binding = 3) uniform VolumetricParams {
	mat4 invProj;
	mat4 invView;
	mat4 prevView;
	mat4 prevProj;
	vec4 viewOrigin;
	vec4 sunDirection;
	vec4 fogColor;
	vec4 densityParams;
	vec4 sliceParams;
	vec4 prevSliceParams;
	vec4 resolution;
	vec4 jitter;
	vec4 misc;
	vec4 fogMin;
	vec4 fogMax;
	vec4 froxelDim;
	vec4 phaseParams;
} params;

const float PI = 3.14159265359;

float phaseHG(float cosTheta, float g) {
	float gg = g * g;
	float denom = max(1.0 + gg - 2.0 * g * cosTheta, 1e-5);
	return (1.0 - gg) / (4.0 * PI * pow(denom, 1.5));
}

vec3 reconstructViewRay(vec2 uv) {
	vec4 clip = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
	vec4 view = params.invProj * clip;
	return view.xyz / max(abs(view.w), 1e-6);
}

float decodeClipZ(float depthSample, int depthMode) {
	if ( depthMode == 0 ) {
		return depthSample * 2.0 - 1.0;
	}
	if ( depthMode == 1 ) {
		return (1.0 - depthSample) * 2.0 - 1.0;
	}
	return 0.0;
}

float reconstructSceneDepth(vec2 uv, float depthSample, int depthMode, float nearPlane, float farPlane) {
	if ( depthMode == 2 ) {
		return clamp(depthSample, nearPlane, farPlane);
	}
	vec4 clip = vec4(uv * 2.0 - 1.0, decodeClipZ(depthSample, depthMode), 1.0);
	vec4 view = params.invProj * clip;
	vec3 viewPos = view.xyz / max(abs(view.w), 1e-6);
	return clamp(max(-viewPos.z, nearPlane), nearPlane, farPlane);
}

bool boundsValid(out vec3 extent) {
	extent = params.fogMax.xyz - params.fogMin.xyz;
	return all(greaterThan(extent, vec3(1e-4)));
}

vec4 computeLegacyValue(ivec3 idx, ivec3 dim, int depthMode) {
	vec2 uv = (vec2(idx.xy) + vec2(0.5)) / vec2(dim.xy);
	float sliceNormalized = (float(idx.z) + 0.5) / max(float(dim.z), 1.0);
	vec3 viewRay = reconstructViewRay(uv);
	vec3 viewDir = normalize(viewRay);

	float viewDepthZ = params.sliceParams.x * exp(sliceNormalized * params.sliceParams.z);
	float invZ = 1.0 / max(-viewRay.z, 1e-4);
	vec3 viewPos = viewRay * (viewDepthZ * invZ);
	vec4 worldPos4 = params.invView * vec4(viewPos, 1.0);
	vec3 worldPos = worldPos4.xyz / max(abs(worldPos4.w), 1e-6);

	float sceneDepth = reconstructSceneDepth(uv, texture(depthTexture, uv).r, depthMode, params.sliceParams.x, params.sliceParams.y);
	bool occluded = viewDepthZ > sceneDepth;

	float heightDelta = worldPos.z - params.viewOrigin.w;
	float heightFalloff = max(0.0, params.densityParams.y);
	float density = max(0.0, params.densityParams.x) * exp(-heightFalloff * max(0.0, heightDelta));
	if ( occluded ) {
		density = 0.0;
	}

	float g = clamp(params.phaseParams.x, -0.999, 0.999);
	float cosTheta = dot(normalize(params.sunDirection.xyz), -viewDir);
	float phase = phaseHG(cosTheta, g);
	vec3 ambient = params.fogColor.rgb * params.phaseParams.z;
	vec3 directional = params.fogColor.rgb * params.phaseParams.y * phase;
	vec3 inscatter = (ambient + directional) * density * params.fogColor.a;
	return vec4(inscatter, density);
}

vec4 computeWorldValue(ivec3 idx, ivec3 dim, vec3 extent) {
	vec3 cell = (vec3(idx) + vec3(0.5)) / vec3(dim);
	vec3 worldPos = params.fogMin.xyz + cell * extent;
	vec3 rel = worldPos - params.viewOrigin.xyz;
	float heightDelta = worldPos.z - params.viewOrigin.w;
	float heightFalloff = max(0.0, params.densityParams.y);
	float density = max(0.0, params.densityParams.x) * exp(-heightFalloff * max(0.0, heightDelta));

	float relLen = max(length(rel), 1e-4);
	vec3 rayDir = rel / relLen;
	float g = clamp(params.phaseParams.x, -0.999, 0.999);
	float cosTheta = dot(normalize(params.sunDirection.xyz), -rayDir);
	float phase = phaseHG(cosTheta, g);
	vec3 ambient = params.fogColor.rgb * params.phaseParams.z;
	vec3 directional = params.fogColor.rgb * params.phaseParams.y * phase;
	vec3 inscatter = (ambient + directional) * density * params.fogColor.a;

	return vec4(inscatter, density);
}

void main() {
	ivec3 idx = ivec3(gl_GlobalInvocationID);
	ivec3 dim = ivec3(max(params.froxelDim.xyz, vec3(1.0)));
	int depthMode = int(clamp(floor(params.misc.y + 0.5), 0.0, 2.0));
	int froxelDebug = int(clamp(floor(params.phaseParams.w + 0.5), 0.0, 2.0));
	vec3 extent;
	bool useWorldGrid = boundsValid(extent);

	if ( any(greaterThanEqual(idx, dim)) ) {
		return;
	}

	if ( froxelDebug == 1 ) {
		vec3 uvw = (vec3(idx) + vec3(0.5)) / vec3(dim);
		imageStore(froxelVolume, idx, vec4(uvw, 1.0));
		return;
	}
	if ( froxelDebug == 2 ) {
		imageStore(froxelVolume, idx, vec4(params.fogColor.rgb * 0.05, 0.05));
		return;
	}

	vec4 current = useWorldGrid ? computeWorldValue(idx, dim, extent) : computeLegacyValue(idx, dim, depthMode);

	vec4 history = vec4(0.0);
	bool hasHistory = params.misc.w > 0.5;
	float temporal = clamp(params.densityParams.w, 0.0, 1.0);
	bool doTemporal = hasHistory && temporal > 0.0;
	if ( doTemporal ) {
		history = imageLoad(froxelHistory, idx);
	}

	vec4 finalValue = current;
	if ( doTemporal ) {
		vec4 blended = mix(current, history, temporal);
		vec4 diff = blended - history;
		diff = clamp(diff, -0.25, 0.25);
		finalValue = history + diff;
	}

	imageStore(froxelVolume, idx, finalValue);
}
