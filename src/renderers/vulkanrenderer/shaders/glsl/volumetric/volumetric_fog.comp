#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(binding = 0, rgba16f) uniform image3D froxelScattering;
layout(binding = 1, rgba16f) uniform readonly image3D froxelHistory;
layout(binding = 2) uniform sampler2D depthTexture;
layout(binding = 4) uniform sampler3D fogNoiseTexture;
layout(binding = 5) uniform sampler2D sunShadowMap;
layout(binding = 6, rgba16f) uniform image3D froxelLight;
layout(binding = 7, r16f) uniform image3D froxelExtinction;
layout(binding = 8, rgba16f) uniform image3D froxelClamp;
layout(binding = 9) uniform sampler2D motionTexture;
layout(binding = 10) uniform sampler2D localSpotShadowMap;
layout(binding = 11) uniform sampler2DArray localPointShadowMap;

const int MAX_VOLUMES = 24;
const int MAX_LIGHTS = 32;
const float PI = 3.14159265359;

const int STAGE_CLEAR = 0;
const int STAGE_GLOBAL_DENSITY = 1;
const int STAGE_VOLUME_DENSITY = 2;
const int STAGE_LOCAL_LIGHT = 3;
const int STAGE_SUN_LIGHT = 4;
const int STAGE_CLAMP_LEVEL0 = 5;
const int STAGE_CLAMP_LEVEL1 = 6;
const int STAGE_TEMPORAL = 7;

#define USE_VOLUME_RESTIR 0
struct VolumeReservoir {
    vec3 radiance;
    float weight;
};

layout(std140, binding = 3) uniform VolumetricParams {
    mat4 invProj;
    mat4 invView;
    mat4 proj;
    mat4 viewProj;
    mat4 prevView;
    mat4 prevViewProj;
    vec4 viewOrigin;
    vec4 sunDirection;
    vec4 fogColor;
    vec4 densityParams;
    vec4 worldMin;
    vec4 worldMax;
    vec4 gridDim;
    vec4 miscParams;
    vec4 sliceParams;
    vec4 phaseParams;
    vec4 noiseParams;
    vec4 noiseScroll;
    vec4 temporalParams;
    vec4 qualityParams;
    vec4 windParams;
    vec4 volumeCounts;
    vec4 passParams;
    vec4 volumeBoundsMin[MAX_VOLUMES];
    vec4 volumeBoundsMax[MAX_VOLUMES];
    vec4 volumeColorDensity[MAX_VOLUMES];
    vec4 lightPosRadius[MAX_LIGHTS];
    vec4 lightColorType[MAX_LIGHTS];
    vec4 lightDirAngle[MAX_LIGHTS];
    vec4 lightExtra[MAX_LIGHTS];
    mat4 sunShadowMatrix0;
    vec4 shadowParams0;
    vec4 shadowMapSize0;
    mat4 localSpotShadowMatrix[MAX_LIGHTS];
    mat4 localPointShadowMatrix[MAX_LIGHTS][6];
    vec4 localShadowAtlasUv[MAX_LIGHTS];
    vec4 localSpotShadowMapSize;
    vec4 localPointShadowMapSize;
} params;

float Saturate(float v) {
    return clamp(v, 0.0, 1.0);
}

float Luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float phaseHG(float cosTheta, float g) {
    float gg = g * g;
    float denom = max(1.0 + gg - 2.0 * g * cosTheta, 1e-5);
    return (1.0 - gg) / (4.0 * PI * pow(denom, 1.5));
}

float rand31(vec3 p) {
    vec3 q = fract(p * vec3(0.1031, 0.11369, 0.13787));
    q += dot(q, q.yzx + 19.19);
    return fract((q.x + q.y) * q.z);
}

float decodeClipZ(float depthSample, int depthMode) {
    if (depthMode == 0) {
        return depthSample * 2.0 - 1.0;
    }
    if (depthMode == 1) {
        return (1.0 - depthSample) * 2.0 - 1.0;
    }
    return 0.0;
}

float getNearPlane() {
    return max(params.sliceParams.x, 0.001);
}

float getFarPlane(float nearPlane) {
    return max(params.sliceParams.y, nearPlane + 1.0);
}

float getSliceExponent() {
    return max(params.sliceParams.z, 1.0);
}

float depthFromSliceNorm(float sliceNorm, float nearPlane, float farPlane) {
    float expNorm = pow(Saturate(sliceNorm), getSliceExponent());
    return nearPlane * pow(farPlane / nearPlane, expNorm);
}

float sliceNormFromDepth(float depth, float nearPlane, float farPlane) {
    float ratio = log(max(depth / nearPlane, 1e-4)) / max(log(farPlane / nearPlane), 1e-5);
    return pow(Saturate(ratio), 1.0 / getSliceExponent());
}

vec3 reconstructViewRay(vec2 uv) {
    vec4 clip = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec4 view = params.invProj * clip;
    return view.xyz / max(abs(view.w), 1e-6);
}

float reconstructSceneDepth(vec2 uv, float depthSample, int depthMode) {
    float nearPlane = getNearPlane();
    float farPlane = getFarPlane(nearPlane);

    if (depthMode == 2) {
        float linearDepth = depthSample;
        if (linearDepth <= 1.0) {
            linearDepth = mix(nearPlane, farPlane, Saturate(linearDepth));
        }
        return clamp(linearDepth, nearPlane, farPlane);
    }

    vec4 clip = vec4(uv * 2.0 - 1.0, decodeClipZ(depthSample, depthMode), 1.0);
    vec4 view = params.invProj * clip;
    vec3 viewPos = view.xyz / max(abs(view.w), 1e-6);
    return clamp(max(-viewPos.z, nearPlane), nearPlane, farPlane);
}

bool boundsValid(out vec3 extent) {
    extent = params.worldMax.xyz - params.worldMin.xyz;
    return all(greaterThan(extent, vec3(1e-4)));
}

bool ComputeFroxelSample(ivec3 idx, ivec3 dim, int depthMode, bool useBounds, vec3 boundsExtent, out vec3 worldPos, out vec3 viewDir, out float centerDepth) {
    float nearPlane = getNearPlane();
    float farPlane = getFarPlane(nearPlane);
    vec2 uv = (vec2(idx.xy) + 0.5) / vec2(dim.xy);

    float slice0 = float(idx.z) / float(dim.z);
    float slice1 = float(idx.z + 1) / float(dim.z);
    float zNear = depthFromSliceNorm(slice0, nearPlane, farPlane);
    float zFar = depthFromSliceNorm(slice1, nearPlane, farPlane);

    float jitter = rand31(vec3(vec2(idx.xy), float(idx.z) + params.miscParams.z * 0.6180339)) - 0.5;
    float depthMix = clamp(0.5 + jitter * max(params.densityParams.z, 0.0), 0.0, 1.0);
    centerDepth = mix(zNear, zFar, depthMix);

    float sceneDepth = reconstructSceneDepth(uv, texture(depthTexture, uv).r, depthMode);
    float maxDistance = max(params.sliceParams.w, nearPlane + 1.0);
    sceneDepth = min(sceneDepth, maxDistance);
    if (zNear >= sceneDepth) {
        return false;
    }

    viewDir = normalize(reconstructViewRay(uv));
    float viewDistance = centerDepth / max(-viewDir.z, 1e-4);
    vec3 viewPos = viewDir * viewDistance;
    worldPos = (params.invView * vec4(viewPos, 1.0)).xyz;

    if (useBounds) {
        vec3 uvw = (worldPos - params.worldMin.xyz) / boundsExtent;
        if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) {
            return false;
        }
    }

    return true;
}

float ComputeShadow(vec3 worldPos, out vec3 shadowUVW) {
    shadowUVW = vec3(0.0, 0.0, 1.0);

    if (params.shadowParams0.z < 0.5 || params.shadowParams0.w < 0.5) {
        return 1.0;
    }
    if (params.shadowMapSize0.z <= 0.0 || params.shadowMapSize0.w <= 0.0) {
        return 1.0;
    }

    vec4 lightClip = params.sunShadowMatrix0 * vec4(worldPos, 1.0);
    if (abs(lightClip.w) <= 1e-6) {
        return 1.0;
    }

    vec3 ndc = lightClip.xyz / lightClip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float depth = ndc.z * 0.5 + 0.5;
    shadowUVW = vec3(uv, depth);

    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || depth <= 0.0 || depth >= 1.0) {
        return 1.0;
    }

    float compareDepth = depth - max(params.shadowParams0.x, 0.0);
    vec2 texelStep = params.shadowMapSize0.zw * max(params.shadowParams0.y, 0.0);

    if (texelStep.x <= 0.0 || texelStep.y <= 0.0) {
        float sampleDepth = texture(sunShadowMap, uv).r;
        return (compareDepth <= sampleDepth) ? 1.0 : 0.0;
    }

    float lit = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 pcfUV = uv + vec2(x, y) * texelStep;
            float sampleDepth = texture(sunShadowMap, pcfUV).r;
            lit += (compareDepth <= sampleDepth) ? 1.0 : 0.0;
        }
    }
    return lit * (1.0 / 9.0);
}

float ComputeBaseDensity(vec3 worldPos) {
    float baseDensity = max(params.densityParams.x, 0.0);
    float heightFalloff = max(params.densityParams.y, 0.0);
    float heightDelta = worldPos.z - params.viewOrigin.w;
    float density = baseDensity * exp(-heightFalloff * max(0.0, heightDelta));

    float noiseScale = max(params.noiseParams.x, 0.0);
    float noiseThreshold = Saturate(params.noiseParams.y);
    float noiseStrength = Saturate(params.noiseParams.z);

    if (noiseScale > 0.0 && noiseStrength > 0.0) {
        vec3 wind = params.noiseScroll.xyz * max(params.windParams.z, 0.0);
        vec3 noiseUV = worldPos * noiseScale + wind * params.windParams.x;
        float noiseValue = texture(fogNoiseTexture, fract(noiseUV)).r;
        float noiseMask = clamp((noiseValue - noiseThreshold) / max(1.0 - noiseThreshold, 1e-4), 0.0, 1.0);
        density *= mix(1.0, noiseMask, noiseStrength);
    }

    return max(density, 0.0);
}

void ApplyVolumeDensity(vec3 worldPos, inout float density, inout vec3 mediumColor) {
    vec3 volumeColorAccum = vec3(0.0);
    float volumeWeight = 0.0;
    int volumeCount = int(clamp(floor(params.volumeCounts.x + 0.5), 0.0, float(MAX_VOLUMES)));

    for (int i = 0; i < MAX_VOLUMES; i++) {
        if (i >= volumeCount) {
            break;
        }
        vec3 bMin = params.volumeBoundsMin[i].xyz;
        vec3 bMax = params.volumeBoundsMax[i].xyz;
        if (all(greaterThanEqual(worldPos, bMin)) && all(lessThanEqual(worldPos, bMax))) {
            float d = max(params.volumeColorDensity[i].w, 0.0);
            density += d;
            volumeColorAccum += params.volumeColorDensity[i].rgb * d;
            volumeWeight += d;
        }
    }

    if (volumeWeight > 1e-4) {
        vec3 volumeColor = volumeColorAccum / volumeWeight;
        float t = Saturate(volumeWeight / max(density, 1e-4));
        mediumColor = mix(mediumColor, volumeColor, t);
    }
}

float SampleSpotShadow(vec3 worldPos, int lightIndex) {
    int shadowSlot = int(floor(params.lightExtra[lightIndex].w + 0.5));
    if (shadowSlot < 0) {
        return 1.0;
    }
    if (params.localSpotShadowMapSize.z <= 0.0 || params.localSpotShadowMapSize.w <= 0.0) {
        return 1.0;
    }

    vec4 lightClip = params.localSpotShadowMatrix[lightIndex] * vec4(worldPos, 1.0);
    if (abs(lightClip.w) <= 1e-6) {
        return 1.0;
    }

    vec4 atlasRect = params.localShadowAtlasUv[lightIndex];
    vec3 ndc = lightClip.xyz / lightClip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    vec2 atlasUV = uv * atlasRect.xy + atlasRect.zw;
    float depth = ndc.z * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || depth <= 0.0 || depth >= 1.0) {
        return 1.0;
    }
    if (any(lessThan(atlasUV, atlasRect.zw)) || any(greaterThan(atlasUV, atlasRect.zw + atlasRect.xy))) {
        return 1.0;
    }

    float compareDepth = depth - max(params.shadowParams0.x, 0.0);
    vec2 texelStep = params.localSpotShadowMapSize.zw * max(params.shadowParams0.y, 0.0);

    if (texelStep.x <= 0.0 || texelStep.y <= 0.0) {
        float sampleDepth = texture(localSpotShadowMap, atlasUV).r;
        return (compareDepth <= sampleDepth) ? 1.0 : 0.0;
    }

    float lit = 0.0;
    vec2 atlasMin = atlasRect.zw + texelStep * 0.5;
    vec2 atlasMax = atlasRect.zw + atlasRect.xy - texelStep * 0.5;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 pcfUV = clamp(atlasUV + vec2(x, y) * texelStep, atlasMin, atlasMax);
            float sampleDepth = texture(localSpotShadowMap, pcfUV).r;
            lit += (compareDepth <= sampleDepth) ? 1.0 : 0.0;
        }
    }
    return lit * (1.0 / 9.0);
}

int SelectPointShadowFace(vec3 dirFromLight) {
    vec3 a = abs(dirFromLight);
    if (a.x >= a.y && a.x >= a.z) {
        return (dirFromLight.x >= 0.0) ? 0 : 1;
    }
    if (a.y >= a.x && a.y >= a.z) {
        return (dirFromLight.y >= 0.0) ? 2 : 3;
    }
    return (dirFromLight.z >= 0.0) ? 4 : 5;
}

float SampleLightShadow(int lightIndex, vec3 worldPos) {
    float shadowType = params.lightExtra[lightIndex].z;

    if (shadowType < 0.5) {
        return 1.0;
    }

    if (shadowType < 1.5) {
        return SampleSpotShadow(worldPos, lightIndex);
    }

    int pointSlot = int(floor(params.lightExtra[lightIndex].w + 0.5));
    if (pointSlot < 0 || params.localPointShadowMapSize.z <= 0.0) {
        return 1.0;
    }

    vec3 fromLight = worldPos - params.lightPosRadius[lightIndex].xyz;
    int face = SelectPointShadowFace(fromLight);
    int layer = pointSlot * 6 + face;

    vec4 lightClip = params.localPointShadowMatrix[lightIndex][face] * vec4(worldPos, 1.0);
    if (abs(lightClip.w) <= 1e-6) {
        return 1.0;
    }

    vec3 ndc = lightClip.xyz / lightClip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float depth = ndc.z * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || depth <= 0.0 || depth >= 1.0) {
        return 1.0;
    }

    float compareDepth = depth - max(params.shadowParams0.x, 0.0);
    vec2 texelStep = vec2(params.localPointShadowMapSize.z) * max(params.shadowParams0.y, 0.0);

    if (texelStep.x <= 0.0) {
        float sampleDepth = texture(localPointShadowMap, vec3(uv, float(layer))).r;
        return (compareDepth <= sampleDepth) ? 1.0 : 0.0;
    }

    float lit = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 pcfUV = uv + vec2(x, y) * texelStep;
            float sampleDepth = texture(localPointShadowMap, vec3(pcfUV, float(layer))).r;
            lit += (compareDepth <= sampleDepth) ? 1.0 : 0.0;
        }
    }
    return lit * (1.0 / 9.0);
}

vec3 ComputeSunLighting(vec3 worldPos, vec3 viewDir, float density, vec3 mediumColor, float sunShadow) {
    float g = clamp(params.phaseParams.x, -0.999, 0.999);
    vec3 V = normalize(-viewDir);
    vec3 result = vec3(0.0);

    vec3 Ls = normalize(params.sunDirection.xyz);
    float sunPhase = phaseHG(dot(Ls, V), g);
    vec3 ambientTerm = mediumColor * max(params.phaseParams.z, 0.0);
    vec3 sunTerm = mediumColor * max(params.phaseParams.y, 0.0) * sunPhase * sunShadow;
    vec3 multiScatter = mediumColor * density * 0.25 * max(params.phaseParams.z, 0.0);
    result += ambientTerm + sunTerm + multiScatter;

    return result * density * max(params.fogColor.a, 0.0);
}

vec3 ComputeLocalLightScattering(vec3 worldPos, vec3 viewDir, float density, vec3 mediumColor, int lightIndex) {
    float g = clamp(params.phaseParams.x, -0.999, 0.999);
    vec3 V = normalize(-viewDir);
    vec3 result = vec3(0.0);

    if (lightIndex < 0 || lightIndex >= MAX_LIGHTS) {
        return vec3(0.0);
    }

    int lightCount = int(clamp(floor(params.volumeCounts.y + 0.5), 0.0, float(MAX_LIGHTS)));
    if (lightIndex >= lightCount) {
        return vec3(0.0);
    }

    vec3 lightPos = params.lightPosRadius[lightIndex].xyz;
    float radius = max(params.lightPosRadius[lightIndex].w, 0.001);
    vec3 toLight = lightPos - worldPos;
    float dist = length(toLight);
    if (dist >= radius) {
        return vec3(0.0);
    }

    vec3 L = toLight / max(dist, 1e-4);
    float attenuation = Saturate(1.0 - dist / radius);
    attenuation *= attenuation;

    float type = params.lightColorType[lightIndex].w;
    if (type > 0.5) {
        vec3 coneDir = normalize(params.lightDirAngle[lightIndex].xyz);
        float cosOuter = params.lightDirAngle[lightIndex].w;
        float cosInner = max(params.lightExtra[lightIndex].x, cosOuter + 1e-4);
        float cosTheta = dot(coneDir, -L);
        float spot = smoothstep(cosOuter, cosInner, cosTheta);
        float coneRange = max(params.lightExtra[lightIndex].y, 0.001);
        attenuation *= spot * Saturate(1.0 - dist / coneRange);
    }

    float localShadow = SampleLightShadow(lightIndex, worldPos);
    float phase = phaseHG(dot(L, V), g);
    vec3 lightColor = max(params.lightColorType[lightIndex].rgb, vec3(0.0));
    result += lightColor * (phase * attenuation * localShadow) * mediumColor;

    return result * density * max(params.fogColor.a, 0.0);
}

vec4 ApplyFireflyClamp(vec4 value) {
    float clampValue = max(params.temporalParams.z, 0.0);
    if (clampValue <= 0.0) {
        return value;
    }

    float lum = Luminance(value.rgb);
    if (lum > clampValue && lum > 1e-4) {
        value.rgb *= clampValue / lum;
    }
    return value;
}

ivec3 ReprojectHistoryIdx(ivec3 idx, ivec3 dim, vec3 worldPos, out bool valid, out vec2 motion, out float prevDepthOut) {
    valid = false;
    motion = vec2(0.0);
    prevDepthOut = 0.0;

    vec2 currentUV = (vec2(idx.xy) + 0.5) / vec2(dim.xy);
    motion = texture(motionTexture, currentUV).rg;
    vec2 prevUV = currentUV - motion;

    if (any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0)))) {
        return ivec3(0);
    }

    float nearPlane = getNearPlane();
    float farPlane = getFarPlane(nearPlane);
    vec3 prevViewPos = (params.prevView * vec4(worldPos, 1.0)).xyz;
    float prevDepth = clamp(-prevViewPos.z, nearPlane, farPlane);
    prevDepthOut = prevDepth;
    float prevSliceNorm = sliceNormFromDepth(prevDepth, nearPlane, farPlane);

    ivec3 prevIdx;
    prevIdx.x = clamp(int(prevUV.x * float(dim.x)), 0, dim.x - 1);
    prevIdx.y = clamp(int(prevUV.y * float(dim.y)), 0, dim.y - 1);
    prevIdx.z = clamp(int(prevSliceNorm * float(dim.z)), 0, dim.z - 1);
    valid = true;
    return prevIdx;
}

vec4 ClampHistoryByPyramid(ivec3 idx, ivec3 dim, vec4 historyValue) {
    ivec3 pyramidDim = ivec3(max((dim.x + 3) / 4, 1), max((dim.y + 3) / 4, 1), dim.z);
    ivec3 pyramidIdx = ivec3(min(idx.x / 4, pyramidDim.x - 1), min(idx.y / 4, pyramidDim.y - 1), idx.z);
    vec4 bounds = imageLoad(froxelLight, pyramidIdx);

    float minLum = bounds.x;
    float maxLum = max(bounds.y, minLum);
    float minSigma = max(bounds.z, 0.0);
    float maxSigma = max(bounds.w, minSigma);

    float histLum = Luminance(historyValue.rgb);
    float clampedLum = clamp(histLum, minLum, maxLum);
    if (histLum > 1e-4) {
        historyValue.rgb *= clampedLum / histLum;
    }
    historyValue.a = clamp(historyValue.a, minSigma, maxSigma);
    return historyValue;
}

vec4 ReprojectHistory(ivec3 idx, ivec3 dim, vec4 current, vec3 worldPos, float currentDepth) {
    bool hasHistory = params.miscParams.w > 0.5;
    float temporal = clamp(params.densityParams.w, 0.0, 1.0);
    if (!hasHistory || temporal <= 0.0 || params.temporalParams.w > 0.5) {
        return current;
    }

    bool valid;
    vec2 motion;
    float prevDepth;
    ivec3 prevIdx = ReprojectHistoryIdx(idx, dim, worldPos, valid, motion, prevDepth);
    if (!valid) {
        return current;
    }

    if (length(motion) > max(params.temporalParams.x, 0.0)) {
        return current;
    }

    float depthEps = max(params.temporalParams.y, 0.0);
    if (abs(prevDepth - currentDepth) > depthEps * max(currentDepth, 1.0)) {
        return current;
    }

    vec4 history = imageLoad(froxelHistory, prevIdx);
    history = ClampHistoryByPyramid(idx, dim, history);
    history = ApplyFireflyClamp(history);

    float change = length(current.rgb - history.rgb) + abs(current.a - history.a);
    float confidence = clamp(1.0 - change * 6.0, 0.0, 1.0);
    float historyWeight = temporal * confidence;
    return mix(current, history, historyWeight);
}

void main() {
    ivec3 idx = ivec3(gl_GlobalInvocationID);
    ivec3 dim = ivec3(max(params.gridDim.xyz, vec3(1.0)));
    if (any(greaterThanEqual(idx, dim))) {
        return;
    }

    int stage = int(clamp(floor(params.passParams.x + 0.5), 0.0, 7.0));
    int depthMode = int(clamp(floor(params.miscParams.y + 0.5), 0.0, 2.0));

    vec3 boundsExtent;
    bool useWorldGrid = boundsValid(boundsExtent);

    if (stage == STAGE_CLEAR) {
        imageStore(froxelScattering, idx, vec4(0.0));
        imageStore(froxelLight, idx, vec4(0.0));
        imageStore(froxelExtinction, idx, vec4(0.0));
        imageStore(froxelClamp, idx, vec4(0.0));
        return;
    }

    if (stage == STAGE_CLAMP_LEVEL0) {
        ivec3 levelDim = ivec3(max((dim.x + 1) / 2, 1), max((dim.y + 1) / 2, 1), dim.z);
        if (any(greaterThanEqual(idx, levelDim))) {
            return;
        }

        float minLum = 1e20;
        float maxLum = 0.0;
        float minSigma = 1e20;
        float maxSigma = 0.0;

        for (int oy = 0; oy < 2; ++oy) {
            for (int ox = 0; ox < 2; ++ox) {
                ivec3 srcIdx = ivec3(min(idx.x * 2 + ox, dim.x - 1), min(idx.y * 2 + oy, dim.y - 1), idx.z);
                vec3 scatter = imageLoad(froxelScattering, srcIdx).rgb;
                float sigma = imageLoad(froxelExtinction, srcIdx).x;
                float lum = Luminance(scatter);
                minLum = min(minLum, lum);
                maxLum = max(maxLum, lum);
                minSigma = min(minSigma, sigma);
                maxSigma = max(maxSigma, sigma);
            }
        }

        if (minLum > maxLum) {
            minLum = maxLum;
        }
        if (minSigma > maxSigma) {
            minSigma = maxSigma;
        }

        imageStore(froxelClamp, idx, vec4(minLum, maxLum, minSigma, maxSigma));
        return;
    }

    if (stage == STAGE_CLAMP_LEVEL1) {
        ivec3 srcDim = ivec3(max((dim.x + 1) / 2, 1), max((dim.y + 1) / 2, 1), dim.z);
        ivec3 dstDim = ivec3(max((srcDim.x + 1) / 2, 1), max((srcDim.y + 1) / 2, 1), dim.z);
        if (any(greaterThanEqual(idx, dstDim))) {
            return;
        }

        float minLum = 1e20;
        float maxLum = 0.0;
        float minSigma = 1e20;
        float maxSigma = 0.0;

        for (int oy = 0; oy < 2; ++oy) {
            for (int ox = 0; ox < 2; ++ox) {
                ivec3 srcIdx = ivec3(min(idx.x * 2 + ox, srcDim.x - 1), min(idx.y * 2 + oy, srcDim.y - 1), idx.z);
                vec4 bounds = imageLoad(froxelClamp, srcIdx);
                minLum = min(minLum, bounds.x);
                maxLum = max(maxLum, bounds.y);
                minSigma = min(minSigma, bounds.z);
                maxSigma = max(maxSigma, bounds.w);
            }
        }

        if (minLum > maxLum) {
            minLum = maxLum;
        }
        if (minSigma > maxSigma) {
            minSigma = maxSigma;
        }

        imageStore(froxelLight, idx, vec4(minLum, maxLum, minSigma, maxSigma));
        return;
    }

    vec3 worldPos;
    vec3 viewDir;
    float centerDepth;
    bool validSample = ComputeFroxelSample(idx, dim, depthMode, useWorldGrid, boundsExtent, worldPos, viewDir, centerDepth);

    if (stage == STAGE_GLOBAL_DENSITY) {
        if (!validSample) {
            imageStore(froxelExtinction, idx, vec4(0.0));
            imageStore(froxelLight, idx, vec4(params.fogColor.rgb, 1.0));
            return;
        }

        float density = ComputeBaseDensity(worldPos);
        imageStore(froxelExtinction, idx, vec4(density, 0.0, 0.0, 0.0));
        imageStore(froxelLight, idx, vec4(params.fogColor.rgb, 1.0));
        return;
    }

    if (stage == STAGE_VOLUME_DENSITY) {
        if (!validSample) {
            return;
        }

        float density = max(imageLoad(froxelExtinction, idx).x, 0.0);
        vec3 mediumColor = imageLoad(froxelLight, idx).rgb;
        ApplyVolumeDensity(worldPos, density, mediumColor);
        imageStore(froxelExtinction, idx, vec4(max(density, 0.0), 0.0, 0.0, 0.0));
        imageStore(froxelLight, idx, vec4(mediumColor, 1.0));
        return;
    }

    if (stage == STAGE_LOCAL_LIGHT) {
        if (!validSample) {
            return;
        }

        float density = max(imageLoad(froxelExtinction, idx).x, 0.0);
        if (density <= 0.0) {
            return;
        }

        int lightIndex = int(floor(params.passParams.y + 0.5));
        vec3 mediumColor = imageLoad(froxelLight, idx).rgb;
        vec3 scatter = ComputeLocalLightScattering(worldPos, viewDir, density, mediumColor, lightIndex);

        vec4 accum = imageLoad(froxelScattering, idx);
        accum.rgb += max(scatter, vec3(0.0));
        accum.a = density;
        imageStore(froxelScattering, idx, accum);
        return;
    }

    if (stage == STAGE_SUN_LIGHT) {
        if (!validSample) {
            return;
        }

        float density = max(imageLoad(froxelExtinction, idx).x, 0.0);
        if (density <= 0.0) {
            return;
        }

        vec3 mediumColor = imageLoad(froxelLight, idx).rgb;
        vec3 shadowUVW;
        float sunVis = ComputeShadow(worldPos, shadowUVW);
        vec3 scatter = ComputeSunLighting(worldPos, viewDir, density, mediumColor, sunVis);

        vec4 accum = imageLoad(froxelScattering, idx);
        accum.rgb += max(scatter, vec3(0.0));
        accum.a = density;
        imageStore(froxelScattering, idx, accum);
        return;
    }

    if (stage == STAGE_TEMPORAL) {
        vec4 current = imageLoad(froxelScattering, idx);
        current.a = max(imageLoad(froxelExtinction, idx).x, 0.0);
        current = ApplyFireflyClamp(current);

        vec4 finalValue = current;
        if (validSample) {
            finalValue = ReprojectHistory(idx, dim, current, worldPos, centerDepth);
            finalValue = ApplyFireflyClamp(finalValue);
        }

        imageStore(froxelScattering, idx, vec4(finalValue.rgb, finalValue.a));
        imageStore(froxelExtinction, idx, vec4(finalValue.a, 0.0, 0.0, 0.0));
        return;
    }
}
