#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(binding = 0, rgba16f) uniform writeonly image3D froxelVolume;
layout(binding = 1, rgba16f) uniform readonly image3D froxelHistory;
layout(binding = 2) uniform sampler2D depthTexture;

layout(std140, binding = 3) uniform VolumetricParams {
	mat4 invProj;
	mat4 invView;
	vec4 viewOrigin;
	vec4 sunDirection;
	vec4 fogColor;
	vec4 densityParams;
	vec4 worldMin;
	vec4 worldMax;
	vec4 gridDim;
	vec4 miscParams;
	vec4 phaseParams;
} params;

const float PI = 3.14159265359;
const float NEAR_PLANE = 0.05;
const float FAR_PLANE = 16384.0;
const int MAX_MARCH_STEPS = 128;

float phaseHG( float cosTheta, float g ) {
	float gg = g * g;
	float denom = max( 1.0 + gg - 2.0 * g * cosTheta, 1e-5 );
	return ( 1.0 - gg ) / ( 4.0 * PI * pow( denom, 1.5 ) );
}

vec3 reconstructViewRay( vec2 uv ) {
	vec4 clip = vec4( uv * 2.0 - 1.0, 1.0, 1.0 );
	vec4 view = params.invProj * clip;
	return view.xyz / max( abs( view.w ), 1e-6 );
}

float decodeClipZ( float depthSample, int depthMode ) {
	if ( depthMode == 0 ) {
		return depthSample * 2.0 - 1.0;
	}
	if ( depthMode == 1 ) {
		return ( 1.0 - depthSample ) * 2.0 - 1.0;
	}
	return 0.0;
}

float reconstructSceneDepth( vec2 uv, float depthSample, int depthMode ) {
	if ( depthMode == 2 ) {
		float linearDepth = depthSample;
		if ( linearDepth <= 1.0 ) {
			linearDepth = mix( NEAR_PLANE, FAR_PLANE, clamp( linearDepth, 0.0, 1.0 ) );
		}
		return clamp( linearDepth, NEAR_PLANE, FAR_PLANE );
	}
	vec4 clip = vec4( uv * 2.0 - 1.0, decodeClipZ( depthSample, depthMode ), 1.0 );
	vec4 view = params.invProj * clip;
	vec3 viewPos = view.xyz / max( abs( view.w ), 1e-6 );
	return clamp( length( viewPos ), NEAR_PLANE, FAR_PLANE );
}

bool boundsValid( out vec3 extent ) {
	extent = params.worldMax.xyz - params.worldMin.xyz;
	return all( greaterThan( extent, vec3( 1e-4 ) ) );
}

void mediumAtWorldPos( vec3 worldPos, vec3 rayDir, out vec3 inscatter, out float sigmaT ) {
	float baseDensity = max( params.densityParams.x, 0.0 );
	float heightFalloff = max( params.densityParams.y, 0.0 );
	float heightDelta = worldPos.z - params.viewOrigin.w;
	float density = baseDensity * exp( -heightFalloff * max( 0.0, heightDelta ) );
	float g = clamp( params.phaseParams.x, -0.999, 0.999 );
	float cosTheta = dot( normalize( params.sunDirection.xyz ), normalize( -rayDir ) );
	float phase = phaseHG( cosTheta, g );
	float lighting = params.phaseParams.z + params.phaseParams.y * phase;
	sigmaT = max( density, 0.0 );
	inscatter = params.fogColor.rgb * max( lighting, 0.0 ) * sigmaT * max( params.fogColor.a, 0.0 );
}

vec4 integrateRay( vec3 worldCam, vec3 rayDir, float targetDistance, vec3 extent, bool clampToBounds ) {
	int marchSteps = int( clamp( floor( params.miscParams.x + 0.5 ), 1.0, float( MAX_MARCH_STEPS ) ) );
	float distance = max( targetDistance, 0.0 );
	if ( marchSteps <= 0 || distance <= 1e-5 ) {
		return vec4( 0.0 );
	}

	float ds = distance / float( marchSteps );
	float transmittance = 1.0;
	vec3 accum = vec3( 0.0 );

	for ( int i = 0; i < MAX_MARCH_STEPS; ++i ) {
		if ( i >= marchSteps ) {
			break;
		}

		float t = ( float( i ) + 0.5 ) * ds;
		vec3 samplePos = worldCam + rayDir * t;
		if ( clampToBounds ) {
			vec3 uvw = ( samplePos - params.worldMin.xyz ) / extent;
			if ( any( lessThan( uvw, vec3( 0.0 ) ) ) || any( greaterThan( uvw, vec3( 1.0 ) ) ) ) {
				continue;
			}
		}

		vec3 inscatter;
		float sigmaT;
		mediumAtWorldPos( samplePos, rayDir, inscatter, sigmaT );
		accum += transmittance * inscatter * ds;
		transmittance *= exp( -sigmaT * ds );
		if ( transmittance <= 0.01 ) {
			break;
		}
	}

	return vec4( accum, clamp( 1.0 - transmittance, 0.0, 1.0 ) );
}

vec4 computeWorldValue( ivec3 idx, ivec3 dim, vec3 extent ) {
	vec3 cell = ( vec3( idx ) + vec3( 0.5 ) ) / vec3( dim );
	vec3 worldPos = params.worldMin.xyz + cell * extent;
	vec3 rel = worldPos - params.viewOrigin.xyz;
	float relLen = max( length( rel ), 1e-4 );
	vec3 rayDir = rel / relLen;
	return integrateRay( params.viewOrigin.xyz, rayDir, relLen, extent, true );
}

vec4 computeLegacyValue( ivec3 idx, ivec3 dim, int depthMode ) {
	vec2 uv = ( vec2( idx.xy ) + vec2( 0.5 ) ) / vec2( dim.xy );
	float sceneDepth = reconstructSceneDepth( uv, texture( depthTexture, uv ).r, depthMode );
	float slice = ( float( idx.z ) + 0.5 ) / float( dim.z );
	float sampleDepth = mix( NEAR_PLANE, max( sceneDepth, NEAR_PLANE ), slice );

	vec3 viewRay = reconstructViewRay( uv );
	vec3 viewDir = normalize( viewRay );
	vec3 worldDir = normalize( ( params.invView * vec4( viewDir, 0.0 ) ).xyz );
	return integrateRay( params.viewOrigin.xyz, worldDir, sampleDepth, vec3( 1.0 ), false );
}

void main() {
	ivec3 idx = ivec3( gl_GlobalInvocationID );
	ivec3 dim = ivec3( max( params.gridDim.xyz, vec3( 1.0 ) ) );
	int depthMode = int( clamp( floor( params.miscParams.y + 0.5 ), 0.0, 2.0 ) );
	int froxelDebug = int( clamp( floor( params.phaseParams.w + 0.5 ), 0.0, 2.0 ) );
	vec3 extent;
	bool useWorldGrid = boundsValid( extent );

	if ( any( greaterThanEqual( idx, dim ) ) ) {
		return;
	}

	if ( froxelDebug == 1 ) {
		vec3 uvw = ( vec3( idx ) + vec3( 0.5 ) ) / vec3( dim );
		imageStore( froxelVolume, idx, vec4( uvw, uvw.z ) );
		return;
	}
	if ( froxelDebug == 2 ) {
		imageStore( froxelVolume, idx, vec4( params.fogColor.rgb * 0.05, 0.05 ) );
		return;
	}

	vec4 current = vec4( 0.0 );
	if ( useWorldGrid ) {
		current = computeWorldValue( idx, dim, extent );
	} else {
		current = computeLegacyValue( idx, dim, depthMode );
	}

	vec4 history = vec4( 0.0 );
	bool hasHistory = params.miscParams.w > 0.5;
	float temporal = clamp( params.densityParams.w, 0.0, 1.0 );
	bool doTemporal = hasHistory && temporal > 0.0;
	if ( doTemporal ) {
		history = imageLoad( froxelHistory, idx );
	}

	vec4 finalValue = current;
	if ( doTemporal ) {
		vec4 blended = mix( current, history, temporal );
		vec4 diff = blended - history;
		diff = clamp( diff, -0.25, 0.25 );
		finalValue = history + diff;
	}

	imageStore( froxelVolume, idx, finalValue );
}
