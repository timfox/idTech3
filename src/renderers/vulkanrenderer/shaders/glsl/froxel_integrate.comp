 *
 * Froxel integration compute shader.
 *
 * Performs front-to-back integration along each view ray through the
 * froxel grid, accumulating in-scattered light and transmittance.
 *
 * For each (x, y) pixel column:
 *   transmittance = 1.0
 *   accumulated_light = 0.0
 *   For z = 0 to depth:
 *     extinction = froxel[x,y,z].w
 *     scattering = froxel[x,y,z].rgb
 *     step_transmittance = exp(-extinction * slice_thickness)
 *     accumulated_light += transmittance * scattering * slice_thickness
 *     transmittance *= step_transmittance
 *   Store integrated result back into froxel grid
 *
 * The integrated froxel grid is then sampled during the final
 * compositing pass to apply volumetric lighting to the scene.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform image3D froxelGrid;

layout(push_constant) uniform Params {
	float nearPlane;
	float farPlane;
	int   froxelDepth;
	float padding;
} params;

float sliceThickness(int slice, int maxSlices, float near, float far) {
	float t0 = float(slice) / float(maxSlices);
	float t1 = float(slice + 1) / float(maxSlices);
	float d0 = near * pow(far / near, t0);
	float d1 = near * pow(far / near, t1);
	return d1 - d0;
}

void main() {
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	ivec3 gridSize = imageSize(froxelGrid);

	if (any(greaterThanEqual(gid, gridSize.xy))) {
		return;
	}

	float transmittance = 1.0;
	vec3 accumulatedLight = vec3(0.0);

	for (int z = 0; z < gridSize.z; z++) {
		vec4 froxel = imageLoad(froxelGrid, ivec3(gid, z));
		vec3 scattering = froxel.rgb;
		float extinction = froxel.w;

		float thickness = sliceThickness(z, gridSize.z, params.nearPlane, params.farPlane);
		float stepTransmittance = exp(-extinction * thickness);

		accumulatedLight += transmittance * scattering * thickness;
		transmittance *= stepTransmittance;

		imageStore(froxelGrid, ivec3(gid, z), vec4(accumulatedLight, transmittance));
	}
}
