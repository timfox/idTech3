	else if ( tex_mode == 5 ) // 0 + GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA | GLS_SRCBLEND_SRC_ALPHA
	{
		// mix by src alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * VTX_COLOR1;
#endif
		base = mix( color0, color1, color1.a );
	}
	else if ( tex_mode == 6 ) // 0 + GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_ONE_MINUS_SRC_ALPHA
	{
		// mix by 1-src alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * VTX_COLOR1;
#endif
		base = mix( color1, color0, color1.a );
	}
	else if ( tex_mode == 7 ) // 0 + GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_DST_COLOR
	{
		// modulate color1 by color0
		// moduleta color0 by color1.alpha
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * VTX_COLOR1;
#endif
		base = (color1 + color1.a) * color0;
	}
	else
	{
		// default case, modulate
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * VTX_COLOR1;
#endif
		base = color0 * color1;
	}
#else
	// double-texture with identity colors (1.0) in color1
	if ( tex_mode == 1 )
	{
		// add (identity)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		base = vec4(color0.rgb + color1.rgb, color0.a * color1.a);
	}
	else if ( tex_mode == 2 )
	{
		// add
#if defined (USE_CLX_IDENT)
		vec4 color1 = texture(texture1, frag_tex_coord1);
#elif defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1) * VTX_COLOR0;
#endif
		base = vec4(color0.rgb + color1.rgb, color0.a * color1.a);
	}
	else // default case
	{
		// modulate
#if defined (USE_FIXED_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color;
#elif defined (USE_ENT_COLOR)
		vec4 color1 = texture(texture1, frag_tex_coord1) * ent_color1;
#else
		vec4 color1 = texture(texture1, frag_tex_coord1);
#endif
		base = color0 * color1;
	}
#endif // !USE_CL1
#endif // !USE_TX1
#endif // USE_VK_PBR

#ifdef USE_ATEST
#if 0
	if (alpha_to_coverage != 0) {
		if (alpha_test_func == 1) {
			base.a =  base.a > 0.0 ? 1.0 : 0.0;
		} else if (alpha_test_func == 2) {
			base.a = CorrectAlpha(alpha_test_value, 1.0 - base.a, frag_tex_coord0);
		} else if (alpha_test_func == 3) {
			base.a = CorrectAlpha(alpha_test_value, base.a, frag_tex_coord0);
		}
	} else
#endif
	// specialization: alpha-test function
	if (alpha_test_func == 1) {
		if (color0.a == alpha_test_value) discard;
	} else if (alpha_test_func == 2) {
		if (color0.a >= alpha_test_value) discard;
	} else if (alpha_test_func == 3) {
		if (color0.a < alpha_test_value) discard;
	}
#endif

#if !defined(USE_TX1) && !defined(USE_TX2)
	base = color0;
#endif

#ifdef USE_FOG
	if ( acff == 1 ) {
		// ACFF_RGB
		base.rgb = base.rgb * (1.0 - fog.w);
	} else if ( acff == 2 ) {
		// ACFF_RGBA
		base = base * (1.0 - fog.w);
	} else if ( acff == 3 ) {
		// ACFF_ALPHA
		base.a = base.a * (1.0 - fog.w);
	} else {
		// default: ACFF_NONE
		base = mix( base, fog * fogColor, fog.a );
	}
#endif

	if ( discard_mode == 1 ) {
		if ( base.a == 0.0 ) {
			discard;
		}
	} else if ( discard_mode == 2 ) {
		if ( dot( base.rgb, base.rgb ) == 0.0 ) {
			discard;
		}
	}

#ifdef USE_DF
	if ( base.a < depth_fragment )
		discard;

	gl_FragDepth = gl_FragCoord.z;
#else

#ifdef USE_VK_PBR
	viewDir = var_ViewDir.xyz;
	E = normalize(viewDir);

	L = var_LightDir.xyz;
	float sqrLightDist = dot(L, L);
	float lightDistance = sqrt( max( sqrLightDist, 1e-6 ) );
	L /= lightDistance;

	// FIX ME
	#if defined (USE_CLX_IDENT)
			vec3 bias_color = vec3(1.0);
	#elif defined (USE_FIXED_COLOR)
			vec3 bias_color = frag_color.rgb;
	#elif defined (USE_ENT_COLOR)
			vec3 bias_color = ent_color1.rgb;
	#else
			vec3 bias_color = VTX_COLOR0.rgb;
	#endif

	const bool hasLightmap = pbrFeatureFlags.z > 0.5;

#if ( defined(USE_TX1) || defined(USE_TX2) )
		if ( hasLightmap ) {
		#ifdef USE_VK_PBR
			vec3 lightmapColor = PBR_SAMPLE_LIGHTMAP( frag_tex_coord1 ).rgb;
		#else
			vec3 lightmapColor = texture(texture1, frag_tex_coord1).rgb;
		#endif

			lightColor = lightmapColor * bias_color;
			diffuse = color0;
		}
		else {
			lightColor = bias_color;
			diffuse = base;
		}
		ambientColor = vec3 (0.0);
		attenuation = 1.0;
	#else
		lightColor = bias_color;
		diffuse = base;
		ambientColor = vec3 (0.0);
		attenuation = 1.0;
	#endif

	N = CalcNormal( var_Normal.xyz, var_Tangent, frag_tex_coord0 );	

	#if defined(USE_TX1) || defined(USE_TX2)
		if ( hasLightmap ) {
			ambientColor = lightColor;
			float surfNL = clamp(dot(var_Normal.xyz, L), 0.0, 1.0);
			lightColor /= max( surfNL, 0.25 );
			ambientColor = max( ambientColor - lightColor * surfNL, 0.0 );
		}
	#endif

	lightColor *= PI;
	if ( pbrDebug.z > 0.5 )
	{
		lightColor = vec3( 1.0 );
		attenuation = 1.0;
	}

	vec4 specular = vec4( 1.0 );
	float roughness = 0.99;
	float AO = 1.0;
	vec3 emissive = vec3( 0.0 );
	vec3 subsurfaceColor = pbrSubsurfaceColor.rgb;
	float subsurfaceStrength = pbrSubsurfaceParams.x;
	float subsurfaceWrap = pbrSubsurfaceParams.y;

	// metallic roughness workflow
	if ( physical_texture_set == 0 ) {
		vec4 ORMS = PBR_SAMPLE_PHYSICAL( frag_tex_coord0 );
		ORMS.xyzw *= vec4( specularScale_z, specularScale_w, specularScale_x, specularScale_y );

		specular.rgb = mix( vec3( 0.08 ) * ORMS.w, diffuse.rgb, ORMS.z );
		diffuse.rgb *= vec3( 1.0 - ORMS.z );

		roughness = mix( 0.01, 1.0, ORMS.y );
		AO = min( ORMS.x, AO );
	}

	// specular workflow
	else if( physical_texture_set == 1 ){
		specular = PBR_SAMPLE_PHYSICAL( frag_tex_coord0 );
		specular.rgb *= vec3( specularScale_x, specularScale_y, specularScale_z );
		roughness = mix( 1.0, 0.01, specular.a * ( 1.0 - specularScale_w ) );
	}

	if ( anisotropy_texture_set > -1 ) {
		float aniso = PBR_SAMPLE_ANISOTROPY( frag_tex_coord0 ).r * pbrAnisotropyScale.x;
		roughness = mix( roughness, max( 0.02, roughness * ( 1.0 - aniso ) ), aniso );
	}

	if ( emissive_texture_set > -1 ) {
		emissive = PBR_SAMPLE_EMISSIVE( frag_tex_coord0 ).rgb * pbrEmissiveScale.rgb;
	}

	if ( subsurface_texture_set > -1 ) {
		vec4 subTex = PBR_SAMPLE_SUBSURFACE( frag_tex_coord0 );
		subsurfaceColor *= subTex.rgb;
		subsurfaceStrength *= subTex.a;
	}

	float clearcoatStrength = 0.0;
	float clearcoatRoughness = 0.0;
	if ( clearcoat_texture_set > -1 ) {
		vec4 cc = PBR_SAMPLE_CLEARCOAT( frag_tex_coord0 );
		clearcoatStrength = cc.r * pbrClearcoatScale.x;
		clearcoatRoughness = clamp( cc.g * pbrClearcoatScale.y, 0.02, 1.0 );
	}

	ambientColor *= AO;

	vec3  H  = normalize( L + E );
	float NE = abs( dot( N, E ) ) + 1e-5;
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float LH = clamp( dot( L, H ), 0.0, 1.0 );

	vec3  Fd = CalcDiffuse( diffuse.rgb, NE, NL, LH, roughness );
	vec3  Fs = vec3( 0.0 );

	float NH = clamp( dot( N, H ), 0.0, 1.0 );
	float VH = clamp( dot( E, H ), 0.0, 1.0 );
	Fs = CalcSpecular( specular.rgb, NH, NL, NE, LH, VH, roughness );

	vec3 baseN = normalize( var_Normal.xyz );
	vec3 tangent = normalize( var_Tangent.xyz - baseN * dot( baseN, var_Tangent.xyz ) );
	vec3 binormal = normalize( cross( baseN, tangent ) ) * var_Tangent.w;

	vec3 glintTerm = vec3( 0.0 );
	vec4 glintDebugData = vec4( 0.0 );
	float glintBlend = 0.0;
	int glintDebugLevel = 0;
	vec3 dbgBaseSpec = vec3( 0.0 );
	vec3 dbgClearcoat = vec3( 0.0 );
	vec3 dbgGlint = vec3( 0.0 );
	int pbrDebugView = int( floor( pbrDebug.x + 0.5 ) );
	const bool forceGlintsDebug = ( pbrDebugView == 18 );

	const bool hasEnv = pbrFeatureFlags.x > 0.5;
	const bool hasIrr = pbrFeatureFlags.y > 0.5;
	const bool hasGlintDict = pbrFeatureFlags.w > 0.5;
	const bool needsFallbackLight = ( !hasLightmap && !hasEnv && !hasIrr );

const bool allowGlints = forceGlintsDebug || glintCore.x > 0.5 || pbrDebug.w > 0.5;
const bool glintAvailable = hasGlintDict && allowGlints;
bool glintEnabled = glintAvailable;
const bool hasEnvDebug = pbrDebugFlags.y > 0.5;
const bool hasIrrDebug = pbrDebugFlags.z > 0.5;
const bool dictValidDebug = pbrDebugFlags.w > 0.5;
const float debugEps = max( pbrDebugParams.y, 1e-6 );
const bool glintsEnabledDebug = ( pbrDebugParams.z > 0.5 );

#ifdef USE_VK_PBR
	if ( glintEnabled )
	{
		// Compute raw glint NDF (Chermain P-SDF based D term)
		float glintMaskFactor = 1.0;
		float D_glint = ComputeGlintD( N, tangent, binormal, L, E, roughness,
			NL, NH, NE, LH, VH, glintMaskFactor, glintDebugData );

		// Chermain beta: fraction of surface area with glinting microfacets
		float beta = clamp( glintModel.x, 0.0, 1.0 );

		// Roughness gate: glints collapse rapidly with roughness^2
		// roughness 0.05 -> 0.96, roughness 0.15 -> 0.70, roughness 0.25 -> 0.37, roughness 0.50 -> 0.018
		float alpha = roughness * roughness;
		float roughnessGate = exp( -16.0 * alpha );

		// Distance attenuation: glints vanish with distance
		float distFade = 1.0;
		if ( glintBudget.z > 0.0 )
		{
			distFade = clamp( 1.0 - lightDistance / max( glintBudget.z, 1e-3 ), 0.0, 1.0 );
		}

		// Combined blend factor for D-term replacement
		float glintWeight = beta * roughnessGate * distFade * glintMaskFactor;
		glintWeight *= clamp( glintMaterial.x, 0.0, 1.0 ); // user strength
		glintWeight = clamp( glintWeight, 0.0, 1.0 );

		// Energy-conserving D-term replacement:
		// mix(D_ggx, D_glint, w) preserves expected energy because
		// E[D_glint] ≈ D_ggx by construction of the P-SDF dictionary.
		float D_base = D_GGX( NH, roughness );
		float D_final = mix( D_base, D_glint, glintWeight );

		// Recompute full specular BRDF with combined D
		float V_spec = V_SmithJointApprox( roughness, NE, NL );
		vec3 F_spec = F_Schlick( specular.rgb, VH );
		Fs = D_final * F_spec * V_spec;

		// Track glint contribution for debug views
		glintBlend = glintWeight;
		glintTerm = vec3( max( D_final - D_base, 0.0 ) ) * F_spec * V_spec;
		glintDebugLevel = int( floor( glintCore.z + 0.5 ) );
	}
#endif

	// Clearcoat energy conservation (base layer dimmed when clearcoat present)
	float clearcoatDim = 1.0;
	if ( clearcoatStrength > 0.0 ) {
		clearcoatDim = clamp( 1.0 - clearcoatStrength * 0.25, 0.0, 1.0 );
	}
	Fd *= clearcoatDim;

	vec3 diffuseColor = diffuse.rgb * clearcoatDim;
	float specAO = CalcSpecularAO( AO, roughness, NE );

	// Multi-scatter energy compensation (Fdez-Aguera / Kulla-Conty approximation).
	// At high roughness, single-bounce GGX loses significant energy; this scales
	// specular contributions to recover it.
	vec2 dfg = texture( brdflut_texture, vec2( NE, 1.0 - roughness ) ).rg;
	vec3 energyCompensation = vec3( 1.0 );
	if ( pbrQuality.y > 0.5 )
	{
		float Eo = dfg.x + dfg.y;
		energyCompensation = 1.0 + specular.rgb * ( 1.0 / max( Eo, 1e-4 ) - 1.0 );
	}

	// AO micro-shadowing [Jimenez et al. 2016]:
	// Attenuates diffuse at low NdotL based on AO to prevent light leaks
	// in crevices. Converges to plain NL when AO=1.
	float microShadow = 1.0;
	if ( pbrQuality.z > 0.5 )
	{
		microShadow = clamp( NL + 2.0 * AO * AO - 1.0, 0.0, 1.0 );
	}

	vec3 directDiffuse = lightColor * Fd * ( attenuation * NL * microShadow );
	vec3 directSpec = lightColor * ( Fs * clearcoatDim ) * ( attenuation * NL );
	directSpec *= energyCompensation;

	out_color.rgb  = directDiffuse + directSpec;
	out_color.rgb += ambientColor * diffuseColor;
	if ( needsFallbackLight ) {
		out_color.rgb += diffuseColor * 0.04;
	}

	dbgBaseSpec += directSpec;
	dbgGlint += lightColor * glintTerm * ( attenuation * NL );

	// Diffuse IBL (SH + irradiance cubemap when bound).
	// When multi-scatter is enabled, use Fdez-Aguera's FmsEms correction
	// to recover energy lost to multiple bounces in the diffuse lobe.
	vec3 irradiance = CalcDiffuseIrradiance( N, hasIrr );
	if ( pbrQuality.y > 0.5 )
	{
		out_color.rgb += CalcIBLDiffuse( irradiance, diffuseColor, specular.rgb, NE, roughness ) * AO;
	}
	else
	{
		out_color.rgb += irradiance * diffuseColor * AO;
	}

	// Specular IBL.
	// CalcIBLContribution now uses roughness-dependent Fresnel (Fdez-Aguera)
	// which correctly brightens grazing angles on smooth surfaces.  The FssEss
	// term already encodes single+multi scatter weight, so no additional
	// energyCompensation is needed for the IBL path.
	const bool hasIBL = hasEnv && hasIrr;
	if ( hasIBL )
	{
		vec3 specIBL = CalcIBLContribution( roughness, N, E, NE, specular.rgb, pbrDebugParams.x );
		specIBL *= clearcoatDim * specAO;
		out_color.rgb += specIBL;
		dbgBaseSpec += specIBL;
	}

#ifdef USE_VK_PBR
	if ( glintDebugLevel > 0 )
	{
		if ( glintDebugData.w < 0.0 )
		{
			out_color.rgb = vec3( 1.0, 0.0, 0.0 );
		}
		else if ( glintDebugLevel == 1 )
		{
			float t = clamp( glintDebugData.y, 0.0, 1.0 );
			vec3 heat = vec3( t, 1.0 - t, 0.0 );
			out_color.rgb = mix( out_color.rgb, heat, 0.6 );
		}
		else if ( glintDebugLevel == 2 )
		{
			float t = clamp( glintDebugData.x * 40.0, 0.0, 1.0 );
			out_color.rgb = mix( out_color.rgb, vec3( t ), 0.6 );
		}
		else if ( glintDebugLevel == 3 )
		{
			float t = clamp( glintDebugData.z, 0.0, 1.0 );
			out_color.rgb = mix( out_color.rgb, vec3( t ), 0.6 );
		}
		else if ( glintDebugLevel == 4 )
		{
			float t = clamp( glintDebugData.w, 0.0, 1.0 );
			out_color.rgb = mix( out_color.rgb, vec3( t, 0.2, 1.0 - t ), 0.6 );
		}
	}
#endif

	// clearcoat lobe
	if ( clearcoatStrength > 0.0 ) {
		vec3 ccSpec = CalcSpecular( vec3(0.04), NH, NL, NE, LH, VH, clearcoatRoughness );
		vec3 ccDirect = lightColor * ccSpec * ( attenuation * NL ) * clearcoatStrength;
		out_color.rgb += ccDirect;
		dbgClearcoat += ccDirect;
	}

	// sheen term
	if ( sheen_texture_set > -1 ) {
		vec3 sheenColor = PBR_SAMPLE_SHEEN( frag_tex_coord0 ).rgb * pbrSheenScale.rgb;
		out_color.rgb += sheenColor * NL * 0.05;
	}

	// subsurface term (Burley-style wrap approximation)
	if ( subsurfaceStrength > 0.0 ) {
		out_color.rgb += lightColor * CalcBurleySubsurface( N, L, subsurfaceColor, subsurfaceStrength, subsurfaceWrap ) * attenuation;
	}

	// transmission term
	if ( transmission_texture_set > -1 ) {
		float transmission = PBR_SAMPLE_TRANSMISSION( frag_tex_coord0 ).r * pbrTransmissionScale.x;
		float transmitFactor = transmission * ( 1.0 - roughness );
		diffuse.rgb *= ( 1.0 - transmitFactor );
		out_color.rgb += lightColor * diffuse.rgb * ( attenuation * NL ) * transmitFactor;
	}
	
	out_color.rgb += emissive;

	if ( pbrDebugView == 5 )
	{
		out_color.rgb = vec3( AO );
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 6 )
	{
		out_color.rgb = vec3( specAO );
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 7 )
	{
		vec3 nTS = ( normal_texture_set > -1 ) ? DecodeNormalTS( frag_tex_coord0 ) : vec3( 0.0, 0.0, 1.0 );
		out_color.rgb = nTS * 0.5 + 0.5;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 8 )
	{
		if ( normal_texture_set > -1 )
		{
			vec4 ntex = PBR_SAMPLE_NORMAL( frag_tex_coord0 );
			out_color.rgb = vec3( ntex.r, ntex.g, ntex.a );
		}
		else
		{
			out_color.rgb = vec3( 0.0 );
		}
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 9 )
	{
		vec3 lum = vec3( 0.2126, 0.7152, 0.0722 );
		vec3 energy = vec3( dot( dbgBaseSpec, lum ), dot( dbgClearcoat, lum ), dot( dbgGlint, lum ) );
		energy = energy / ( energy + vec3( 1.0 ) );
		out_color.rgb = energy;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 10 )
	{
		vec3 c = lightColor / ( lightColor + vec3( 1.0 ) );
		out_color.rgb = c;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 11 )
	{
		out_color.rgb = vec3( NL );
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 12 )
	{
		out_color.rgb = diffuseColor;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 13 )
	{
		// UBO sanity: R = debug mode / 20, G = normal swizzle, B = forceLight
		vec3 debugColor = vec3( clamp( pbrDebug.x / 20.0, 0.0, 1.0 ), clamp( pbrDebug.y, 0.0, 1.0 ), clamp( pbrDebug.z, 0.0, 1.0 ) );
		out_color.rgb = debugColor;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 14 )
	{
		// Direct diffuse contribution.
		out_color.rgb = directDiffuse;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 15 )
	{
		// Direct specular contribution (includes glint D-term replacement).
		out_color.rgb = directSpec;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 16 )
	{
		vec3 specIBL = CalcIBLContribution( roughness, N, E, NE, specular.rgb, pbrDebugParams.x ) * clearcoatDim * specAO;
		out_color.rgb = dbg_classify_ibl( specIBL, hasEnvDebug, debugEps );
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 17 )
	{
		vec3 diffIBL = CalcDiffuseIrradiance( N, hasIrrDebug ) * diffuseColor * AO;
		out_color.rgb = dbg_classify_ibl( diffIBL, hasIrrDebug, debugEps );
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 18 )
	{
		out_color.rgb = dbg_classify_glints( dbgGlint, glintsEnabledDebug, dictValidDebug, debugEps );
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 19 )
	{
		// Debug 19: Raw env cubemap sample.
		// MAGENTA = env_texture_set not compiled in (spec constant < 0)
		// RED     = CPU says hasEnvDebug=false AND sample is also empty
		// BLUE    = CPU says hasEnvDebug=false BUT sample returned non-zero (flag/binding mismatch!)
		// YELLOW  = CPU says hasEnvDebug=true  BUT sample is near-zero (bound but empty content)
		// actual  = successful sample
		if ( env_texture_set < 0 )
		{
			out_color.rgb = DBG_MAGENTA;
		}
		else
		{
			vec3 R = reflect( -E, N );
			R.y *= -1.0;
			float rawLod = ( pbrDebugParams.x >= 0.0 ) ? pbrDebugParams.x : 0.0;
			vec3 rawEnv = textureLod( env_texture, R, rawLod ).rgb;
			float envMag = dbg_len( rawEnv );

			if ( !hasEnvDebug )
			{
				// CPU flag says env not bound; cross-check with actual sample
				if ( envMag > debugEps )
				{
					// Descriptor IS bound and returning data, but CPU flag disagrees
					out_color.rgb = vec3( 0.0, 0.0, 1.0 ); // BLUE = flag/binding mismatch
				}
				else
				{
					out_color.rgb = DBG_RED; // genuinely not bound or empty
				}
			}
			else
			{
				if ( envMag < debugEps )
				{
					out_color.rgb = DBG_YELLOW; // bound but sample is black/zero
				}
				else
				{
					out_color.rgb = rawEnv; // success
				}
			}
		}
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 20 )
	{
		if ( lightmap_texture_set >= 0 )
		{
#ifdef USE_VK_PBR
			out_color.rgb = PBR_SAMPLE_LIGHTMAP( frag_tex_coord1 ).rgb;
#else
			out_color.rgb = texture(texture1, frag_tex_coord1).rgb;
#endif
		}
		else
		{
			out_color.rgb = vec3( 1.0, 0.0, 1.0 ); // MAGENTA: lightmap disabled
		}
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 21 )
	{
		out_color.rgb = texture(texture0, frag_tex_coord0).rgb;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 22 )
	{
		if ( lightmap_texture_set >= 0 )
		{
#ifdef USE_VK_PBR
			out_color.rgb = PBR_SAMPLE_LIGHTMAP( frag_tex_coord1 ).rgb;
#else
			out_color.rgb = texture(texture1, frag_tex_coord1).rgb;
#endif
		}
		else
		{
			out_color.rgb = vec3( 1.0, 0.0, 1.0 );
		}
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 23 )
	{
		out_color.rgb = texture(texture0, frag_tex_coord0).rgb;
		out_color.a = 1.0;
	}
	else if ( pbrDebugView == 30 )
	{
		out_color.rgb = directDiffuse + directSpec;
		out_color.a = 1.0;
	}
	else
	{
		out_color.a = diffuse.a;
	}
#else
	out_color = base;
#endif
#endif
}
