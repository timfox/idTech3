#version 450

#ifdef USE_STENCILED_VAO
layout(set = 0, binding = 0) uniform sampler2D depthTex;

layout(push_constant) uniform VAOParams {
	vec4 projInfo; // invProj00, invProj11, proj10, proj14
	vec4 params;   // radius, bias, thickness, unused
	vec4 misc;     // samples, invWidth, invHeight, depthIsReversed
} vaoParams;

layout(location = 1) out uvec4 out_mask;

const int VAO_SAMPLE_COUNT = 8;
const float TWO_PI = 6.2831853;

float rand01(vec2 co)
{
	return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}

float viewZFromDepth(float depth)
{
	return -vaoParams.projInfo.w / max(depth + vaoParams.projInfo.z, 1e-6);
}

float heightFromRadius(float r)
{
	return 2.0 * sqrt(max(0.0, 1.0 - r * r));
}

void main()
{
	float depth = texture(depthTex, frag_tex_coord).r;
	float viewZ = viewZFromDepth(depth);
	float negZ = -viewZ;
	vec2 ndc = frag_tex_coord * 2.0 - 1.0;
	float proj00 = 1.0 / max(vaoParams.projInfo.x, 1e-6);
	float proj11 = 1.0 / max(vaoParams.projInfo.y, 1e-6);
	vec3 viewPos = vec3(ndc.x * negZ * proj00, ndc.y * negZ * proj11, viewZ);

	vec3 dx = dFdx(viewPos);
	vec3 dy = dFdy(viewPos);
	vec3 normal = normalize(cross(dx, dy));
	if (normal.z < 0.0) {
		normal = -normal;
	}

	vec3 randVec = normalize(vec3(
		rand01(frag_tex_coord * 13.1),
		rand01(frag_tex_coord * 31.7),
		rand01(frag_tex_coord * 57.3)
	) * 2.0 - 1.0);

	vec3 tangent = normalize(randVec - normal * dot(randVec, normal));
	vec3 bitangent = cross(normal, tangent);

	float radius = vaoParams.params.x;
	float bias = vaoParams.params.y;
	int samples = VAO_SAMPLE_COUNT;
	float occlusion = 0.0;
	uint mask = 0u;

	for (int i = 0; i < samples; ++i) {
		float fi = float(i);
		float angle = (fi / float(samples)) * TWO_PI + rand01(vec2(fi, frag_tex_coord.x + 0.1));
		float r = sqrt(rand01(vec2(frag_tex_coord.y + 0.2, fi)));
		vec2 disk = vec2(cos(angle), sin(angle)) * r;
		float h = max(heightFromRadius(r), 1e-4);

		vec3 sampleOffset = tangent * disk.x + bitangent * disk.y;
		vec3 samplePos = viewPos + sampleOffset * radius;

		vec2 sampleNdc = vec2(samplePos.x * proj00 / -samplePos.z, samplePos.y * proj11 / -samplePos.z);
		vec2 sampleUV = sampleNdc * 0.5 + 0.5;

		if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {
			continue;
		}

		float sampleDepth = texture(depthTex, sampleUV).r;
		float sampleViewZ = viewZFromDepth(sampleDepth);
		float delta = sampleViewZ - samplePos.z;
		float contribution = clamp(delta / h, 0.0, 1.0);
		occlusion += contribution;

		if (delta > bias) {
			mask |= 1u << i;
		}
	}

	float ao = clamp(1.0 - occlusion / float(samples), 0.0, 1.0);
	out_color = vec4(ao, ao, ao, 1.0);
	out_mask = uvec4(mask, 0u, 0u, 0u);
}

