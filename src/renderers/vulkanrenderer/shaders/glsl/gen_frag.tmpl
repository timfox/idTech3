#ifdef USE_VK_PBR
const vec3 DBG_MAGENTA = vec3(1.0, 0.0, 1.0);
const vec3 DBG_YELLOW  = vec3(1.0, 1.0, 0.0);
const vec3 DBG_RED     = vec3(1.0, 0.0, 0.0);
const vec3 DBG_CYAN    = vec3(0.0, 1.0, 1.0);

float dbg_len( vec3 v ) {
	vec3 abs_v = abs( v );
	return max( max( abs_v.r, abs_v.g ), abs_v.b );
}

float get_debug_lod( float roughness, float forcedLod ) {
	return forcedLod >= 0.0 ? forcedLod : roughness * 6.0;
}

vec3 dbg_classify_ibl( vec3 value, bool hasResource, float eps ) {
	if ( !hasResource ) {
		return DBG_MAGENTA;
	}
	if ( dbg_len( value ) < eps ) {
		return DBG_YELLOW;
	}
	return value;
}

vec3 dbg_classify_glints( vec3 value, bool enabled, bool dictValid, float eps ) {
	if ( !enabled || !dictValid ) {
		return DBG_RED;
	}
	if ( dbg_len( value ) < eps ) {
		return DBG_CYAN;
	}
	return value;
}
#endif

