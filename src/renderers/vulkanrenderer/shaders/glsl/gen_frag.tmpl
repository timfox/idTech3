float glint_hash( vec2 uv, float seed )
{
	return fract( sin( dot( uv, vec2( 12.9898, 78.233 ) ) + seed ) * 43758.5453 );
}

float glint_dictionary_lookup( int entry, int level, float position, float dictWidth, float dictHeight, int entryCount, int levelCount )
{
	entry = clamp( entry, 0, entryCount - 1 );
	level = clamp( level, 0, levelCount - 1 );
	float row = float( entry * levelCount + level );
	float y = ( row + 0.5 ) / dictHeight;
	float idx = clamp( position, 0.0, 1.0 ) * ( dictWidth - 1.0 );
	float x = ( idx + 0.5 ) / dictWidth;
	return PBR_SAMPLE_GLINT_DICT( vec2( x, y ) ).r;
}

vec3 F_Schlick( in vec3 SpecularColor, in float VH );

// Returns the raw glint NDF (D term) from Chermain P-SDF dictionary.
// This is a drop-in replacement for D_GGX, not a complete BRDF.
// Energy conservation happens via mix(D_ggx, D_glint, weight) at the call site.
float ComputeGlintD( vec3 N, vec3 T, vec3 B, vec3 L, vec3 V, float roughness, float NL, float NH, float NE, float LH, float VH, out float maskFactor, out vec4 debugData )
{
	debugData = vec4( 0.0 );
	maskFactor = 1.0;

	if ( glintCore.x < 0.5 && pbrDebug.w < 0.5 )
	{
		return 0.0;
	}

	// If we're not lit or view is invalid, glints must contribute nothing.
	// This also prevents NaNs from 0/0 cases in the BRDF denominator.
	if ( NL <= 0.0 || NE <= 0.0 || NH <= 0.0 || LH <= 0.0 || VH <= 0.0 )
	{
		return 0.0;
	}

	if ( roughness < glintMaterial.y || roughness > glintMaterial.z )
	{
		return 0.0;
	}

	if ( glintMaterial.w > 0.5 && physical_texture_set > -1 )
	{
		maskFactor = PBR_SAMPLE_PHYSICAL( frag_tex_coord0 ).a;
	}
	{
		float maskStrength = clamp( glintDictExtras.z, 0.0, 1.0 );
		maskFactor = mix( 1.0, maskFactor, maskStrength );
	}

	if ( maskFactor <= 0.001 )
	{
		return 0.0;
	}

	int entryCount = max( 1, int( glintDict.z + 0.5 ) );
	int levelCount = max( 1, int( glintDict.x + 0.5 ) );
	int dictSize = max( 2, int( glintDict.y + 0.5 ) );
	float alphaDict = max( glintDict.w, 1e-3 );
	float dictDomain = max( ( 4.0 * alphaDict ) / SQRT2, 1e-3 );
	float dictWidth = float( dictSize );
	float dictHeight = float( max( entryCount * levelCount, 1 ) );

	float ax = max( glintModel.y, 0.01 );
	float ay = max( glintModel.z, 0.01 );
	float beta = clamp( glintModel.x, 0.0, 1.0 );

	bool useChermain = glintCore.y >= 1.5;
	float varianceScale = useChermain ? max( glintMicro.w, 1e-3 ) : 1.0;
	float aniso = useChermain ? clamp( glintMicro.z, -0.95, 0.95 ) : 0.0;
	float anisoRot = useChermain ? radians( glintColor.x ) : 0.0;
	float tileScale = useChermain ? max( glintMicro.y, 1e-3 ) : 1.0;
	float forcedLod = glintDictExtras.y;

	ax *= varianceScale;
	ay *= varianceScale;
	if ( abs( aniso ) > 1e-4 )
	{
		float aspect = sqrt( ( 1.0 + aniso ) / max( 1.0 - aniso, 1e-4 ) );
		ax *= aspect;
		ay /= aspect;
	}

	vec3 H = normalize( L + V );
	vec3 Ht = vec3( dot( H, T ), dot( H, B ), dot( H, N ) );
	if ( Ht.z <= 1e-6 )
	{
		return 0.0;
	}

	vec2 slope = -vec2( Ht.x, Ht.y ) / Ht.z;
	if ( abs( anisoRot ) > 1e-4 )
	{
		float cRot = cos( anisoRot );
		float sRot = sin( anisoRot );
		slope = vec2( cRot * slope.x - sRot * slope.y, sRot * slope.x + cRot * slope.y );
	}
	float slopeNorm = clamp( length( slope ) / max( dictDomain, 1e-3 ), 0.0, 1.0 );

	// Pixel footprint in texture space (UVs) for the multiscale hierarchy.
	vec2 s = frag_tex_coord0 * max( glintSampling.z, 1.0 ) * tileScale;
	vec2 dx = dFdx( s );
	vec2 dy = dFdy( s );

	float a = dot( dx, dx );
	float b = dot( dx, dy );
	float c = dot( dy, dy );
	float trace = a + c;
	float det = max( a * c - b * b, 0.0 );
	float root = sqrt( max( trace * trace - 4.0 * det, 0.0 ) );
	float majorLen = sqrt( max( 0.5 * ( trace + root ), 1e-8 ) );
	float minorLen = sqrt( max( 0.5 * ( trace - root ), 1e-8 ) );

	float maxAniso = max( glintModel.w, 1.0 );
	if ( majorLen / max( minorLen, 1e-6 ) > maxAniso )
	{
		majorLen = minorLen * maxAniso;
	}

	// LOD selection with detail extension for modern rendering.
	// Standard mip selection maps pixel footprint to hierarchy level:
	float maxLod = float( levelCount - 1 );
	float rawLod = maxLod + log2( max( minorLen, 1e-6 ) );
	rawLod = clamp( rawLod, 0.0, maxLod );

	// Power-curve remapping: pushes the LOD toward finer levels at
	// mid-range distances, extending individual glint resolution further
	// into the scene before converging to the smooth NDF.
	//   normLod 0.25 -> 0.125  (2x finer at quarter-range)
	//   normLod 0.50 -> 0.354  (1.4x finer at mid-range)
	//   normLod 0.75 -> 0.650  (gentle push at far range)
	//   normLod 1.00 -> 1.000  (unchanged at closest distance)
	float normLod = rawLod / max( maxLod, 1.0 );
	float extendedLod = pow( normLod, 1.5 ) * maxLod;

	float lod = extendedLod + glintSampling.w + glintPerformance.x;
	lod = clamp( lod, 0.0, maxLod );
	if ( forcedLod >= 0.0 )
	{
		lod = clamp( forcedLod, 0.0, maxLod );
	}

	int lod0 = int( floor( lod ) );
	int lod1 = min( lod0 + 1, levelCount - 1 );
	float lodT = clamp( lod - float( lod0 ), 0.0, 1.0 );

	float rho = ( glintDensity.x > 0.0 ) ? glintDensity.x : exp( glintDensity.y );
	rho = max( rho, 1e-6 );

	int sampleCount = max( 1, int( glintSampling.x + 0.5 ) );
	float sampleSide = floor( sqrt( float( sampleCount ) ) + 0.5 );
	int radius = int( max( 0.0, floor( 0.5 * ( sampleSide - 1.0 ) ) ) );
	const int maxRadius = 2;
	radius = clamp( radius, 0, maxRadius );
	int maxCells = int( glintDensity.w + 0.5 );
	if ( maxCells > 0 )
	{
		while ( radius > 0 )
		{
			int tapCount = ( radius * 2 + 1 ) * ( radius * 2 + 1 );
			if ( tapCount <= maxCells )
			{
				break;
			}
			radius -= 1;
		}
	}
	float filterStrength = max( glintSampling.y, 0.01 );
	float totalWeight0 = 0.0;
	float totalWeight1 = 0.0;
	float psdf0 = 0.0;
	float psdf1 = 0.0;

	// Debug helpers: density LOD from center cell and tap count.
	{
		vec2 cellCenter = floor( s / exp2( float( lod0 ) ) );
		float cellArea = exp2( 2.0 * float( lod0 ) );
		float n = max( cellArea * rho, 1e-6 );
		float ldistCenter = 0.5 * log2( n );
		if ( glintDensity.z > 0.0 )
		{
			float seed = glintCore.w + dot( cellCenter, vec2( 12.9898, 78.233 ) );
			float u1 = max( glint_hash( cellCenter, seed + 9.1 ), 1e-6 );
			float u2 = glint_hash( cellCenter, seed + 11.3 );
			float z0 = sqrt( -2.0 * log( u1 ) ) * cos( 2.0 * PI * u2 );
			ldistCenter += z0 * glintDensity.z;
		}
		debugData.y = ( levelCount > 1 ) ? clamp( ldistCenter / float( levelCount - 1 ), 0.0, 1.0 ) : 0.0;

		int tapCount = ( radius * 2 + 1 ) * ( radius * 2 + 1 );
		int maxTapCount = ( maxRadius * 2 + 1 ) * ( maxRadius * 2 + 1 );
		debugData.z = clamp( float( tapCount ) / float( maxTapCount ), 0.0, 1.0 );
		debugData.w = slopeNorm;
	}

	for ( int oy = -radius; oy <= radius; oy++ )
	{
		for ( int ox = -radius; ox <= radius; ox++ )
		{
			vec2 offset = vec2( float( ox ), float( oy ) );
			float weight = exp( -dot( offset, offset ) * 0.5 * filterStrength );

			vec2 samplePos = s + dx * offset.x + dy * offset.y;

			vec2 cell0 = floor( samplePos / exp2( float( lod0 ) ) );
			vec2 cell1 = floor( samplePos / exp2( float( lod1 ) ) );

			float seed0 = glintCore.w + dot( cell0, vec2( 12.9898, 78.233 ) );
			float seed1 = glintCore.w + dot( cell1, vec2( 12.9898, 78.233 ) );

			float theta0 = glint_hash( cell0, seed0 + 3.1 ) * 2.0 * PI;
			float theta1 = glint_hash( cell1, seed1 + 5.7 ) * 2.0 * PI;

			int entryX0 = int( floor( glint_hash( cell0 + vec2( 1.3 ), seed0 + 1.1 ) * float( entryCount ) ) );
			int entryY0 = int( floor( glint_hash( cell0 + vec2( 2.7 ), seed0 + 2.2 ) * float( entryCount ) ) );
			int entryX1 = int( floor( glint_hash( cell1 + vec2( 1.3 ), seed1 + 1.1 ) * float( entryCount ) ) );
			int entryY1 = int( floor( glint_hash( cell1 + vec2( 2.7 ), seed1 + 2.2 ) * float( entryCount ) ) );

			float cellArea0 = exp2( 2.0 * float( lod0 ) );
			float cellArea1 = exp2( 2.0 * float( lod1 ) );
			float n0 = max( cellArea0 * rho, 1e-6 );
			float n1 = max( cellArea1 * rho, 1e-6 );

			float ldist0 = 0.5 * log2( n0 );
			float ldist1 = 0.5 * log2( n1 );

			if ( glintDensity.z > 0.0 )
			{
				float u1 = max( glint_hash( cell0, seed0 + 9.1 ), 1e-6 );
				float u2 = glint_hash( cell0, seed0 + 11.3 );
				float z0 = sqrt( -2.0 * log( u1 ) ) * cos( 2.0 * PI * u2 );
				ldist0 += z0 * glintDensity.z;

				u1 = max( glint_hash( cell1, seed1 + 15.1 ), 1e-6 );
				u2 = glint_hash( cell1, seed1 + 17.3 );
				z0 = sqrt( -2.0 * log( u1 ) ) * cos( 2.0 * PI * u2 );
				ldist1 += z0 * glintDensity.z;
			}

			int level0 = int( clamp( floor( ldist0 + 0.5 ), 0.0, float( levelCount - 1 ) ) );
			int level1 = int( clamp( floor( ldist1 + 0.5 ), 0.0, float( levelCount - 1 ) ) );

			float c0 = cos( theta0 );
			float s0 = sin( theta0 );
			float c1 = cos( theta1 );
			float s1 = sin( theta1 );

			vec2 slope0 = vec2( c0 * slope.x + s0 * slope.y, -s0 * slope.x + c0 * slope.y );
			vec2 slope1 = vec2( c1 * slope.x + s1 * slope.y, -s1 * slope.x + c1 * slope.y );

			slope0 *= vec2( alphaDict / ax, alphaDict / ay );
			slope1 *= vec2( alphaDict / ax, alphaDict / ay );

			float u0x = clamp( abs( slope0.x ) / dictDomain, 0.0, 1.0 );
			float u0y = clamp( abs( slope0.y ) / dictDomain, 0.0, 1.0 );
			float u1x = clamp( abs( slope1.x ) / dictDomain, 0.0, 1.0 );
			float u1y = clamp( abs( slope1.y ) / dictDomain, 0.0, 1.0 );

			float p0;
			float p1;
			float jacobian = ( alphaDict * alphaDict ) / ( ax * ay );

			if ( level0 >= levelCount - 1 )
			{
				p0 = exp( -( slope.x * slope.x / ( ax * ax ) + slope.y * slope.y / ( ay * ay ) ) ) / ( PI * ax * ay );
			}
			else
			{
				p0 = glint_dictionary_lookup( entryX0, level0, u0x, dictWidth, dictHeight, entryCount, levelCount ) *
					glint_dictionary_lookup( entryY0, level0, u0y, dictWidth, dictHeight, entryCount, levelCount ) * jacobian;
			}

			if ( level1 >= levelCount - 1 )
			{
				p1 = exp( -( slope.x * slope.x / ( ax * ax ) + slope.y * slope.y / ( ay * ay ) ) ) / ( PI * ax * ay );
			}
			else
			{
				p1 = glint_dictionary_lookup( entryX1, level1, u1x, dictWidth, dictHeight, entryCount, levelCount ) *
					glint_dictionary_lookup( entryY1, level1, u1y, dictWidth, dictHeight, entryCount, levelCount ) * jacobian;
			}

			psdf0 += p0 * weight;
			psdf1 += p1 * weight;
			totalWeight0 += weight;
			totalWeight1 += weight;
		}
	}

	if ( totalWeight0 > 0.0 )
	{
		psdf0 /= totalWeight0;
	}
	if ( totalWeight1 > 0.0 )
	{
		psdf1 /= totalWeight1;
	}

	// Raw P-SDF (without beta -- beta is applied as blend weight at call site)
	float psdf = mix( psdf0, psdf1, lodT );
	debugData.x = psdf;

	// Convert P-SDF to NDF: D = P(slope) / cos^4(theta_h)
	float NH4 = pow( max( NH, 1e-4 ), 4.0 );
	float D = psdf / NH4;
	D = clamp( D, 0.0, 1e6 );

	// NaN/inf guard
	{
		bvec4 bad0 = bvec4( isnan( psdf ), isnan( D ), false, false );
		bvec4 bad1 = bvec4( isinf( psdf ), isinf( D ), false, false );
		if ( any( bad0 ) || any( bad1 ) )
		{
			debugData.w = -1.0;
			return 0.0;
		}
	}

	return D;
}

vec3 DecodeNormalTS( in vec2 frag_tex_coord )
{
	vec4 ntex = PBR_SAMPLE_NORMAL( frag_tex_coord );
	vec2 swizzled = ( pbrDebug.y > 0.5 ) ? ntex.rg : ntex.ag;
	vec2 xy = swizzled * 2.0 - 1.0;
	xy *= vec2( normalScale_x, normalScale_y );
	float z = sqrt( max( 1.0 - dot( xy, xy ), 0.0 ) );
	return normalize( vec3( xy, z ) );
}

vec3 CalcNormal( in vec3 vertexNormal, in vec4 vertexTangent, in vec2 frag_tex_coord )
{
	vec3 baseN = normalize( vertexNormal );
	vec3 tangent = normalize( vertexTangent.xyz - baseN * dot( baseN, vertexTangent.xyz ) );
	vec3 biTangent = normalize( cross( baseN, tangent ) ) * vertexTangent.w;

	if ( normal_texture_set > -1 ) {
		vec3 nTS = DecodeNormalTS( frag_tex_coord );
		vec3 n = nTS.x * tangent + nTS.y * biTangent + nTS.z * baseN;

		return normalize(n);
	}else {
		return baseN;
	}
}

float WrapLambert( in float NL, in float w )
{
	return clamp((NL + w) / pow(1.0 + w, 2.0), 0.0, 1.0);
}

vec3 Diffuse_Lambert(in vec3 DiffuseColor)
{
	return DiffuseColor * (1.0 / PI);
}

// Disney/Burley roughness-dependent diffuse [Burley 2012]
// Accounts for retroreflection at grazing angles and surface roughness.
// Energy-normalized: converges to Lambert at roughness=0.
vec3 Diffuse_Burley( in vec3 DiffuseColor, in float roughness,
	in float NE, in float NL, in float LH )
{
	float energyBias = mix( 0.0, 0.5, roughness );
	float energyFactor = mix( 1.0, 1.0 / 1.51, roughness );
	float fd90 = energyBias + 2.0 * LH * LH * roughness;
	float lightScatter = 1.0 + ( fd90 - 1.0 ) * pow( 1.0 - NL, 5.0 );
	float viewScatter  = 1.0 + ( fd90 - 1.0 ) * pow( 1.0 - NE, 5.0 );
	return DiffuseColor * ( lightScatter * viewScatter * energyFactor * ( 1.0 / PI ) );
}

vec3 CalcDiffuse( in vec3 diffuse, in float NE, in float NL,
	in float LH, in float roughness )
{
	if ( pbrQuality.x > 0.5 )
	{
		return Diffuse_Burley( diffuse, roughness, NE, NL, LH );
	}
	return Diffuse_Lambert( diffuse );
}

vec3 F_Schlick( in vec3 SpecularColor, in float VH )
{
	float Fc = pow(1 - VH, 5);
	return clamp(50.0 * SpecularColor.g, 0.0, 1.0) * Fc + (1 - Fc) * SpecularColor; //hacky way to decide if reflectivity is too low (< 2%)
}

float D_GGX( in float NH, in float a )
{
	float a2 = a * a;
	float d = (NH * a2 - NH) * NH + 1;
	return a2 / (PI * d * d);
}

// Appoximation of joint Smith term for GGX
// [Heitz 2014, "Understanding the Masking-Shadowing Function in Microfacet-Based BRDFs"]
float V_SmithJointApprox( in float a, in float NV, in float NL )
{
	float Vis_SmithV = NL * (NV * (1 - a) + a);
	float Vis_SmithL = NV * (NL * (1 - a) + a);
	return 0.5 * (1.0 / (Vis_SmithV + Vis_SmithL));
}

float CalcVisibility( in float NL, in float NE, in float roughness )
{
	float alphaSq = roughness * roughness;

	float lambdaE = NL * sqrt((-NE * alphaSq + NE) * NE + alphaSq);
	float lambdaL = NE * sqrt((-NL * alphaSq + NL) * NL + alphaSq);

	return 0.5 / (lambdaE + lambdaL);
}

vec3 CalcSpecular( in vec3 specular, in float NH, in float NL,
	in float NE, float LH, in float VH, in float roughness )
{
	vec3  F = F_Schlick(specular, VH);
	float D = D_GGX(NH, roughness);
	float V = V_SmithJointApprox(roughness, NE, NL);

	return D * F * V;
}

float CalcSpecularAO( in float ao, in float roughness, in float NE )
{
	float a = clamp( ao, 0.0, 1.0 );
	float exponent = exp2( -16.0 * roughness - 1.0 );
	float specAO = pow( clamp( NE + a, 0.0, 1.0 ), exponent );
	specAO = specAO - 1.0 + a;
	return clamp( specAO, 0.0, 1.0 );
}


// Roughness-dependent Fresnel for IBL specular (Fdez-Aguera 2019).
// At grazing angles on smooth surfaces, reflections should approach 100%
// regardless of F0; standard Schlick doesn't account for this when
// pre-integrated BRDF is used.  The roughness term prevents overly bright
// Fresnel on rough surfaces where the energy is already scattered.
// Ref: https://bruop.github.io/ibl/#single_scattering_results
vec3 CalcIBLContribution( in float roughness, in vec3 N, in vec3 E,
	in float NE, in vec3 F0, in float forcedLod )
{
	vec3 R = reflect(-E, N);
	R.y *= -1.0f;
	float lod = get_debug_lod( roughness, forcedLod );

	vec3 cubeLightColor = textureLod(env_texture, R, lod).rgb;
	vec2 f_ab = texture(brdflut_texture, vec2(NE, 1.0 - roughness)).rg;

	// Roughness-dependent Fresnel (Fdez-Aguera)
	vec3 Fr = max(vec3(1.0 - roughness), F0) - F0;
	vec3 k_S = F0 + Fr * pow(1.0 - NE, 5.0);
	vec3 FssEss = k_S * f_ab.x + f_ab.y;

	return cubeLightColor * FssEss;
}

// Multi-scatter IBL diffuse with energy compensation (Fdez-Aguera 2019).
// Single-scattering IBL diffuse loses energy that bounces more than once
// between surface microfacets.  The FmsEms term recovers this by computing
// the average Fresnel over all directions and redistributing the missing
// energy back into the diffuse lobe.
// Ref: https://bruop.github.io/ibl/#single_scattering_results
vec3 CalcIBLDiffuse( in vec3 irradiance, in vec3 diffuseColor, in vec3 F0,
	in float NE, in float roughness )
{
	vec2 f_ab = texture(brdflut_texture, vec2(NE, 1.0 - roughness)).rg;

	// Single-scatter specular energy
	vec3 Fr = max(vec3(1.0 - roughness), F0) - F0;
	vec3 k_S = F0 + Fr * pow(1.0 - NE, 5.0);
	vec3 FssEss = k_S * f_ab.x + f_ab.y;

	// Multi-scatter compensation (Fdez-Aguera / Kulla-Conty)
	float Ems = 1.0 - (f_ab.x + f_ab.y);
	vec3 F_avg = F0 + (1.0 - F0) / 21.0;
	vec3 FmsEms = Ems * FssEss * F_avg / (1.0 - F_avg * Ems);

	// Diffuse is what's left after single-scatter + multi-scatter specular
	vec3 k_D = diffuseColor * (1.0 - FssEss + FmsEms);

	return (FmsEms + k_D) * irradiance;
}

vec3 EvalSH9( in vec3 n )
{
	float x = n.x;
	float y = n.y;
	float z = n.z;

	// L0..L2 order: (0,0), (1,-1), (1,0), (1,1), (2,-2), (2,-1), (2,0), (2,1), (2,2)
	vec3 c0 = pbrShCoeffs[0].xyz;
	vec3 c1 = pbrShCoeffs[1].xyz;
	vec3 c2 = pbrShCoeffs[2].xyz;
	vec3 c3 = pbrShCoeffs[3].xyz;
	vec3 c4 = pbrShCoeffs[4].xyz;
	vec3 c5 = pbrShCoeffs[5].xyz;
	vec3 c6 = pbrShCoeffs[6].xyz;
	vec3 c7 = pbrShCoeffs[7].xyz;
	vec3 c8 = pbrShCoeffs[8].xyz;

	return c0 +
		c1 * y +
		c2 * z +
		c3 * x +
		c4 * (x * y) +
		c5 * (y * z) +
		c6 * (3.0 * z * z - 1.0) +
		c7 * (x * z) +
		c8 * (x * x - y * y);
}

// Diffuse irradiance: SH + optional cubemap sample.
// When hasIrr is false the cubemap may hold a fallback (black or placeholder);
// sampling it could blow out energy or add tint, so skip it.
vec3 CalcDiffuseIrradiance( in vec3 N, in bool hasIrradiance )
{
	vec3 irradiance = max( EvalSH9( N ), vec3( 0.0 ) );
	if ( hasIrradiance )
	{
		vec3 R = N;
		R.y *= -1.0f;
		irradiance += texture( irradiance_texture, R ).rgb;
	}
	return irradiance;
}

vec3 CalcBurleySubsurface( in vec3 N, in vec3 L, in vec3 subsurfaceColor, in float strength, in float wrap )
{
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float wrapValue = clamp( wrap, 0.0, 1.0 );
	float scatter = WrapLambert( NL, wrapValue );
	return subsurfaceColor * strength * scatter;
}
