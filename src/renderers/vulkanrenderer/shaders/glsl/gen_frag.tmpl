vec3 CalcNormal( in vec3 vertexNormal, in vec4 vertexTangent, in vec2 frag_tex_coord )
{
	if ( normal_texture_set > -1 ) {
		vec3 biTangent = vertexTangent.w * cross(vertexNormal, vertexTangent.xyz);
		vec2 dUVdx = dFdx( frag_tex_coord );
		vec2 dUVdy = dFdy( frag_tex_coord );
		vec4 normalSample = textureGrad(normal_texture, frag_tex_coord, dUVdx, dUVdy);
		vec3 base = normalSample.agb - vec3(0.5);

		base.xy *= vec2( normalScale_x, normalScale_y );

		vec2 leanDetail = vec2( 0.0 );
		if ( normalScale_z > 0.0 ) {
			leanDetail = ( normalSample.rg - vec2( 0.5 ) ) * normalScale_z;
		}

		vec2 slopes = base.xy + leanDetail;
		float zz = sqrt( clamp( 1.0 - dot( slopes, slopes ), 0.0, 1.0 ) );

		vec3 n = slopes.x * vertexTangent.xyz + slopes.y * biTangent + zz * vertexNormal;

		return normalize(n);
	}else {
		return normalize(vertexNormal);
	}
}

float WrapLambert( in float NL, in float w )
{
	return clamp((NL + w) / pow(1.0 + w, 2.0), 0.0, 1.0);
}

vec3 Tonemap_ACES( in vec3 x )
{
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 Diffuse_Lambert(in vec3 DiffuseColor)
{
	return DiffuseColor * (1.0 / PI);
}

float Pow5( in float x )
{
	float x2 = x * x;
	return x2 * x2 * x;
}

vec3 Diffuse_Burley( in vec3 diffuseColor, in float NE, in float NL, in float LH, in float roughness )
{
	// Disney 2012 diffuse term for direct lighting.
	float FD90 = 0.5 + 2.0 * LH * LH * roughness;
	float lightScatter = 1.0 + ( FD90 - 1.0 ) * Pow5( 1.0 - NL );
	float viewScatter = 1.0 + ( FD90 - 1.0 ) * Pow5( 1.0 - NE );
	return diffuseColor * (1.0 / PI) * lightScatter * viewScatter;
}

vec3 CalcDiffuse( in vec3 diffuse, in float NE, in float NL,
	in float LH, in float roughness )
{
	// Keep Lambert as a fallback during Disney diffuse rollout.
	const bool useDisneyDiffuse = true;
	if ( useDisneyDiffuse )
		return Diffuse_Burley( diffuse, NE, NL, LH, roughness );
	return Diffuse_Lambert( diffuse );
}

vec3 F_Schlick( in vec3 SpecularColor, in float VH )
{
	float Fc = pow(1 - VH, 5);
	return SpecularColor + (1.0 - SpecularColor) * Fc;
}

float LambdaGGX( in vec3 N, in vec3 V, in vec3 T, in vec3 B, in float alphaX, in float alphaY )
{
	float NV = clamp( dot( N, V ), 0.0, 1.0 );
	if ( NV <= 0.0 )
		return 0.0;

	float sinTheta = sqrt( max( 0.0, 1.0 - NV * NV ) );
	if ( sinTheta <= 0.0 )
		return 0.0;

	vec2 projected = vec2( dot( V, T ), dot( V, B ) );
	float cosPhi = projected.x / sinTheta;
	float sinPhi = projected.y / sinTheta;
	float tanTheta2 = ( sinTheta * sinTheta ) / ( NV * NV );

	float alpha = max( sqrt( ( cosPhi * alphaX ) * ( cosPhi * alphaX ) + ( sinPhi * alphaY ) * ( sinPhi * alphaY ) ), 1e-4 );
	return ( -1.0 + sqrt( 1.0 + alpha * alpha * tanTheta2 ) ) * 0.5;
}

float GeometrySmithAnisotropic( vec3 N, vec3 V, vec3 L, vec3 T, vec3 B, float alphaX, float alphaY )
{
	float lambdaV = LambdaGGX( N, V, T, B, alphaX, alphaY );
	float lambdaL = LambdaGGX( N, L, T, B, alphaX, alphaY );
	return 1.0 / ( 1.0 + lambdaV + lambdaL );
}

float D_GGX_Anisotropic( in vec3 H, in vec3 N, in vec3 T, in vec3 B, in float alphaX, in float alphaY )
{
	float NH = clamp( dot( N, H ), 0.0, 1.0 );
	if ( NH <= 0.0 )
		return 0.0;

	float Hx = dot( H, T );
	float Hy = dot( H, B );
	float denom = ( ( Hx / alphaX ) * ( Hx / alphaX ) ) + ( ( Hy / alphaY ) * ( Hy / alphaY ) ) + ( NH * NH );
	return 1.0 / ( PI * alphaX * alphaY * denom * denom );
}

vec3 CalcSpecular( in vec3 specular, in vec3 N, in vec3 L, in vec3 V, in vec3 H, in vec3 T, in vec3 B, in float alphaX, in float alphaY )
{
	vec3  F = F_Schlick( specular, clamp( dot( V, H ), 0.0, 1.0 ) );
	float D = D_GGX_Anisotropic( H, N, T, B, max( alphaX, 1e-4 ), max( alphaY, 1e-4 ) );
	float G = GeometrySmithAnisotropic( N, V, L, T, B, max( alphaX, 1e-4 ), max( alphaY, 1e-4 ) );
	float NL = max( dot( N, L ), 0.0 );
	float NV = max( dot( N, V ), 0.0 );
	float denom = max( 4.0 * NL * NV, 1e-4 );

	return ( D * G ) * F / denom;
}


vec3 CalcIBLContribution( in float roughness, in vec3 N, in vec3 E,
	in float NE, in vec3 specular )
{
	vec3 R = reflect(-E, N);
	R.y *= -1.0f;
	
	float mipMax = max(float(env_prefilter_mip_levels) - 1.0, 0.0);
	float mipLevel = ( mipMax > 0.0 ) ? clamp( roughness * mipMax, 0.0, mipMax ) : 0.0;
	vec3 cubeLightColor = textureLod( env_texture, R, mipLevel ).rgb;
	vec2 EnvBRDF = texture(brdflut_texture, vec2(NE, 1.0 - roughness)).rg;
	vec3 FssEss = (specular.rgb * EnvBRDF.x + EnvBRDF.y);

	// Step 3 (Kulla-Conty): optional multiple-scattering compensation for specular IBL.
	if ( pbrAdvancedParams.x > 0.5 ) {
		float Ess = clamp( EnvBRDF.x + EnvBRDF.y, 0.0, 1.0 );
		float Ems = 1.0 - Ess;
		vec3 Favg = specular + (1.0 - specular) * (1.0 / 21.0);
		vec3 Fms = (FssEss * Favg) / max( vec3(1.0 - Ems * Favg), vec3(1e-3) );
		float strength = clamp( pbrAdvancedParams.y, 0.0, 2.0 );
		return cubeLightColor * (FssEss + Fms * strength);
	}

	return cubeLightColor * FssEss;
}

vec3 EvalSH9( in vec3 n )
{
	float x = n.x;
	float y = n.y;
	float z = n.z;

	// L0..L2 order: (0,0), (1,-1), (1,0), (1,1), (2,-2), (2,-1), (2,0), (2,1), (2,2)
	vec3 c0 = pbrShCoeffs[0].xyz;
	vec3 c1 = pbrShCoeffs[1].xyz;
	vec3 c2 = pbrShCoeffs[2].xyz;
	vec3 c3 = pbrShCoeffs[3].xyz;
	vec3 c4 = pbrShCoeffs[4].xyz;
	vec3 c5 = pbrShCoeffs[5].xyz;
	vec3 c6 = pbrShCoeffs[6].xyz;
	vec3 c7 = pbrShCoeffs[7].xyz;
	vec3 c8 = pbrShCoeffs[8].xyz;

	return c0 +
		c1 * y +
		c2 * z +
		c3 * x +
		c4 * (x * y) +
		c5 * (y * z) +
		c6 * (3.0 * z * z - 1.0) +
		c7 * (x * z) +
		c8 * (x * x - y * y);
}

vec3 CalcDiffuseIrradiance( in vec3 N )
{
	vec3 irradiance = EvalSH9( N );
	if ( irradiance_texture_set > -1 ) {
		vec3 R = N;
		R.y *= -1.0f;
		irradiance += texture( irradiance_texture, R ).rgb;
	}
	return irradiance;
}

vec3 CalcBurleySubsurface( in vec3 N, in vec3 L, in vec3 subsurfaceColor, in float strength, in float wrap )
{
	float NL = clamp( dot( N, L ), 0.0, 1.0 );
	float wrapValue = clamp( wrap, 0.0, 1.0 );
	float scatter = WrapLambert( NL, wrapValue );
	return subsurfaceColor * strength * scatter;
}

// LTC polygon helpers

mat3 LTC_Matrix( vec4 texel )
{
	return mat3(
		texel.x, 0.0, texel.y,
		0.0,     1.0, 0.0,
		texel.z, 0.0, texel.w
	);
}

vec3 LTC_EdgeIntegral( vec3 v1, vec3 v2 )
{
	vec3 crossProd = cross( v1, v2 );
	float len = length( crossProd );
	float dotProd = clamp( dot( v1, v2 ), -1.0, 1.0 );
	float angle = atan( len, dotProd );
	return crossProd * ( angle / max( len, 1e-6 ) );
}

vec3 LTC_TransformVertex( vec3 vertex, vec3 tangent, vec3 bitangent, vec3 normal, mat3 Minv )
{
	vec3 diff = vertex - var_WorldPos;
	vec3 local = vec3(
		dot( diff, tangent ),
		dot( diff, bitangent ),
		dot( diff, normal )
	);
	vec3 transformed = Minv * local;
	float invZ = 1.0 / max( transformed.z, 1e-6 );
	return vec3( transformed.x * invZ, transformed.y * invZ, transformed.z * invZ );
}

vec3 LTC_IntegratePolygon( mat3 Minv, vec3 tangent, vec3 bitangent, vec3 normal, int vertexCount )
{
	if ( vertexCount < 3 )
		return vec3( 0.0 );

	vec3 sum = vec3( 0.0 );
	vec3 prev = LTC_TransformVertex( ltcPolygonPoints[ vertexCount - 1 ].xyz, tangent, bitangent, normal, Minv );

	for ( int i = 0; i < vertexCount; ++i )
	{
		vec3 current = LTC_TransformVertex( ltcPolygonPoints[ i ].xyz, tangent, bitangent, normal, Minv );
		sum += LTC_EdgeIntegral( prev, current );
		prev = current;
	}

	return sum;
}

vec3 CalcLTCContribution( in vec3 specular, in float roughness, in float NE, in float NL, in float quality,
	in vec3 tangent, in vec3 bitangent, in vec3 normal )
{
	int vertexCount = int( clamp( ltcPolygonNormal.w, 0.0, 4.0 ) );
	if ( vertexCount < 3 )
		return vec3( 0.0 );

	vec2 uv = vec2( clamp( roughness, 0.0, 1.0 ), clamp( 1.0 - NE, 0.0, 1.0 ) );
	vec4 ltcMat = texture( ltc_mat_texture, uv );
	vec4 ltcAmp = texture( ltc_amp_texture, uv );

	mat3 Minv = LTC_Matrix( ltcMat );
	vec3 polygonIntegral = LTC_IntegratePolygon( Minv, tangent, bitangent, normal, vertexCount );
	if ( length( polygonIntegral ) == 0.0 )
		return vec3( 0.0 );

	float q = clamp( quality, 0.0, 2.0 ) * 0.5;
	float qualityScale = mix( 0.80, 1.10, q );
	float minvDet = abs( ltcMat.x * ltcMat.w - ltcMat.y * ltcMat.z );
	float shape = clamp( minvDet, 0.0, 1.5 );
	float amp = ltcAmp.x;
	float fresnel = mix( 1.0, 1.0 + 0.25 * ltcAmp.w, clamp( 1.0 - NE, 0.0, 1.0 ) );
	float lobe = clamp( 0.35 * amp * shape * fresnel * qualityScale, 0.0, 1.0 );

	return specular * polygonIntegral * lobe * max( NL, 0.0 );
}

