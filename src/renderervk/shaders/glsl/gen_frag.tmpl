PRECISION_MEDIUMP vec3 CalcNormal( in PRECISION_MEDIUMP vec3 vertexNormal, in PRECISION_MEDIUMP vec2 frag_tex_coord )
{
	if ( normal_texture_set > -1 ) {
		PRECISION_MEDIUMP vec3 n = texture(normal_texture, frag_tex_coord).agb - vec3(0.5);

		n.xy *= vec2( normalScale_x, normalScale_y );
		// Optimized: use fast inverse sqrt approximation where possible
		PRECISION_MEDIUMP float zSq = clamp((0.25 - n.x * n.x) - n.y * n.y, 0.0, 1.0);
		n.z = sqrt(zSq);
		n = n.x * in_ntb.tangent + n.y * in_ntb.binormal + n.z * vertexNormal;

		return normalize(n);
	} else {
		return normalize(vertexNormal);
	}
}

PRECISION_MEDIUMP float WrapLambert( in PRECISION_MEDIUMP float NL, in PRECISION_MEDIUMP float w )
{
	PRECISION_MEDIUMP float denom = 1.0 + w;
	return clamp((NL + w) / (denom * denom), 0.0, 1.0);
}

PRECISION_MEDIUMP vec3 Diffuse_Lambert(in PRECISION_MEDIUMP vec3 DiffuseColor)
{
	return DiffuseColor * INV_PI;
}

PRECISION_MEDIUMP vec3 CalcDiffuse( in PRECISION_MEDIUMP vec3 diffuse, in PRECISION_MEDIUMP float NE, in PRECISION_MEDIUMP float NL,
	in PRECISION_MEDIUMP float LH, in PRECISION_MEDIUMP float roughness )
{
	return Diffuse_Lambert(diffuse);
}

PRECISION_MEDIUMP vec3 F_Schlick( in PRECISION_MEDIUMP vec3 SpecularColor, in PRECISION_MEDIUMP float VH )
{
	// Optimized: use manual expansion instead of pow(1-VH, 5)
	// Further optimized: use fast math approximations when enabled
	PRECISION_MEDIUMP float oneMinusVH = 1.0 - VH;
	
	PRECISION_MEDIUMP float Fc;
	if (use_fast_math != 0) {
		// Fast approximation: (1-VH)^5 ≈ 1 - 5*VH for small VH
		// More accurate: use polynomial expansion
		PRECISION_MEDIUMP float oneMinusVH2 = oneMinusVH * oneMinusVH;
		Fc = oneMinusVH2 * oneMinusVH2 * oneMinusVH;
	} else {
		// Standard polynomial expansion (more accurate)
		PRECISION_MEDIUMP float oneMinusVH2 = oneMinusVH * oneMinusVH;
		Fc = oneMinusVH2 * oneMinusVH2 * oneMinusVH;
	}
	
	PRECISION_MEDIUMP float reflectivity = clamp(50.0 * SpecularColor.g, 0.0, 1.0);
	return reflectivity * Fc + (1.0 - Fc) * SpecularColor;
}

PRECISION_MEDIUMP float D_GGX( in PRECISION_MEDIUMP float NH, in PRECISION_MEDIUMP float a )
{
	PRECISION_MEDIUMP float a2 = a * a;
	PRECISION_MEDIUMP float d = (NH * a2 - NH) * NH + 1.0;
	PRECISION_MEDIUMP float d2 = d * d;
	return a2 / (PI * d2);
}

// Approximation of joint Smith term for GGX
// [Heitz 2014, "Understanding the Masking-Shadowing Function in Microfacet-Based BRDFs"]
PRECISION_MEDIUMP float V_SmithJointApprox( in PRECISION_MEDIUMP float a, in PRECISION_MEDIUMP float NV, in PRECISION_MEDIUMP float NL )
{
	PRECISION_MEDIUMP float oneMinusA = 1.0 - a;
	PRECISION_MEDIUMP float Vis_SmithV = NL * (NV * oneMinusA + a);
	PRECISION_MEDIUMP float Vis_SmithL = NV * (NL * oneMinusA + a);
	return 0.5 / (Vis_SmithV + Vis_SmithL);
}

PRECISION_MEDIUMP float CalcVisibility( in PRECISION_MEDIUMP float NL, in PRECISION_MEDIUMP float NE, in PRECISION_MEDIUMP float roughness )
{
	PRECISION_MEDIUMP float alphaSq = roughness * roughness;

	PRECISION_MEDIUMP float lambdaE = NL * sqrt((-NE * alphaSq + NE) * NE + alphaSq);
	PRECISION_MEDIUMP float lambdaL = NE * sqrt((-NL * alphaSq + NL) * NL + alphaSq);

	return 0.5 / (lambdaE + lambdaL);
}

PRECISION_MEDIUMP vec3 CalcSpecular( in PRECISION_MEDIUMP vec3 specular, in PRECISION_MEDIUMP float NH, in PRECISION_MEDIUMP float NL,
	in PRECISION_MEDIUMP float NE, in PRECISION_MEDIUMP float LH, in PRECISION_MEDIUMP float VH, in PRECISION_MEDIUMP float roughness )
{
	PRECISION_MEDIUMP vec3  F = F_Schlick(specular, VH);
	PRECISION_MEDIUMP float D = D_GGX(NH, roughness);
	PRECISION_MEDIUMP float V = V_SmithJointApprox(roughness, NE, NL);

	return D * F * V;
}

PRECISION_MEDIUMP vec3 CalcIBLContribution( in PRECISION_MEDIUMP float roughness, in PRECISION_MEDIUMP vec3 N, in PRECISION_MEDIUMP vec3 E,
	in PRECISION_MEDIUMP float NE, in PRECISION_MEDIUMP vec3 specular )
{
	PRECISION_MEDIUMP vec3 R = reflect(-E, N);
	R.y *= -1.0;
	
	// Use textureLod with optimized mip level calculation
	PRECISION_MEDIUMP float mipLevel = roughness * 6.0;
	PRECISION_MEDIUMP vec3 cubeLightColor = textureLod(env_texture, R, mipLevel).rgb;
	PRECISION_MEDIUMP vec2 EnvBRDF = texture(brdflut_texture, vec2(NE, 1.0 - roughness)).rg;

	return cubeLightColor * (specular.rgb * EnvBRDF.x + EnvBRDF.y);
}
