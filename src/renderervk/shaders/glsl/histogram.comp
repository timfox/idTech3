#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;

layout(std430, binding = 1) restrict buffer HistogramBuffer {
    uint histogram[256]; // Luminance histogram
    float minLuminance;
    float maxLuminance;
    float avgLuminance;
};

layout(push_constant) uniform HistogramConstants {
    vec2 resolution;
    vec2 invResolution;
    uint frameIndex;
} pc;

float luma(vec3 color)
{
    return dot(color, vec3(0.299, 0.587, 0.114));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y)) {
        return;
    }
    
    vec2 uv = (vec2(pixel) + 0.5) * pc.invResolution;
    vec3 color = texture(inputImage, uv).rgb;
    
    float luminance = luma(color);
    
    // Clamp to valid range
    luminance = clamp(luminance, 0.0, 1.0);
    
    // Calculate histogram bin
    uint bin = uint(luminance * 255.0);
    bin = clamp(bin, 0u, 255u);
    
    // Atomic increment
    atomicAdd(histogram[bin], 1u);
}

