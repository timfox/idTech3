#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Instance data structure
struct Instance {
    mat4 modelMatrix;
    vec4 color;
    uint entityIndex;
    uint flags;
    float lodBias;
    uint materialOverride;
};

layout(std430, binding = 0) restrict readonly buffer InstanceBuffer {
    Instance instances[];
};

layout(std430, binding = 1) restrict readonly buffer VisibleInstancesBuffer {
    uint visibleInstances[];
};

layout(std430, binding = 2) restrict writeonly buffer OutputInstanceBuffer {
    Instance outputInstances[];
};

layout(push_constant) uniform InstanceConstants {
    uint visibleCount;
    uint outputOffset;
} pc;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    
    if (index >= pc.visibleCount) {
        return;
    }
    
    uint instanceIndex = visibleInstances[index];
    Instance instance = instances[instanceIndex];
    
    // Write to output buffer (compacted visible instances)
    outputInstances[pc.outputOffset + index] = instance;
}

