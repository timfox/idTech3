#version 460
#extension GL_GOOGLE_include_directive : enable

precision highp float;
precision highp int;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Instance data structure
struct Instance {
    mat4 modelMatrix;
    vec4 color;
    uint entityIndex;
    uint flags;
    float lodBias;
    uint materialOverride;
};

// Bounding box structure
struct BoundingBox {
    vec3 min;
    vec3 max;
};

layout(std430, binding = 0) restrict readonly buffer InstanceBuffer {
    Instance instances[];
};

layout(std430, binding = 1) restrict readonly buffer BoundingBoxBuffer {
    BoundingBox boundingBoxes[];
};

layout(std430, binding = 2) restrict buffer DrawCommandBuffer {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
    uint drawCommandCount;
} drawCommands[];

layout(std430, binding = 3) restrict buffer CullDataBuffer {
    vec4 frustumPlanes[6];
    vec3 cameraPos;
    float cullDistance;
    vec3 cameraForward;
    float padding;
    uint instanceCount;
    uint drawCount;
} cullData;

layout(std430, binding = 4) restrict buffer VisibleInstancesBuffer {
    uint visibleInstances[];
};

layout(push_constant) uniform CullConstants {
    uint baseInstance;
    uint instanceCount;
    uint drawCommandIndex;
} pc;

// Frustum culling test
bool isInsideFrustum(vec3 min, vec3 max, vec4 planes[6])
{
    for (int i = 0; i < 6; i++) {
        vec3 normal = planes[i].xyz;
        float d = planes[i].w;
        
        // Find the "positive vertex" (furthest point in direction of plane normal)
        vec3 positiveVertex = vec3(
            normal.x > 0.0 ? max.x : min.x,
            normal.y > 0.0 ? max.y : min.y,
            normal.z > 0.0 ? max.z : min.z
        );
        
        // If positive vertex is behind plane, box is outside frustum
        if (dot(normal, positiveVertex) + d < 0.0) {
            return false;
        }
    }
    return true;
}

// Distance culling
bool isWithinDistance(vec3 center, float radius, vec3 cameraPos, float maxDistance)
{
    float dist = length(center - cameraPos);
    return (dist - radius) <= maxDistance;
}

void main()
{
    uint instanceIndex = gl_GlobalInvocationID.x + pc.baseInstance;
    
    if (instanceIndex >= pc.instanceCount) {
        return;
    }
    
    Instance instance = instances[instanceIndex];
    BoundingBox bbox = boundingBoxes[instance.entityIndex];
    
    // Extract center and radius from bounding box
    vec3 center = (bbox.min + bbox.max) * 0.5;
    vec3 size = bbox.max - bbox.min;
    float radius = length(size) * 0.5;
    
    // Transform bounding box to world space
    vec4 corners[8];
    corners[0] = instance.modelMatrix * vec4(bbox.min, 1.0);
    corners[1] = instance.modelMatrix * vec4(bbox.max.x, bbox.min.y, bbox.min.z, 1.0);
    corners[2] = instance.modelMatrix * vec4(bbox.min.x, bbox.max.y, bbox.min.z, 1.0);
    corners[3] = instance.modelMatrix * vec4(bbox.max.x, bbox.max.y, bbox.min.z, 1.0);
    corners[4] = instance.modelMatrix * vec4(bbox.min.x, bbox.min.y, bbox.max.z, 1.0);
    corners[5] = instance.modelMatrix * vec4(bbox.max.x, bbox.min.y, bbox.max.z, 1.0);
    corners[6] = instance.modelMatrix * vec4(bbox.min.x, bbox.max.y, bbox.max.z, 1.0);
    corners[7] = instance.modelMatrix * vec4(bbox.max, 1.0);
    
    // Calculate world space bounding box
    vec3 worldMin = corners[0].xyz;
    vec3 worldMax = corners[0].xyz;
    for (int i = 1; i < 8; i++) {
        worldMin = min(worldMin, corners[i].xyz);
        worldMax = max(worldMax, corners[i].xyz);
    }
    
    // Transform center to world space
    vec4 worldCenter4 = instance.modelMatrix * vec4(center, 1.0);
    vec3 worldCenter = worldCenter4.xyz;
    
    // Calculate world space radius (approximate)
    vec3 worldSize = worldMax - worldMin;
    float worldRadius = length(worldSize) * 0.5;
    
    // Perform culling tests
    bool visible = true;
    
    // Frustum culling
    if (!isInsideFrustum(worldMin, worldMax, cullData.frustumPlanes)) {
        visible = false;
    }
    
    // Distance culling
    if (visible && !isWithinDistance(worldCenter, worldRadius, cullData.cameraPos, cullData.cullDistance)) {
        visible = false;
    }
    
    // Backface culling (optional - check if facing away from camera)
    if (visible) {
        vec3 toCenter = normalize(worldCenter - cullData.cameraPos);
        // Simplified - would need actual normal from geometry
        // For now, skip backface culling
    }
    
    // Write visible instance index
    if (visible) {
        uint visibleIndex = atomicAdd(cullData.drawCount, 1u);
        // Note: MAX_INSTANCE_COUNT is defined in C code, use reasonable limit here
        if (visibleIndex < 1048576u) { // 1M instances
            visibleInstances[visibleIndex] = instanceIndex;
        }
    }
}

