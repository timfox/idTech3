#version 450
#extension GL_GOOGLE_include_directive : enable

precision mediump float;
precision mediump int;

#include "shader_constants.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform mediump sampler2D input_texture;
layout(set = 0, binding = 1, rgba8) uniform mediump writeonly image2D output_image;

layout(push_constant) uniform GammaParams {
	mediump float gamma;
	mediump float obScale;
	mediump float greyscale;
	int ditherMode;
	ivec3 depth;
	mediump float styleStrength; // 0 = off, >0 applies simple stylization
};

const int BAYER_SIZE = 8;
const mediump float BAYER_MATRIX[BAYER_SIZE * BAYER_SIZE] = {
	0.0,  32.0, 8.0,  40.0, 2.0,  34.0, 10.0, 42.0,
	48.0, 16.0, 56.0, 24.0, 50.0, 18.0, 58.0, 26.0,
	12.0, 44.0, 4.0,  36.0, 14.0, 46.0, 6.0,  38.0,
	60.0, 28.0, 52.0, 20.0, 62.0, 30.0, 54.0, 22.0,
	3.0,  35.0, 11.0, 43.0, 1.0,  33.0, 9.0,  41.0,
	51.0, 19.0, 59.0, 27.0, 49.0, 17.0, 57.0, 25.0,
	15.0, 47.0, 7.0,  39.0, 13.0, 45.0, 5.0,  37.0,
	63.0, 31.0, 55.0, 23.0, 61.0, 29.0, 53.0, 21.0
};

mediump float bayerThreshold(ivec2 coord) {
	ivec2 bayerCoord = coord % BAYER_SIZE;
	int index = bayerCoord.x + bayerCoord.y * BAYER_SIZE;
	mediump float bayerSample = BAYER_MATRIX[index];
	return (bayerSample + 0.5) / float(BAYER_SIZE * BAYER_SIZE);
}

mediump vec3 dither(mediump vec3 color, ivec2 coord) {
	mediump vec3 cDenormalized = color * vec3(depth);
	mediump vec3 cLow = floor(cDenormalized);
	mediump vec3 cFractional = cDenormalized - cLow;
	mediump vec3 cDithered = cLow + step(bayerThreshold(coord), cFractional);
	return cDithered / vec3(depth);
}

void main() {
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	mediump vec2 tex_coord = (vec2(coord) + vec2(0.5)) / vec2(imageSize(output_image));
	
	mediump vec3 base = texture(input_texture, tex_coord).rgb;

	// Greyscale conversion
	if (greyscale == 1.0) {
		base = toLuma(base);
	} else if (greyscale != 0.0) {
		mediump vec3 lum = toLuma(base);
		base = mix(base, lum, greyscale);
	}

	// Gamma correction
	if (gamma != 1.0) {
		base = pow(base, vec3(gamma));
	}
	
	base *= obScale;

	// Very lightweight "style" look: posterize + edge-ish contrast
	if (styleStrength > 0.0) {
		mediump float levels = mix(4.0, 12.0, clamp(styleStrength, 0.0, 1.0));
		mediump vec3 poster = floor(base * levels) / levels;
		mediump float lum = dot(base, vec3(0.299, 0.587, 0.114));
		mediump float edge = clamp(abs(lum - 0.5) * 2.0, 0.0, 1.0);
		base = mix(base, poster, clamp(styleStrength, 0.0, 1.0));
		base = mix(base, base * (0.8 + 0.4 * edge), clamp(styleStrength * 0.5, 0.0, 1.0));
	}

	// Dithering
	if (ditherMode == 1) {
		base = dither(base, coord);
	}

	imageStore(output_image, coord, vec4(base, 1.0));
}

