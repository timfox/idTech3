#version 450
#extension GL_GOOGLE_include_directive : enable

precision mediump float;
precision mediump int;

#include "shader_constants.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform mediump sampler2D input_texture;
layout(set = 0, binding = 1, rgba8) uniform writeonly mediump image2D output_image;

layout(push_constant) uniform BlurParams {
	mediump vec2 texel_size;  // 1.0 / texture_size
	mediump vec2 direction;   // Blur direction (1,0) or (0,1)
	mediump float radius;     // Blur radius
};

// Gaussian weights for 5-tap blur
const mediump float weights[5] = {
	0.2270270270,  // Center
	0.1945945946,  // ±1
	0.1216216216,  // ±2
	0.0540540541,  // ±3
	0.0162162162   // ±4
};

void main() {
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	mediump vec2 tex_coord = (vec2(coord) + vec2(0.5)) * texel_size;
	
	mediump vec3 result = texture(input_texture, tex_coord).rgb * weights[0];
	
	// Sample symmetric taps
	for (int i = 1; i < 5; ++i) {
		mediump float weight = weights[i];
		mediump vec2 offset = direction * texel_size * float(i);
		
		result += texture(input_texture, tex_coord + offset).rgb * weight;
		result += texture(input_texture, tex_coord - offset).rgb * weight;
	}
	
	imageStore(output_image, coord, vec4(result, 1.0));
}
