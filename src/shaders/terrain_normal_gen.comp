// Terrain Normal Map Generation Compute Shader
// Computes normal maps from height data for surface shading

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Input: Height texture
layout(binding = 0, r32f) uniform readonly image2D heightTexture;

// Output: Normal map texture (RG8 or RGB8 format)
layout(binding = 1, rgba8) uniform writeonly image2D normalTexture;

layout(binding = 2) uniform NormalGenParams {
    ivec2 textureSize;
    float heightScale;            // Height scale factor
    float gridSpacing;            // Grid spacing in world units
} params;

// Compute normal using central differences
vec3 computeNormal(ivec2 coord) {
    ivec2 size = params.textureSize;
    
    // Sample heights with bounds checking
    float h_center = imageLoad(heightTexture, coord).r;
    
    float h_left = (coord.x > 0) ? 
        imageLoad(heightTexture, ivec2(coord.x - 1, coord.y)).r : h_center;
    float h_right = (coord.x < size.x - 1) ? 
        imageLoad(heightTexture, ivec2(coord.x + 1, coord.y)).r : h_center;
    float h_up = (coord.y > 0) ? 
        imageLoad(heightTexture, ivec2(coord.x, coord.y - 1)).r : h_center;
    float h_down = (coord.y < size.y - 1) ? 
        imageLoad(heightTexture, ivec2(coord.x, coord.y + 1)).r : h_center;
    
    // Central differences
    float dx = (h_right - h_left) * params.heightScale / (2.0 * params.gridSpacing);
    float dy = (h_down - h_up) * params.heightScale / (2.0 * params.gridSpacing);
    
    // Compute normal (pointing up in Y)
    vec3 normal = normalize(vec3(-dx, 2.0, -dy));
    
    return normal;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    
    if (coord.x >= params.textureSize.x || coord.y >= params.textureSize.y) {
        return;
    }
    
    // Compute normal
    vec3 normal = computeNormal(coord);
    
    // Convert normal from [-1,1] to [0,1] for storage
    vec3 normal01 = normal * 0.5 + 0.5;
    
    // Store in texture (RGBA format, using RGB for normal, A unused)
    imageStore(normalTexture, coord, vec4(normal01, 1.0));
}
