{
  "project": "@CMAKE_PROJECT_NAME@",
  "generator": "@CMAKE_GENERATOR@",
  "cmake_version": "@CMAKE_VERSION@",
  "build_dir": "@CMAKE_BINARY_DIR@",
  "build_type": "@CMAKE_BUILD_TYPE@",
  "git_sha": "@BUILD_MANIFEST_GIT_SHA@",
  "timestamp": "@BUILD_MANIFEST_TIMESTAMP@",
  "compiler": {
    "c": "@CMAKE_C_COMPILER_ID@",
    "cxx": "@CMAKE_CXX_COMPILER_ID@"
  },
  "options": {
    "CI_BUILD": @BUILD_MANIFEST_OPTION_VALUE_CI_BUILD@,
    "ENABLE_ASAN": @BUILD_MANIFEST_OPTION_VALUE_ENABLE_ASAN@,
    "ENABLE_FORTIFY_SOURCE": @BUILD_MANIFEST_OPTION_VALUE_ENABLE_FORTIFY_SOURCE@,
    "BUILD_SERVER": @BUILD_MANIFEST_OPTION_VALUE_BUILD_SERVER@,
    "USE_FLUX": @BUILD_MANIFEST_OPTION_VALUE_USE_FLUX@,
    "USE_SDL": @BUILD_MANIFEST_OPTION_VALUE_USE_SDL@,
    "USE_STB_TRUETYPE": @BUILD_MANIFEST_OPTION_VALUE_USE_STB_TRUETYPE@,
    "USE_VULKAN": @BUILD_MANIFEST_OPTION_VALUE_USE_VULKAN@,
    "USE_OPUS": @BUILD_MANIFEST_OPTION_VALUE_USE_OPUS@,
    "USE_FLAC": @BUILD_MANIFEST_OPTION_VALUE_USE_FLAC@,
    "USE_WEBM": @BUILD_MANIFEST_OPTION_VALUE_USE_WEBM@
  },
  "feature_flags": [
@BUILD_MANIFEST_FEATURE_FLAGS_JSON@
  ],
  "targets": [
@BUILD_MANIFEST_TARGETS_JSON@
  ]
}
