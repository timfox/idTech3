# Copy to game_base.env and set an absolute path.
# Usage:
#   set -a && source ./game_base.env && set +a
#   ./scripts/renderer_regression_check.sh
#   ./scripts/renderer_regression_maps.sh

GAME_BASE=/absolute/path/to/your/base

# Optional: where idtech3_server / idtech3 live if not in repo release/
# RELEASE_DIR=/absolute/path/to/release
