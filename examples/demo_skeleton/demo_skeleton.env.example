# Optional - copy to local.env (gitignored). Only needed if you use a custom layout or paths.
#
# If you keep data under examples/demo_skeleton/, you can skip this file entirely.

# Only set if your playfield is NOT examples/demo_skeleton/ (e.g. you copied the folder elsewhere)
# IDTECH3_DEMO_ROOT=/absolute/path/to/folder_that_contains_base_and_idtech3_demo

# Only if the engine is not at <repo>/release/idtech3
# IDTECH3_ENGINE=/absolute/path/to/idtech3

# If your game data folder is named baseq3 instead of base:
# DEMO_BASE_DIR=baseq3

# Load a map on startup (must exist in your pk3s). Leave unset for main menu only.
# DEMO_MAP=q3dm1

# vulkan (default) or opengl
# DEMO_RENDERER=vulkan

# Set to 0 to run idtech3 directly instead of release/run_vulkan.sh (Linux only, Vulkan only)
# IDTECH3_USE_RUN_VULKAN=1
