# Optional local overrides (copy to local.env — gitignored)

# Folder that contains base/ and idtech3_demo/ (default: directory of run_demo_client.sh)
# IDTECH3_DEMO_ROOT=/path/to/playfield

# Path to idtech3 binary if not using release/idtech3 from repo build
# IDTECH3_ENGINE=/path/to/idtech3

# Non-default fs_basegame if your install does not use "base"
# DEMO_BASE_DIR=legacy_base

# Map to load on client/dedicated (must exist in your base pk3s)
# DEMO_MAP=playfield_01

# Renderer plugin name
# DEMO_RENDERER=vulkan
