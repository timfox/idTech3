# Copy to local.env and fill in (local.env is gitignored from repo root).
#
# Root folder that CONTAINS both base/ (or baseq3/) and idtech3_demo/
IDTECH3_DEMO_ROOT=/absolute/path/to/your/demo_skeleton

# Client binary (default in scripts: ../../release/idtech3 relative to this examples/demo_skeleton dir)
# IDTECH3_ENGINE=/absolute/path/to/release/idtech3

# Optional: map to load after startup (must exist in your base pk3s)
# DEMO_MAP=q3dm1

# Renderer: vulkan or opengl
# DEMO_RENDERER=vulkan
