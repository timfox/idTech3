# Copy to local_validation.env (gitignored name recommended) and adjust paths.
# Usage from repo root:
#   set -a && source ./local_validation.env && set +a && ./scripts/production_readiness.sh

# Absolute path to the directory that acts as game "base" (contains .pk3, vm/, etc.)
# Uncomment when you have a full tree + regression maps for map-load sanity:
# GAME_BASE=/absolute/path/to/base

# Optional: non-default release dir for scripts that honor RELEASE_DIR
# RELEASE_DIR=/absolute/path/to/release
