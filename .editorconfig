# EditorConfig: https://editorconfig.org
# AAA enterprise standard: consistent formatting across editors and IDEs

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{c,h}]
indent_style = tab
indent_size = 4

[*.{cpp,hpp,cc,cxx}]
indent_style = tab
indent_size = 4

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,cmake}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
