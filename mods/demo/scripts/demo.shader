textures/demo/floor
{
    qer_editorimage textures/demo/floor.tga
    {
        map $lightmap
        rgbGen identity
    }
    {
        map textures/demo/floor.tga
        blendFunc filter
        rgbGen identity
    }
}

textures/demo/wall
{
    qer_editorimage textures/demo/wall.tga
    {
        map $lightmap
        rgbGen identity
    }
    {
        map textures/demo/wall.tga
        blendFunc filter
        rgbGen identity
    }
}
